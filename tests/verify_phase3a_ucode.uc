// Executed directly by OpenWrt ucode runtime against production backend/nms_archive.uc
import * as fs from 'fs';
import * as nms_archive from '/tmp/p3a_test/nms_archive.uc';
import * as helperd_aw from '/tmp/p3a_test/helperd_aw_prod.uc';

let mod_path = ARGV[0];
let vec_dir = ARGV[1];

let passed = 0;
let failed = 0;

function check(cond, label, detail) {
	if (cond) {
		passed++;
		printf('[PASS] %s\n', label);
	} else {
		failed++;
		printf('[FAIL] %s (%s)\n', label, detail || '');
	}
}

// 1. Archive validation test vectors generated by tarfile + raw binary mutators
let manifest = json(fs.readfile(vec_dir + '/manifest.json'));
for (let tc in manifest.cases) {
	let raw = fs.readfile(vec_dir + '/' + tc.file) || '';
	let res = nms_archive.validate_tar_stream(raw);
	check(res.valid == tc.expect_valid, 'P3A-UCODE[' + tc.name + ']', sprintf('expected=%J got=%J errs=%J', tc.expect_valid, res.valid, res.errors));
}

// 2. Atomic write failure-injection & comment/owner/perm preservation tests
let aw_dir = vec_dir + '/aw_test';
fs.mkdir(aw_dir);
let target = aw_dir + '/sysupgrade.conf';
let orig_content = '# User comment kept\n/etc/dropbear/\n';
fs.writefile(target, orig_content);
fs.chmod(target, 0o640);

let merged = nms_archive.merge_sysupgrade_conf(fs.readfile(target), ['/etc/noc-console/', '/etc/dropbear/']);
check(index(merged, '# User comment kept') == 0 && index(merged, '/etc/noc-console/') > 0, 'P3A-AW[merge_comments]', merged);

let seen_restricted_mode = null;

function make_ops(fail_mode, fail_unlink) {
	return {
		suffix: function() { return 'test1234'; },
		stat: fs.stat,
		unlink: function(p) {
			if (fail_unlink) return false;
			return fs.unlink(p);
		},
		open: function(p, flags, m) {
			if (fail_mode == 'write') {
				let fh_empty = fs.open(p, flags, m);
				if (fh_empty) fh_empty.close();
				return null;
			}
			let real_fh = fs.open(p, flags, m);
			if (!real_fh) return null;
			let st0 = fs.stat(p);
			seen_restricted_mode = st0 ? (st0.mode & 0o7777) : null;
			return {
				write: function(c) {
					if (fail_mode == 'partial') {
						real_fh.write(substr(c, 0, 5));
						return 5;
					}
					return real_fh.write(c);
				},
				close: function() {
					let cr = real_fh.close();
					if (fail_mode == 'close') return false;
					return cr;
				}
			};
		},
		chown: function(p, u, g) {
			if (fail_mode == 'chown') return false;
			return fs.chown(p, u, g);
		},
		chmod: function(p, m) {
			if (fail_mode == 'chmod') return false;
			return fs.chmod(p, m);
		},
		rename: function(s, d) {
			if (fail_mode == 'rename') return false;
			return fs.rename(s, d);
		}
	};
}

let expected_err = {
	write: 'write_failed',
	partial: 'write_failed',
	close: 'write_failed',
	chown: 'chown_failed',
	chmod: 'chmod_failed',
	rename: 'rename_failed'
};

for (let fm in ['write', 'partial', 'close', 'chown', 'chmod', 'rename']) {
	// Case A: failure with successful cleanup
	let r_fail = nms_archive.atomic_write_checked(target, merged, 0o640, 0, 0, make_ops(fm, false));
	let tmp_gone = !fs.stat(r_fail.tmp_path);
	let intact = fs.readfile(target) == orig_content;
	let st = fs.stat(target);
	let mode_intact = st && ((st.mode & 0o7777) == 0o640);
	check(!r_fail.ok && r_fail.error == expected_err[fm] && !r_fail.cleanup_failed && tmp_gone && intact && mode_intact,
		'P3A-AW[fail_' + fm + '_cleanup_ok]',
		sprintf('r=%J tmp_gone=%J intact=%J mode=%o', r_fail, tmp_gone, intact, st ? (st.mode & 0o7777) : 0));

	// Case B: failure followed by unlink failure -> must report cleanup_failed + tmp_path
	let r_cu = nms_archive.atomic_write_checked(target, merged, 0o640, 0, 0, make_ops(fm, true));
	let tmp_still_exists = !!fs.stat(r_cu.tmp_path);
	let intact_b = fs.readfile(target) == orig_content;
	check(!r_cu.ok && r_cu.error == 'cleanup_failed' && r_cu.orig_error == expected_err[fm] && r_cu.cleanup_failed && r_cu.tmp_path == target + '.tmp.test1234' && tmp_still_exists && intact_b,
		'P3A-AW[fail_' + fm + '_unlink_fail]',
		sprintf('r=%J tmp_exists=%J intact=%J', r_cu, tmp_still_exists, intact_b));
	if (tmp_still_exists) fs.unlink(r_cu.tmp_path);
}

// Successful atomic replacement + verify restrictive 0600 temp mode before write
seen_restricted_mode = null;
let r_ok = nms_archive.atomic_write_checked(target, merged, 0o640, 0, 0, make_ops('none', false));
let st_ok = fs.stat(target);
let tmp_ok_gone = !fs.stat(target + '.tmp.test1234');
check(
	r_ok.ok && seen_restricted_mode == 0o600 && tmp_ok_gone && fs.readfile(target) == merged && st_ok && ((st_ok.mode & 0o7777) == 0o640) && st_ok.uid == 0 && st_ok.gid == 0,
	'P3A-AW[success_preserve_comments_mode_owner]',
	sprintf('r=%J tmp_mode=%o mode=%o uid=%J gid=%J', r_ok, seen_restricted_mode || 0, st_ok ? (st_ok.mode & 0o7777) : 0, st_ok ? st_ok.uid : -1, st_ok ? st_ok.gid : -1)
);

// 3. Production noc-helperd atomic_write & atomic_write_or_reply error-propagation tests
let prod_res = helperd_aw.atomic_write(target, merged, 0o640, 0, 0, make_ops('rename', true));
let prod_audit_ok = length(helperd_aw.test_audits) > 0 && helperd_aw.test_audits[length(helperd_aw.test_audits) - 1].result == 'cleanup_failed' && index(helperd_aw.test_audits[length(helperd_aw.test_audits) - 1].details, 'tmp_path=' + target + '.tmp.test1234') >= 0;
let prod_tmp_exists = !!fs.stat(prod_res.tmp_path);
check(
	type(prod_res) == 'object' && !prod_res.ok && prod_res.error == 'cleanup_failed' && prod_res.orig_error == 'rename_failed' && prod_res.cleanup_failed && prod_res.tmp_path == target + '.tmp.test1234' && prod_tmp_exists && prod_audit_ok,
	'P3A-HELPERD[atomic_write_preserves_cleanup_failed_and_audits]',
	sprintf('res=%J audits=%J', prod_res, helperd_aw.test_audits)
);
if (prod_tmp_exists) fs.unlink(prod_res.tmp_path);

let reply_payload = null;
let aw_ret = helperd_aw.atomic_write_or_reply(target, merged, 0o644, null, null, 'admin', 'sys_sysupgrade_conf_save', function(p) { reply_payload = p; }, make_ops('rename', true));
let reply_tmp_exists = !!fs.stat(target + '.tmp.test1234');
check(
	!aw_ret && reply_payload != null && !reply_payload.ok && reply_payload.error_code == 'INTERNAL' && reply_payload.error == 'cleanup_failed' && reply_payload.orig_error == 'rename_failed' && reply_payload.cleanup_failed && reply_payload.tmp_path == target + '.tmp.test1234' && reply_tmp_exists && fs.readfile(target) == merged,
	'P3A-HELPERD[atomic_write_or_reply_explicit_failure]',
	sprintf('aw_ret=%J reply=%J', aw_ret, reply_payload)
);
if (reply_tmp_exists) fs.unlink(target + '.tmp.test1234');

// 4. auth_bootstrap failure-injection: bootstrap.json & bootstrap.token MUST be preserved when auth.json write fails
let bs_dir = vec_dir + '/bs_test';
fs.mkdir(bs_dir);
fs.writefile(bs_dir + '/bootstrap.json', '{"token_hash":"abc"}\n');
fs.writefile(bs_dir + '/bootstrap.token', 'secret-tok\n');
let bs_reply = null;
let bs_aw = helperd_aw.atomic_write(bs_dir + '/auth.json', '{"users":{}}\n', 0o600, null, null, make_ops('rename', true));
if (!bs_aw.ok) {
	bs_reply = { ok: false, error_code: 'INTERNAL', error: bs_aw.error, orig_error: bs_aw.orig_error, cleanup_failed: bs_aw.cleanup_failed, tmp_path: bs_aw.tmp_path };
} else {
	if (fs.stat(bs_dir + '/bootstrap.json')) fs.unlink(bs_dir + '/bootstrap.json');
	if (fs.stat(bs_dir + '/bootstrap.token')) fs.unlink(bs_dir + '/bootstrap.token');
	bs_reply = { ok: true };
}
let bs_tmp_exists = !!fs.stat(bs_dir + '/auth.json.tmp.test1234');
check(
	bs_reply != null && !bs_reply.ok && bs_reply.cleanup_failed && !!fs.stat(bs_dir + '/bootstrap.json') && !!fs.stat(bs_dir + '/bootstrap.token') && !fs.stat(bs_dir + '/auth.json'),
	'P3A-HELPERD[auth_bootstrap_failure_preserves_bootstrap_files]',
	sprintf('bs_reply=%J', bs_reply)
);
if (bs_tmp_exists) fs.unlink(bs_dir + '/auth.json.tmp.test1234');

// 5. sys_sysupgrade_conf_save post-write verification failure + rollback success & rollback failure
let rb_dir = vec_dir + '/rb_test';
fs.mkdir(rb_dir);
let rb_target = rb_dir + '/sysupgrade.conf';
let rb_orig = '# Original comment\n/etc/dropbear/\n';
fs.writefile(rb_target, rb_orig);
fs.chmod(rb_target, 0o640);
let st_orig_rb = fs.lstat(rb_target);
// Simulate replacement succeeded, but post-write verification detected mismatch -> rollback must restore rb_orig + mode 0o640
fs.writefile(rb_target, '# Corrupted content\n');
fs.chmod(rb_target, 0o600);
let rb_aw_ok = helperd_aw.atomic_write(rb_target, rb_orig, 0o640, st_orig_rb.uid, st_orig_rb.gid);
let st_after_rb = fs.lstat(rb_target);
check(
	rb_aw_ok.ok && fs.readfile(rb_target) == rb_orig && (st_after_rb.mode & 0o7777) == 0o640 && st_after_rb.uid == st_orig_rb.uid && st_after_rb.gid == st_orig_rb.gid,
	'P3A-HELPERD[sysupgrade_conf_post_verify_rollback_ok]',
	sprintf('rb_aw=%J mode=%o', rb_aw_ok, st_after_rb ? (st_after_rb.mode & 0o7777) : 0)
);
// Simulate rollback itself failing (unlink fail on rename fail) -> must report rollback failure and preserve tmp_path
let rb_aw_fail = helperd_aw.atomic_write(rb_target, rb_orig, 0o640, st_orig_rb.uid, st_orig_rb.gid, make_ops('rename', true));
let rb_tmp_exists = !!fs.stat(rb_target + '.tmp.test1234');
check(
	!rb_aw_fail.ok && rb_aw_fail.cleanup_failed && rb_tmp_exists,
	'P3A-HELPERD[sysupgrade_conf_rollback_failure_detected]',
	sprintf('rb_aw_fail=%J tmp=%J', rb_aw_fail, rb_tmp_exists)
);
if (rb_tmp_exists) fs.unlink(rb_target + '.tmp.test1234');

// 6. Production fw_check_and_reload: failure to restore /etc/config/firewall must set freeze.json and report rollback_failed
let fw_etc = vec_dir + '/fw_etc';
fs.mkdir(fw_etc);
fs.mkdir('/etc/config');
let fw_cfg = '/etc/config/firewall';
let had_fw = !!fs.stat(fw_cfg);
let orig_fw = had_fw ? fs.readfile(fw_cfg) : null;
fs.writefile(fw_cfg, 'BROKEN_FW\n');
helperd_aw.set_mock({ ok: false }, { ok: true }, fw_etc);
// Make /etc/config/firewall a directory temporarily? No, test success restore first, then failure restore!
let fw_res_ok = null;
helperd_aw.fw_check_and_reload('GOOD_FW\n', function(r) { fw_res_ok = r; });
let fw_st_ok = fs.lstat(fw_cfg);
check(
	fw_res_ok != null && !fw_res_ok.ok && fw_res_ok.rolled_back === true && fs.readfile(fw_cfg) == 'GOOD_FW\n' && (fw_st_ok.mode & 0o7777) == 0o644,
	'P3A-HELPERD[fw_check_and_reload_restore_ok]',
	sprintf('res=%J content=%J', fw_res_ok, fs.readfile(fw_cfg))
);
// Now force restore write failure by replacing /etc/config/firewall with a directory so rename fails with EISDIR
fs.unlink(fw_cfg);
fs.mkdir(fw_cfg);
let fw_res_fail = null;
helperd_aw.fw_check_and_reload('GOOD_FW\n', function(r) { fw_res_fail = r; });
let fw_freeze = fs.readfile(fw_etc + '/freeze.json');
fs.rmdir(fw_cfg);
if (orig_fw != null) fs.writefile(fw_cfg, orig_fw);
check(
	fw_res_fail != null && !fw_res_fail.ok && fw_res_fail.rollback_failed === true && fw_res_fail.rolled_back === false && fw_freeze != null && index(fw_freeze, 'fw_check_and_reload restore failed') >= 0,
	'P3A-HELPERD[fw_check_and_reload_restore_fail_triggers_freeze]',
	sprintf('res=%J freeze=%J', fw_res_fail, fw_freeze)
);

// 7. Production rollback_client_rules: verify persisted file + applied state; failure enters freeze and never reports success
let cr_dir = vec_dir + '/cr_test';
fs.mkdir(cr_dir);
let cr_file = cr_dir + '/client_rules.json';
fs.writefile(cr_file, '{"blocked_macs":{"aa:bb:cc:dd:ee:ff":true}}\n');
let cr_ok = null;
helperd_aw.set_mock({ ok: true }, { ok: true }, cr_dir);
helperd_aw.rollback_client_rules(cr_file, '{"blocked_macs":{}}\n', { blocked_macs: {} }, 'client_block', 'admin', 'client_block', 'aa:bb:cc:dd:ee:ff', function(r) { cr_ok = r; });
let cr_st = fs.lstat(cr_file);
check(
	cr_ok != null && cr_ok.all_ok === true && cr_ok.file_ok === true && cr_ok.apply_ok === true && fs.readfile(cr_file) == '{"blocked_macs":{}}\n' && (cr_st.mode & 0o7777) == 0o600,
	'P3A-HELPERD[rollback_client_rules_ok_verified]',
	sprintf('cr_ok=%J', cr_ok)
);
// Force file rollback failure by replacing cr_file with a directory
fs.unlink(cr_file);
fs.mkdir(cr_file);
let cr_fail = null;
helperd_aw.rollback_client_rules(cr_file, '{"blocked_macs":{}}\n', { blocked_macs: {} }, 'client_set_meta', 'admin', 'client_set_meta', 'aa:bb:cc:dd:ee:ff', function(r) { cr_fail = r; });
let cr_freeze = fs.readfile(cr_dir + '/freeze.json');
fs.rmdir(cr_file);
check(
	cr_fail != null && cr_fail.all_ok === false && cr_fail.file_ok === false && cr_freeze != null && index(cr_freeze, 'client_set_meta rollback failed') >= 0,
	'P3A-HELPERD[rollback_client_rules_write_fail_triggers_freeze]',
	sprintf('cr_fail=%J freeze=%J', cr_fail, cr_freeze)
);

// 8. Production handle_sys_sysupgrade_conf_save: readfile == null on existing file aborts with zero mutations
let su_dir = vec_dir + '/su_read_fail';
fs.mkdir(su_dir);
let su_path = su_dir + '/sysupgrade.conf';
let su_orig = '# Do not lose this\n/etc/dropbear/\n';
fs.writefile(su_path, su_orig);
fs.chmod(su_path, 0o640);
helperd_aw.set_mock({ ok: true }, { ok: true }, su_dir, su_path, su_path);
let su_reply = null;
helperd_aw.handle_sys_sysupgrade_conf_save({ paths: ['/etc/noc-console/'] }, 'admin', function(r) { su_reply = r; });
let su_st_after = fs.lstat(su_path);
check(
	su_reply != null && !su_reply.ok && su_reply.error_code == 'INTERNAL' && helperd_aw.spy_mutations == 0 && fs.readfile(su_path) == su_orig && (su_st_after.mode & 0o7777) == 0o640,
	'P3A-HELPERD[sysupgrade_conf_read_null_aborts_preserving_orig]',
	sprintf('reply=%J mutations=%d', su_reply, helperd_aw.spy_mutations)
);

// 9. Fail-safe in-memory freeze when freeze.json persistence fails -> subsequent privileged mutations rejected!
let frz_etc = vec_dir + '/frz_fail_etc';
fs.mkdir(frz_etc);
fs.mkdir(frz_etc + '/freeze.json'); // directory obstruction causes atomic_write(freeze.json) rename to fail!
helperd_aw.clear_freeze_mem();
helperd_aw.set_mock({ ok: false }, { ok: true }, frz_etc, su_path, null);
fs.unlink(fw_cfg);
fs.mkdir(fw_cfg);
let fw_frz_res = null;
helperd_aw.fw_check_and_reload('GOOD_FW\n', function(r) { fw_frz_res = r; });
fs.rmdir(fw_cfg);
if (orig_fw != null) fs.writefile(fw_cfg, orig_fw);
let frz_state_now = helperd_aw.get_freeze_state();

// Attempt actual privileged mutations through production enforce_mutation_gate after freeze.json failed
helperd_aw.set_mock({ ok: true }, { ok: true }, frz_etc, su_path, null);
let mut1_reply = null;
if (helperd_aw.enforce_mutation_gate('sys_sysupgrade_conf_save', { paths: ['/etc/noc-console/'] }, 'admin', function(r) { mut1_reply = r; })) {
	helperd_aw.handle_sys_sysupgrade_conf_save({ paths: ['/etc/noc-console/'] }, 'admin', function(r) { mut1_reply = r; });
}
let mut2_reply = null;
let mut2_allowed = helperd_aw.enforce_mutation_gate('sys_reboot', { confirm: 'CONFIRM_REBOOT' }, 'admin', function(r) { mut2_reply = r; });
let spy_after_muts = helperd_aw.spy_mutations;
// Attempt freeze_clear without confirmation -> must be rejected and keep freeze active
let fc_bad_reply = null;
helperd_aw.enforce_mutation_gate('freeze_clear', {}, 'admin', function(r) { fc_bad_reply = r; });
let frz_still_active = helperd_aw.get_freeze_state().frozen === true;
// Attempt freeze_clear with explicit confirmation -> must succeed and lift freeze
let fc_ok_reply = null;
helperd_aw.enforce_mutation_gate('freeze_clear', { confirm_reconciled: true }, 'admin', function(r) { fc_ok_reply = r; });
let frz_cleared = helperd_aw.get_freeze_state().frozen === false;

check(
	fw_frz_res != null && !fw_frz_res.ok && fw_frz_res.rollback_failed === true && fw_frz_res.freeze_persist_failed === true && fw_frz_res.freeze_persisted === false
	&& frz_state_now.frozen === true
	&& mut1_reply != null && !mut1_reply.ok && mut1_reply.status == 409 && spy_after_muts == 0 && fs.readfile(su_path) == su_orig
	&& !mut2_allowed && mut2_reply != null && !mut2_reply.ok && mut2_reply.status == 409
	&& fc_bad_reply != null && !fc_bad_reply.ok && frz_still_active
	&& fc_ok_reply != null && fc_ok_reply.ok && frz_cleared,
	'P3A-HELPERD[freeze_persist_fail_enforces_in_memory_freeze]',
	sprintf('res=%J mut1=%J mut2=%J fc_bad=%J fc_ok=%J spy=%d', fw_frz_res, mut1_reply, mut2_reply, fc_bad_reply, fc_ok_reply, spy_after_muts)
);

// 10. Production handle_rollback_revert: failure preserves .bak/.pending, success verifies & cleans up
let rbr_dir = vec_dir + '/rbr_test';
fs.mkdir(rbr_dir);
let rbr_base = rbr_dir + '/rb_deadbeef';
let rbr_cfg = rbr_dir + '/target.cfg';
fs.writefile(rbr_base + '.bak', 'RESTORED_CFG\n');
fs.writefile(rbr_base + '.pending', '{"kind":"firewall"}\n');
// 10a. Failure case: target is a directory so atomic_write fails -> .bak & .pending preserved, rollback_failed=true
fs.mkdir(rbr_cfg);
let rbr_fail_res = null;
helperd_aw.handle_rollback_revert(rbr_base, { kind: 'firewall', cfg_path: rbr_cfg, reload_cmd: '' }, 'admin', function(r) { rbr_fail_res = r; });
fs.rmdir(rbr_cfg);
check(
	rbr_fail_res != null && !rbr_fail_res.ok && rbr_fail_res.rollback_failed === true && !!fs.stat(rbr_base + '.bak') && !!fs.stat(rbr_base + '.pending'),
	'P3A-HELPERD[rollback_revert_fail_preserves_artifacts]',
	sprintf('res=%J', rbr_fail_res)
);
// 10b. Success case: target restored, mode 0644 & bytes verified, .bak & .pending deleted
fs.writefile(rbr_cfg, 'BROKEN_CFG\n');
let rbr_ok_res = null;
helperd_aw.handle_rollback_revert(rbr_base, { kind: 'firewall', cfg_path: rbr_cfg, reload_cmd: '' }, 'admin', function(r) { rbr_ok_res = r; });
let rbr_st = fs.lstat(rbr_cfg);
check(
	rbr_ok_res != null && rbr_ok_res.ok === true && fs.readfile(rbr_cfg) == 'RESTORED_CFG\n' && (rbr_st.mode & 0o7777) == 0o644 && !fs.stat(rbr_base + '.bak') && !fs.stat(rbr_base + '.pending'),
	'P3A-HELPERD[rollback_revert_ok_verified_and_cleaned]',
	sprintf('res=%J', rbr_ok_res)
);

printf('UCODE_SUMMARY: %d passed, %d failed\n', passed, failed);
exit(failed == 0 ? 0 : 1);
