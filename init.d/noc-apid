#!/bin/sh /etc/rc.common

START=96
STOP=10
USE_PROCD=1

PROG=/usr/libexec/noc-apid
TLS_CERT=/etc/noc-console/tls.crt
TLS_KEY=/etc/noc-console/tls.key
TLS_FP=/etc/noc-console/tls.fingerprint
STUNNEL_CONF=/tmp/noc-console/stunnel.conf
TLS_STATE_DIR=/tmp/noc-console-tls
TLS_MARKER=/tmp/noc-console-tls/tls.verified
TLS_RUNNER=/tmp/noc-console-tls/run_tls_proxy.sh
HTTPS_PORT=8743
HTTP_PORT=8780

EXTRA_COMMANDS="renew_cert"
EXTRA_HELP="	renew_cert	Regenerate TLS certificate and update SHA-256 fingerprint"

get_lan_ip() {
	_raw="$(uci -q get network.lan.ipaddr 2>/dev/null || true)"
	set -- $_raw
	_first="${1:-}"
	_ip="${_first%%/*}"
	[ -n "$_ip" ] && printf '%s\n' "$_ip" || printf '%s\n' "192.168.1.1"
}

generate_tls_cert() {
	LAN_IP="$(get_lan_ip)"
	HOSTNAME_VAL="$(uci -q get system.@system[0].hostname 2>/dev/null || hostname 2>/dev/null || echo 'nms')"

	if command -v openssl >/dev/null 2>&1; then
		openssl req -x509 -newkey rsa:2048 -nodes \
			-keyout "${TLS_KEY}.tmp" -out "${TLS_CERT}.tmp" -days 825 \
			-subj "/CN=${HOSTNAME_VAL}.lan" \
			-addext "subjectAltName=IP:${LAN_IP},DNS:nms.lan,DNS:${HOSTNAME_VAL}.lan" >/dev/null 2>&1 || \
		openssl req -x509 -newkey rsa:2048 -nodes \
			-keyout "${TLS_KEY}.tmp" -out "${TLS_CERT}.tmp" -days 825 \
			-subj "/CN=${HOSTNAME_VAL}.lan" >/dev/null 2>&1 || return 1
	elif command -v px5g >/dev/null 2>&1; then
		# px5g outputs PEM when -pem is supported or DER otherwise; verify PEM header
		if px5g selfsigned -pem -days 825 -newkey rsa:2048 \
			-keyout "${TLS_KEY}.tmp" -out "${TLS_CERT}.tmp" -subj "/CN=${HOSTNAME_VAL}.lan" >/dev/null 2>&1; then
			:
		else
			return 1
		fi
	else
		return 1
	fi

	grep -q "BEGIN CERTIFICATE" "${TLS_CERT}.tmp" 2>/dev/null || { rm -f "${TLS_CERT}.tmp" "${TLS_KEY}.tmp"; return 1; }
	chmod 0600 "${TLS_KEY}.tmp"
	chmod 0644 "${TLS_CERT}.tmp"
	mv "${TLS_KEY}.tmp" "$TLS_KEY"
	mv "${TLS_CERT}.tmp" "$TLS_CERT"

	if command -v openssl >/dev/null 2>&1; then
		openssl x509 -in "$TLS_CERT" -noout -fingerprint -sha256 > "${TLS_FP}.tmp" 2>/dev/null && mv "${TLS_FP}.tmp" "$TLS_FP" && chmod 0644 "$TLS_FP"
	fi
	return 0
}

ensure_tls_cert() {
	if [ -s "$TLS_CERT" ] && [ -s "$TLS_KEY" ] && grep -q "BEGIN CERTIFICATE" "$TLS_CERT" 2>/dev/null; then
		return 0
	fi
	generate_tls_cert
}

renew_cert() {
	generate_tls_cert && restart
}

detect_tls_engine() {
	if command -v stunnel >/dev/null 2>&1; then
		echo "stunnel"
		return 0
	fi
	if command -v socat >/dev/null 2>&1 && socat -V 2>&1 | grep -Eq '#define[[:space:]]+WITH_OPENSSL([[:space:]]|$)'; then
		echo "socat"
		return 0
	fi
	echo "none"
	return 1
}

write_stunnel_conf() {
	_lan_ip="$1"
	_tmp="${STUNNEL_CONF}.tmp.$$"
	cat > "$_tmp" <<EOF
foreground = yes
pid =
syslog = no

[noc_https]
accept = ${_lan_ip}:${HTTPS_PORT}
connect = 127.0.0.1:${HTTP_PORT}
cert = ${TLS_CERT}
key = ${TLS_KEY}
sslVersionMin = TLSv1.2
EOF
	chmod 0600 "$_tmp"
	mv -f "$_tmp" "$STUNNEL_CONF"
}

prepare_tls_state_dir() {
	_engine="$1"
	_lan_ip="$2"
	rm -rf "$TLS_STATE_DIR" 2>/dev/null || true
	mkdir -p "$TLS_STATE_DIR"
	chown 0:0 "$TLS_STATE_DIR" 2>/dev/null || true
	chmod 0755 "$TLS_STATE_DIR"
	cp -f "$TLS_CERT" "${TLS_STATE_DIR}/tls.crt.tmp.$$"
	chown 0:0 "${TLS_STATE_DIR}/tls.crt.tmp.$$" 2>/dev/null || true
	chmod 0644 "${TLS_STATE_DIR}/tls.crt.tmp.$$"
	mv -f "${TLS_STATE_DIR}/tls.crt.tmp.$$" "${TLS_STATE_DIR}/tls.crt"
	_fp_val="$(cat "$TLS_FP" 2>/dev/null || true)"
	_port_hex="$(printf '%04X' "$HTTPS_PORT")"
	cat > "${TLS_RUNNER}.tmp.$$" <<EOF
#!/bin/sh
set -u
MARKER="${TLS_MARKER}"
PORT_HEX="${_port_hex}"
ENGINE="${_engine}"
LAN_IP="${_lan_ip}"
HTTPS_P="${HTTPS_PORT}"
FP_VAL="${_fp_val}"
_child=""

cleanup_tls() {
	rm -f "\$MARKER" "\${MARKER}.tmp."* 2>/dev/null || true
	if [ -n "\$_child" ] && kill -0 "\$_child" 2>/dev/null; then
		kill -TERM "\$_child" 2>/dev/null || true
		wait "\$_child" 2>/dev/null || true
	fi
}
trap 'cleanup_tls; exit 0' INT TERM HUP
trap 'cleanup_tls' EXIT

child_owns_socket_inode() {
	_c="\$1"
	_target="socket:[\$2]"
	for _fd in "/proc/\${_c}/fd/"*; do
		[ -L "\$_fd" ] || continue
		if [ "\$(readlink "\$_fd" 2>/dev/null || true)" = "\$_target" ]; then
			return 0
		fi
	done
	return 1
}

get_pid_stime() {
	sed 's/^.*)[[:space:]]*//' "/proc/\$1/stat" 2>/dev/null | awk '{print \$20}' || true
}

get_uptime_ds() {
	awk '{ printf "%d\n", int(\$1 * 10) }' /proc/uptime 2>/dev/null || echo 0
}

write_verified_marker() {
	_now_ds="\$(get_uptime_ds)"
	cat > "\${MARKER}.tmp.\$\$" <<MKEOF
verified=1
engine=\${ENGINE}
pid=\${_child}
starttime=\${_matched_stime}
sup_pid=\$\$
sup_starttime=\${_sup_stime}
verified_ds=\${_now_ds}
inode=\${_matched_inode}
lan_ip=\${LAN_IP}
https_port=\${HTTPS_P}
fingerprint=\${FP_VAL}
MKEOF
	chown 0:0 "\${MARKER}.tmp.\$\$" 2>/dev/null || true
	chmod 0644 "\${MARKER}.tmp.\$\$"
	mv -f "\${MARKER}.tmp.\$\$" "\$MARKER"
}

rm -f "\$MARKER" "\${MARKER}.tmp."* 2>/dev/null || true
_sup_stime="\$(get_pid_stime "\$\$")"
"\$@" &
_child=\$!

_i=0
_ready=0
_matched_inode=""
_matched_stime=""
while [ "\$_i" -lt 50 ]; do
	if ! kill -0 "\$_child" 2>/dev/null; then
		wait "\$_child" 2>/dev/null || true
		exit 1
	fi
	_inodes="\$(awk -v p=":\${PORT_HEX}" '\$2 ~ p"\$" && \$4 == "0A" { print \$10 }' /proc/net/tcp /proc/net/tcp6 2>/dev/null || true)"
	for _ino in \$_inodes; do
		if [ -n "\$_ino" ] && [ "\$_ino" != "0" ] && child_owns_socket_inode "\$_child" "\$_ino"; then
			_matched_inode="\$_ino"
			_matched_stime="\$(get_pid_stime "\$_child")"
			_ready=1
			break
		fi
	done
	[ "\$_ready" -eq 1 ] && break
	sleep 0.1
	_i=\$((_i + 1))
done

if [ "\$_ready" -ne 1 ] || [ -z "\$_matched_inode" ] || [ -z "\$_matched_stime" ] || [ -z "\$_sup_stime" ]; then
	exit 1
fi

write_verified_marker

while kill -0 "\$_child" 2>/dev/null; do
	if ! child_owns_socket_inode "\$_child" "\$_matched_inode"; then
		rm -f "\$MARKER" "\${MARKER}.tmp."* 2>/dev/null || true
		kill -TERM "\$_child" 2>/dev/null || true
		break
	fi
	write_verified_marker
	sleep 0.5
done
wait "\$_child" 2>/dev/null || true
_rc=\$?
rm -f "\$MARKER" "\${MARKER}.tmp."* 2>/dev/null || true
exit "\$_rc"
EOF
	chown 0:0 "${TLS_RUNNER}.tmp.$$" 2>/dev/null || true
	chmod 0700 "${TLS_RUNNER}.tmp.$$"
	mv -f "${TLS_RUNNER}.tmp.$$" "$TLS_RUNNER"
}

start_service() {
	mkdir -p /tmp/noc-console
	chmod 0755 /tmp/noc-console

	LAN_IP="$(get_lan_ip)"
	ALLOW_INSECURE="${NOC_ALLOW_INSECURE_HTTP:-0}"
	TLS_ENGINE="$(detect_tls_engine)"

	if ensure_tls_cert && [ "$TLS_ENGINE" != "none" ]; then
		prepare_tls_state_dir "$TLS_ENGINE" "$LAN_IP"
		procd_open_instance noc_apid
		procd_set_param command "$PROG"
		procd_set_param user noc-api
		procd_set_param group noc-api
		procd_set_param env NOC_WEB_ROOT=/www NOC_HELPER_SOCK=/tmp/noc-console/helper.sock NOC_HTTP_PORT="$HTTP_PORT" NOC_HTTPS_PORT="$HTTPS_PORT" NOC_BIND_HOST="127.0.0.1" NOC_LAN_IP="$LAN_IP" NOC_TLS_VERIFIED="1" NOC_TLS_MARKER="$TLS_MARKER" NOC_TLS_CERT="$TLS_CERT" NOC_TLS_KEY="$TLS_KEY"
		procd_set_param respawn 3600 5 5
		procd_set_param stdout 1
		procd_set_param stderr 1
		procd_close_instance

		if [ "$TLS_ENGINE" = "stunnel" ]; then
			write_stunnel_conf "$LAN_IP"
			STUNNEL_BIN="$(command -v stunnel)"
			procd_open_instance noc_tls_proxy
			procd_set_param command "$TLS_RUNNER" "$STUNNEL_BIN" "$STUNNEL_CONF"
			procd_set_param respawn 3600 5 5
			procd_set_param stdout 1
			procd_set_param stderr 1
			procd_close_instance
		else
			SOCAT_BIN="$(command -v socat)"
			procd_open_instance noc_tls_proxy
			procd_set_param command "$TLS_RUNNER" "$SOCAT_BIN" "OPENSSL-LISTEN:${HTTPS_PORT},bind=${LAN_IP},reuseaddr,fork,cert=${TLS_CERT},key=${TLS_KEY},verify=0" "TCP:127.0.0.1:${HTTP_PORT}"
			procd_set_param respawn 3600 5 5
			procd_set_param stdout 1
			procd_set_param stderr 1
			procd_close_instance
		fi
	elif [ "$ALLOW_INSECURE" = "1" ]; then
		rm -rf "$TLS_STATE_DIR" 2>/dev/null || true
		logger -t noc-apid "WARNING: Explicit NOC_ALLOW_INSECURE_HTTP=1 active; binding unencrypted HTTP on ${LAN_IP}:${HTTP_PORT}"
		procd_open_instance noc_apid
		procd_set_param command "$PROG"
		procd_set_param user noc-api
		procd_set_param group noc-api
		procd_set_param env NOC_WEB_ROOT=/www NOC_HELPER_SOCK=/tmp/noc-console/helper.sock NOC_HTTP_PORT="$HTTP_PORT" NOC_BIND_HOST="$LAN_IP" NOC_LAN_IP="$LAN_IP" NOC_TLS_VERIFIED="0"
		procd_set_param respawn 3600 5 5
		procd_set_param stdout 1
		procd_set_param stderr 1
		procd_close_instance
	else
		rm -rf "$TLS_STATE_DIR" 2>/dev/null || true
		logger -t noc-apid "ERROR: TLS prerequisites (PEM cert/key + stunnel or OpenSSL-enabled socat) missing; refusing to expose unencrypted HTTP admin UI."
		return 1
	fi
}

stop_service() {
	rm -f "$STUNNEL_CONF" "${STUNNEL_CONF}.tmp."* 2>/dev/null || true
	rm -rf "$TLS_STATE_DIR" 2>/dev/null || true
}

service_triggers() {
	procd_add_reload_trigger "network"
	procd_add_interface_trigger "interface.*" "lan" /etc/init.d/noc-apid restart
}
