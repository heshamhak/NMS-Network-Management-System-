#!/bin/sh /etc/rc.common

START=96
STOP=10
USE_PROCD=1

PROG=/usr/libexec/noc-apid
TLS_CERT=/etc/noc-console/tls.crt
TLS_KEY=/etc/noc-console/tls.key
HTTPS_PORT=8743
HTTP_PORT=8780

ensure_tls_cert() {
	if [ -s "$TLS_CERT" ] && [ -s "$TLS_KEY" ]; then
		return 0
	fi
	if command -v openssl >/dev/null 2>&1; then
		openssl req -x509 -newkey rsa:2048 -nodes \
			-keyout "$TLS_KEY" -out "$TLS_CERT" -days 1825 \
			-subj "/CN=nms.lan" >/dev/null 2>&1 && \
			chmod 0600 "$TLS_KEY" && chmod 0644 "$TLS_CERT" && return 0
	elif command -v px5g >/dev/null 2>&1; then
		px5g selfsigned -der -days 1825 -newkey rsa:2048 \
			-keyout "$TLS_KEY" -out "$TLS_CERT" -subj "/CN=nms.lan" >/dev/null 2>&1 && \
			chmod 0600 "$TLS_KEY" && chmod 0644 "$TLS_CERT" && return 0
	fi
	return 1
}

start_service() {
	mkdir -p /tmp/noc-console
	chmod 0755 /tmp/noc-console

	LAN_IP="$(uci -q get network.lan.ipaddr 2>/dev/null || echo '192.168.1.1')"
	TLS_VERIFIED=0
	BIND_HOST="$LAN_IP"

	if ensure_tls_cert && command -v socat >/dev/null 2>&1 && socat -V 2>&1 | grep -qi openssl; then
		TLS_VERIFIED=1
		BIND_HOST="127.0.0.1"
	else
		logger -t noc-apid "WARNING: TLS terminator (socat+openssl) or cert unavailable; binding HTTP on ${LAN_IP}:${HTTP_PORT} (LAN only)"
	fi

	procd_open_instance noc_apid
	procd_set_param command "$PROG"
	procd_set_param user noc-api
	procd_set_param group noc-api
	procd_set_param env NOC_WEB_ROOT=/www NOC_HELPER_SOCK=/tmp/noc-console/helper.sock NOC_HTTP_PORT="$HTTP_PORT" NOC_HTTPS_PORT="$HTTPS_PORT" NOC_BIND_HOST="$BIND_HOST" NOC_TLS_VERIFIED="$TLS_VERIFIED" NOC_TLS_CERT="$TLS_CERT" NOC_TLS_KEY="$TLS_KEY"
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance

	if [ "$TLS_VERIFIED" -eq 1 ]; then
		procd_open_instance noc_tls_proxy
		procd_set_param command /usr/bin/socat "OPENSSL-LISTEN:${HTTPS_PORT},bind=${LAN_IP},reuseaddr,fork,cert=${TLS_CERT},key=${TLS_KEY},verify=0" "TCP:127.0.0.1:${HTTP_PORT}"
		procd_set_param respawn 3600 5 5
		procd_set_param stdout 1
		procd_set_param stderr 1
		procd_close_instance
	fi
}

service_triggers() {
	procd_add_reload_trigger "network"
	procd_add_interface_trigger "interface.*" "lan" /etc/init.d/noc-apid restart
}
