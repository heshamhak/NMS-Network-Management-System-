#!/bin/sh /etc/rc.common

START=94
STOP=10
USE_PROCD=1

PROG=/usr/libexec/noc-helperd

start_service() {
	mkdir -p /etc/noc-console /tmp/noc-console
	chmod 0700 /etc/noc-console
	chown root:root /etc/noc-console
	chmod 0755 /tmp/noc-console

	if [ -s /etc/noc-console/noc_block.nft ] && [ -x /usr/sbin/nft ]; then
		/usr/sbin/nft -f /etc/noc-console/noc_block.nft 2>/dev/null || true
	fi

	procd_open_instance noc_helperd
	procd_set_param command "$PROG"
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

stop_service() {
	rm -f /tmp/noc-console/helper.sock /tmp/noc-console/mutation.lock
}
