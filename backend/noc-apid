// --- Session & Security Enforcement (P14) ---
function parse_cookies(hdr_val) {
	let res = {};
	if (!hdr_val) return res;
	for (let part in split(hdr_val, ';')) {
		let eq = index(part, '=');
		if (eq > 0) res[trim(substr(part, 0, eq))] = trim(substr(part, eq + 1));
	}
	return res;
}

function get_session(headers) {
	let ck = parse_cookies(headers['cookie'] || '');
	let sid = ck['noc_session'] || '';
	if (sid == '' || !sessions[sid]) return null;
	let sess = sessions[sid];
	let now_t = time();
	if ((now_t - sess.last_seen) > SESSION_IDLE_S || (now_t - sess.created_at) > SESSION_ABS_S) {
		delete sessions[sid];
		return null;
	}
	sess.last_seen = now_t;
	return sess;
}

function is_origin_allowed(headers, require_present) {
	let orig = headers['origin'] || '';
	if (orig == '') return !require_present;
	let lan = get_lan_ip();
	let hn = get_sys_hostname();
	let allowed = {};
	allowed[sprintf('http://%s:%d', lan, BIND_PORT)] = true;
	allowed[sprintf('http://%s:%d', hn, BIND_PORT)] = true;
	allowed[sprintf('http://%s.lan:%d', hn, BIND_PORT)] = true;
	if (TLS_ACTIVE) {
		allowed[sprintf('https://%s:%d', lan, HTTPS_PORT)] = true;
		allowed[sprintf('https://%s:%d', hn, HTTPS_PORT)] = true;
		allowed[sprintf('https://%s.lan:%d', hn, HTTPS_PORT)] = true;
	}
	if (STAGING_MODE) {
		allowed[sprintf('http://127.0.0.1:%d', BIND_PORT)] = true;
		allowed[sprintf('http://localhost:%d', BIND_PORT)] = true;
	}
	return !!allowed[orig];
}

// --- Static File Server with Traversal Lock ---
const MIME_TYPES = {
	'.html': 'text/html; charset=utf-8',
	'.css': 'text/css; charset=utf-8',
	'.js': 'application/javascript; charset=utf-8',
	'.json': 'application/json; charset=utf-8',
	'.svg': 'image/svg+xml',
	'.png': 'image/png',
	'.apk': 'application/vnd.android.package-archive'
};

function sanitize_hdr_val(v) {
	return replace('' + v, /[\r\n]/g, '');
}

function send_http(cli, status_code, status_txt, ctype, body, extra_hdrs) {
	let h = sprintf(
		"HTTP/1.1 %d %s\r\nContent-Type: %s\r\nContent-Length: %d\r\nConnection: close\r\nX-Content-Type-Options: nosniff\r\nReferrer-Policy: no-referrer\r\nX-Frame-Options: DENY\r\nPermissions-Policy: geolocation=(), microphone=(), camera=()\r\n%sContent-Security-Policy: default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'; img-src 'self' data:; connect-src 'self'\r\n",
		status_code, status_txt, ctype, length(body), TLS_ACTIVE ? "Cross-Origin-Opener-Policy: same-origin\r\n" : ""
	);
	if (extra_hdrs) {
		for (let k in keys(extra_hdrs)) {
			h += sanitize_hdr_val(k) + ': ' + sanitize_hdr_val(extra_hdrs[k]) + '\r\n';
		}
	}
	h += "\r\n";
	try {
		let full = h + body;
		let off = 0;
		let total = length(full);
		let retries = 0;
		while (off < total) {
			let sent = cli.send(substr(full, off, 16384));
			if (sent && sent > 0) {
				off += sent;
				retries = 0;
			} else {
				retries++;
				if (retries > 50) break;
				sock.poll(40, [cli, sock.POLLOUT]);
			}
		}
	} catch (e) {}
	try { cli.close(); } catch (e) {}
}

function send_json_env(cli, code, resource, data, errors, extra_hdrs) {
	let hdrs = extra_hdrs || {};
	hdrs['Cache-Control'] = 'no-store, no-cache, must-revalidate';
	send_http(cli, code, code == 200 ? 'OK' : (code == 401 ? 'Unauthorized' : (code == 403 ? 'Forbidden' : (code == 429 ? 'Too Many Requests' : 'Error'))), 'application/json; charset=utf-8', sprintf('%J\n', envelope(resource, data, errors)), hdrs);
}

function serve_static(cli, url_path, req_headers) {
	let clean = split(url_path, '?')[0];
	if (clean == '/favicon.ico') {
		send_http(cli, 204, 'No Content', 'image/x-icon', '');
		return;
	}
	if (clean == '/' || clean == '/index.html') clean = '/pro/index.html';
	if (index(clean, '..') >= 0 || index(clean, '\\') >= 0 || index(clean, '\0') >= 0) {
		send_http(cli, 403, 'Forbidden', 'text/plain', 'Forbidden');
		return;
	}
	let real_root = fs.realpath(WEB_ROOT);
	let real_file = fs.realpath(WEB_ROOT + clean);
	if (!real_file && index(clean, '/pro/') != 0) {
		real_file = fs.realpath(WEB_ROOT + '/pro' + clean);
	}
	if (!real_root || !real_file || index(real_file, real_root) != 0) {
		send_http(cli, 404, 'Not Found', 'text/plain', 'Not Found');
		return;
	}
	let st = fs.stat(real_file);
	let content = fs.readfile(real_file);
	if (content == null) {
		send_http(cli, 404, 'Not Found', 'text/plain', 'Not Found');
		return;
	}
	let ext = '';
	let m = match(real_file, /(\.[a-zA-Z0-9]+)$/);
	if (m) ext = lc(m[1]);
	let etag = sprintf('"%x-%x"', (st && st.mtime) ? st.mtime : 0, length(content));
	let inm = req_headers ? (req_headers['if-none-match'] || '') : '';
	let cc = (ext == '.html' || ext == '.json') ? 'no-cache' : 'public, max-age=3600';
	if (inm != '' && inm == etag) {
		send_http(cli, 304, 'Not Modified', MIME_TYPES[ext] || 'application/octet-stream', '', { 'ETag': etag, 'Cache-Control': cc });
		return;
	}
	send_http(cli, 200, 'OK', MIME_TYPES[ext] || 'application/octet-stream', content, { 'ETag': etag, 'Cache-Control': cc });
}

function parse_qs(qs) {
	let res = {};
	if (!qs) return res;
	for (let part in split(qs, '&')) {
		let eq = index(part, '=');
		if (eq > 0) {
			res[substr(part, 0, eq)] = replace(replace(substr(part, eq + 1), '+', ' '), /%([0-9A-Fa-f]{2})/g, function(m, h) { return chr(int(h, 16)); });
		}
	}
	return res;
}

// --- Shared Cached Helper Query Coalescing (P18) ---
function cached_helper_call(cache_key, ttl_ms, resource, verb, params, actor, cip, transform_fn, cli) {
	let now_m = now_mono_ms();
	let c = cache_map[cache_key];
	if (c && (now_m - c.ts) < ttl_ms) {
		send_json_env(cli, 200, resource, c.data, c.errors || []);
		return;
	}
	if (inflight_helper[cache_key]) {
		push(inflight_helper[cache_key], cli);
		return;
	}
	inflight_helper[cache_key] = [cli];
	call_helper(verb, params, actor, cip, function(res) {
		let waiters = inflight_helper[cache_key] || [];
		delete inflight_helper[cache_key];
		let errs = [];
		let out_data = res;
		if (transform_fn) out_data = transform_fn(res, errs);
		if (res.ok) cache_map[cache_key] = { ts: now_mono_ms(), data: out_data, errors: errs };
		for (let w in waiters) {
			send_json_env(w, res.ok ? 200 : 503, resource, out_data, errs);
		}
	});
}

// --- Format AdGuard / Clients Helper Output into Schema Contracts ---
function shape_adguard_data(hres, role) {
	if (!hres || !hres.ok) return { ok: false, error: hres ? hres.message_ar : 'غير متاح' };
	let qlogs = hres.querylog || [];
	let client_stats_map = {};
	let filter_names = {};
	if (hres.filtering && hres.filtering.filters) {
		for (let f in hres.filtering.filters) filter_names['' + f.id] = f.name;
	}
	// Map IP -> hostname from leases/neighbors
	let ip_to_name = { '192.168.1.1': 'بوابة الشبكة الرئيسية' };
	let ip_to_mac = {};
	for (let line in split(hres.leases_raw || '', '\n')) {
		let p = split(trim(line), /\s+/);
		if (length(p) >= 4) {
			ip_to_mac[p[2]] = lc(p[1]);
			if (p[3] != '*') ip_to_name[p[2]] = p[3];
		}
	}
	let online_ips = {};
	for (let line in split(hres.neigh_raw || '', '\n')) {
		let m = match(trim(line), /^([0-9.]+)\s+lladdr\s+([0-9a-fA-F:]+)\s+(\S+)/);
		if (m) {
			ip_to_mac[m[1]] = lc(m[2]);
			if (m[3] == 'REACHABLE' || m[3] == 'DELAY' || m[3] == 'STALE') online_ips[m[1]] = true;
		}
	}

	let total_q = 0, allowed_q = 0, blocked_q = 0, sum_ms = 0;
	let recent = [];
	if (hres.query_summary) {
		let qs = hres.query_summary;
		total_q = +qs.total_q || 0;
		allowed_q = +qs.allowed_q || 0;
		blocked_q = +qs.blocked_q || 0;
		sum_ms = +qs.sum_ms || 0;
		let pip = qs.per_ip || {};
		for (let cip in keys(pip)) {
			let d = pip[cip];
			client_stats_map[cip] = {
				ip: cip, name: ip_to_name[cip] || ('جهاز ' + cip), mac: ip_to_mac[cip] || '',
				online: !!online_ips[cip], total: +d.total || 0, allowed: +d.allowed || 0,
				blocked: +d.blocked || 0, elapsed_sum: +d.elapsed_sum || 0,
				last_domain: d.last_domain || '', last_blocked: !!d.last_blocked, last_time: d.last_time || ''
			};
		}
		if (role == 'admin') {
			for (let q in (qs.recent || [])) {
				let cip = q.IP || '';
				let cname = (client_stats_map[cip] && client_stats_map[cip].name) || ip_to_name[cip] || ('جهاز ' + cip);
				let rule_t = q.rule || '';
				push(recent, {
					time: q.time || '', domain: q.QH || '', type: q.QT || 'A', client: cip, client_name: cname,
					blocked: !!q.blocked, rule: rule_t, elapsed_ms: +q.elapsed_ms || 0,
					reason_text: q.blocked ? (rule_t != '' ? ('مرفوض: ' + rule_t) : 'مرفوض: محجوب بقائمة التصفية') : (q.cached ? 'مسموح: من الذاكرة المؤقتة' : 'مسموح: نطاق سليم')
				});
			}
		}
	} else {
		for (let i = 0; i < length(qlogs); i++) {
			let q = qlogs[i];
			let cip = q.IP || '';
			if (cip == '' || cip == '127.0.0.1') continue;
			total_q++;
			let blocked = !!(q.Result && q.Result.IsFiltered);
			let el_ms = int((+q.Elapsed || 0) / 100000) / 10.0;
			sum_ms += el_ms;
			if (blocked) blocked_q++; else allowed_q++;

			if (!client_stats_map[cip]) {
				client_stats_map[cip] = {
					ip: cip, name: ip_to_name[cip] || ('جهاز ' + cip), mac: ip_to_mac[cip] || '',
					online: !!online_ips[cip], total: 0, allowed: 0, blocked: 0, elapsed_sum: 0,
					last_domain: '', last_blocked: false, last_time: ''
				};
			}
			let c = client_stats_map[cip];
			c.total++;
			c.elapsed_sum += el_ms;
			if (blocked) c.blocked++; else c.allowed++;
			let hhmmss = '';
			let mt = match(q.T || '', /T([0-9]{2}:[0-9]{2}:[0-9]{2})/);
			if (mt) hhmmss = mt[1];
			if (c.last_domain == '') {
				c.last_domain = q.QH; c.last_blocked = blocked; c.last_time = hhmmss;
			}
			if (role == 'admin' && length(recent) < 120) {
				let rule_t = (q.Result && q.Result.Rules && q.Result.Rules[0]) ? (q.Result.Rules[0].Text || '') : '';
				push(recent, {
					time: hhmmss, domain: q.QH, type: q.QT || 'A', client: cip, client_name: c.name,
					blocked: blocked, rule: rule_t, elapsed_ms: el_ms,
					reason_text: blocked ? (rule_t != '' ? ('مرفوض: ' + rule_t) : 'مرفوض: محجوب بقائمة التصفية') : (q.Cached ? 'مسموح: من الذاكرة المؤقتة' : 'مسموح: نطاق سليم')
				});
			}
		}
	}

	let cstats = [];
	let client_keys = keys(client_stats_map);
	let hide_pseudos = (role == 'readonly' && length(client_keys) < 3); // P4 minimum-group k>=3 rule
	for (let cip in client_keys) {
		let c = client_stats_map[cip];
		let avg_c = c.total >= 5 ? (int((c.elapsed_sum * 10) / c.total) / 10.0) : null;
		if (role == 'readonly') {
			if (hide_pseudos) continue;
			push(cstats, {
				ip: 'PSEUDO-' + substr(digest.sha256(BOOT_ID + cip), 0, 8),
				name: 'جهاز مصنّف',
				mac: '', online: c.online, total: c.total, allowed: c.allowed, blocked: c.blocked,
				avg_ms: avg_c, block_pct: c.total > 0 ? (int((c.blocked * 1000) / c.total) / 10.0) : 0,
				last_domain: '', last_blocked: c.last_blocked, last_time: c.last_time
			});
		} else {
			push(cstats, {
				ip: c.ip, name: c.name, mac: c.mac, online: c.online, total: c.total,
				allowed: c.allowed, blocked: c.blocked, avg_ms: avg_c,
				block_pct: c.total > 0 ? (int((c.blocked * 1000) / c.total) / 10.0) : 0,
				last_domain: c.last_domain, last_blocked: c.last_blocked, last_time: c.last_time
			});
		}
	}
	sort(cstats, function(a, b) { return b.total - a.total; });

	return {
		ok: true,
		api_connected: hres.api_connected,
		api_error: hres.api_error,
		protection_enabled: hres.status ? !!hres.status.protection_enabled : true,
		parental_enabled: !!hres.parental_enabled,
		safebrowsing_enabled: !!hres.safebrowsing_enabled,
		safesearch_enabled: !!hres.safesearch_enabled,
		enable_dnssec: !!(hres.dns_info && hres.dns_info.enable_dnssec),
		cache_enabled: (hres.dns_info && hres.dns_info.cache_enabled !== false),
		aaaa_disabled: !!(hres.dns_info && hres.dns_info.aaaa_disabled),
		blocked_services: hres.blocked_services || [],
		available_services: hres.available_services || [],
		rewrites: role == 'admin' ? (hres.rewrites || []) : [],
		dns_info: hres.dns_info || {},
		dnat_redirect_configured: !!hres.dnat_redirect_configured,
		doh_dot_bypass_status: hres.doh_dot_bypass_status || 'unknown',
		user_rules: (hres.filtering && hres.filtering.user_rules) ? hres.filtering.user_rules : [],
		filters: (hres.filtering && hres.filtering.filters) ? hres.filtering.filters : [],
		client_stats: cstats,
		stats: {
			sampled_queries: total_q,
			allowed_queries: allowed_q,
			blocked_queries: blocked_q,
			allowed_pct: total_q > 0 ? (int((allowed_q * 1000) / total_q) / 10.0) : 0,
			blocked_pct: total_q > 0 ? (int((blocked_q * 1000) / total_q) / 10.0) : 0,
			avg_ms: total_q >= 5 ? (int((sum_ms * 10) / total_q) / 10.0) : null
		},
		recent_queries: recent
	};
}

// --- API Request Dispatcher ---
function handle_api_request(cli, method, url_path, headers, body_str, remote_ip) {
	let qidx = index(url_path, '?');
	let qs = qidx >= 0 ? substr(url_path, qidx + 1) : '';
	let query = parse_qs(qs);
	let body = {};
	if (method == 'POST' && length(trim(body_str)) > 0) {
		try { body = json(body_str); } catch (e) {
			send_json_env(cli, 400, 'auth', {}, [{ code: 'VALIDATION', section: 'request', message_ar: 'صيغة JSON في جسم الطلب غير صالحة', request_id: urandom_hex(6) }]);
			return;
		}
		if (type(body) != 'object') {
			send_json_env(cli, 400, 'auth', {}, [{ code: 'VALIDATION', section: 'request', message_ar: 'يجب أن يكون جسم الطلب كائن JSON', request_id: urandom_hex(6) }]);
			return;
		}
	}

	let action = (body.action || query.action || 'overview');
	let req_id = urandom_hex(6);

	// 1. Pre-auth routes ONLY (P14)
	if (action == 'auth_status') {
		let cur_s = get_session(headers);
		call_helper('auth_status', {}, 'preauth', remote_ip, function(res) {
			res.authenticated = !!cur_s;
			res.tls_active = TLS_ACTIVE;
			res.transport = TLS_ACTIVE ? 'https_tls' : 'http_lan_only';
			res.https_port = HTTPS_PORT;
			if (cur_s) {
				res.username = cur_s.username;
				res.role = cur_s.role;
				res.csrf_token = cur_s.csrf;
			}
			send_json_env(cli, 200, 'auth', res, []);
		});
		return;
	}

	if (action == 'auth_bootstrap' && method == 'POST') {
		if (!is_origin_allowed(headers, true)) {
			send_json_env(cli, 403, 'auth', {}, [{ code: 'FORBIDDEN', section: 'auth', message_ar: 'رفض المصدر Origin غير الموثوق أو مفقود', request_id: req_id }]);
			return;
		}
		call_helper('auth_bootstrap_complete', { token: body.token, password: body.password }, 'bootstrap', remote_ip, function(res) {
			if (!res.ok) {
				send_json_env(cli, res.status || 400, 'auth', {}, [{ code: res.error_code || 'AUTH', section: 'auth', message_ar: res.message_ar, request_id: req_id }]);
				return;
			}
			let sid = urandom_hex(24);
			let csrf = urandom_hex(16);
			let now_t = time();
			sessions[sid] = { id: sid, username: 'admin', role: 'admin', csrf: csrf, created_at: now_t, last_seen: now_t, ip: remote_ip };
			let ck = sprintf('noc_session=%s; HttpOnly; SameSite=Strict; Path=/%s', sid, TLS_ACTIVE ? '; Secure' : '');
			send_json_env(cli, 200, 'auth', { authenticated: true, role: 'admin', csrf_token: csrf, message_ar: res.message_ar }, [], { 'Set-Cookie': ck });
		});
		return;
	}

	if (action == 'auth_login' && method == 'POST') {
		if (!is_origin_allowed(headers, true)) {
			send_json_env(cli, 403, 'auth', {}, [{ code: 'FORBIDDEN', section: 'auth', message_ar: 'رفض المصدر Origin غير الموثوق أو مفقود', request_id: req_id }]);
			return;
		}
		// Invalidate prior session on login to prevent session fixation
		let old_sess = get_session(headers);
		if (old_sess) delete sessions[old_sess.id];

		call_helper('auth_login', { username: body.username || 'admin', password: body.password || '', totp_code: body.totp_code || '' }, 'login', remote_ip, function(res) {
			if (!res.ok) {
				let hdrs = res.retry_after ? { 'Retry-After': '' + res.retry_after } : {};
				let err_data = res.totp_required ? { totp_required: true } : {};
				send_json_env(cli, res.status || 401, 'auth', err_data, [{ code: res.error_code || 'AUTH', section: 'auth', message_ar: res.message_ar, request_id: req_id }], hdrs);
				return;
			}
			let sid = urandom_hex(24);
			let csrf = urandom_hex(16);
			let now_t = time();
			sessions[sid] = { id: sid, username: res.username, role: res.role, csrf: csrf, created_at: now_t, last_seen: now_t, ip: remote_ip };
			let ck = sprintf('noc_session=%s; HttpOnly; SameSite=Strict; Path=/%s', sid, TLS_ACTIVE ? '; Secure' : '');
			send_json_env(cli, 200, 'auth', { authenticated: true, username: res.username, role: res.role, csrf_token: csrf }, [], { 'Set-Cookie': ck });
		});
		return;
	}

	if (action == 'auth_logout' && method == 'POST') {
		if (!is_origin_allowed(headers, true)) {
			send_json_env(cli, 403, 'auth', {}, [{ code: 'FORBIDDEN', section: 'auth', message_ar: 'رفض المصدر غير الموثوق', request_id: req_id }]);
			return;
		}
		let sess = get_session(headers);
		if (sess) delete sessions[sess.id];
		send_json_env(cli, 200, 'auth', { authenticated: false }, [], { 'Set-Cookie': 'noc_session=; HttpOnly; SameSite=Strict; Max-Age=0; Path=/' });
		return;
	}

	// 2. Enforce authentication on ALL remaining routes (P14)
	let sess = get_session(headers);
	if (!sess) {
		send_json_env(cli, 401, 'auth', { authenticated: false }, [{ code: 'AUTH', section: 'auth', message_ar: 'انتهت الجلسة أو يلزم تسجيل الدخول أولاً', request_id: req_id }]);
		return;
	}

	if (action == 'auth_session') {
		send_json_env(cli, 200, 'auth', { authenticated: true, username: sess.username, role: sess.role, csrf_token: sess.csrf }, []);
		return;
	}

	// Origin & CSRF checks for mutations AND admin-sensitive endpoints
	if (method == 'POST' || action == 'diagnostics' || action == 'logs' || action == 'audit' || action == 'stream') {
		if (!is_origin_allowed(headers, method == 'POST')) {
			send_json_env(cli, 403, 'auth', {}, [{ code: 'FORBIDDEN', section: 'security', message_ar: 'رفض الطلب لاختلاف Origin أو غيابه', request_id: req_id }]);
			return;
		}
	}
	if (method == 'POST') {
		let csrf_hdr = headers['x-csrf-token'] || '';
		if (csrf_hdr == '' || csrf_hdr != sess.csrf) {
			send_json_env(cli, 403, 'auth', {}, [{ code: 'FORBIDDEN', section: 'security', message_ar: 'رمز الحماية CSRF مفقود أو غير صالح', request_id: req_id }]);
			return;
		}
		if (sess.role != 'admin') {
			send_json_env(cli, 403, 'auth', {}, [{ code: 'FORBIDDEN', section: 'security', message_ar: 'هذه العملية متاحة لصلاحية المدير فقط', request_id: req_id }]);
			return;
		}
		if (action == 'auth_set_readonly') {
			call_helper('auth_set_readonly', { username: body.username || 'viewer', password: body.password || '' }, sess.username, remote_ip, function(res) {
				send_json_env(cli, res.ok ? 200 : (res.status || 400), 'auth', res, res.ok ? [] : [{ code: res.error_code || 'VALIDATION', section: 'auth', message_ar: res.message_ar, request_id: req_id }]);
			});
			return;
		}
	}

	if (action == 'stream' && method == 'GET') {
		let cur_u_cnt = sse_streams[sess.username] || 0;
		if (cur_u_cnt >= MAX_SSE_PER_USER || sse_global >= MAX_SSE_GLOBAL) {
			send_json_env(cli, 429, 'overview', {}, [{ code: 'TIMEOUT', section: 'stream', message_ar: 'تم تجاوز الحد الأقصى لاتصالات البث الحي المتزامنة لهذا المستخدم', request_id: req_id }], { 'Retry-After': '5' });
			return;
		}
		sse_streams[sess.username] = cur_u_cnt + 1;
		sse_global++;
		let hdr = "HTTP/1.1 200 OK\r\nContent-Type: text/event-stream; charset=utf-8\r\nCache-Control: no-cache, no-transform\r\nConnection: close\r\nX-Content-Type-Options: nosniff\r\nReferrer-Policy: no-referrer\r\nContent-Security-Policy: default-src 'self'\r\n\r\n";
		try {
			cli.send(hdr);
		} catch (e) {
			sse_streams[sess.username]--;
			sse_global--;
			try { cli.close(); } catch (e2) {}
			return;
		}
		let sse_closed = false;
		let sse_push_t = null;
		let sse_max_t = null;
		let sse_rh = null;
		let close_sse = null;
		let push_frame = null;
		close_sse = function() {
			if (sse_closed) return;
			sse_closed = true;
			sse_streams[sess.username] = (sse_streams[sess.username] || 1) - 1;
			if (sse_streams[sess.username] <= 0) delete sse_streams[sess.username];
			sse_global--;
			if (sse_push_t) try { sse_push_t.cancel(); } catch (e) {}
			if (sse_max_t) try { sse_max_t.cancel(); } catch (e) {}
			if (sse_rh) try { sse_rh.delete(); } catch (e) {}
			try { cli.close(); } catch (e) {}
		};
		push_frame = function() {
			if (sse_closed) return;
			let c = cache_map['overview'];
			let now_m = now_mono_ms();
			let data = (c && (now_m - c.ts) < 450) ? c.data : collect_overview_sync();
			if (!c || (now_m - c.ts) >= 450) cache_map['overview'] = { ts: now_m, data: data };
			let payload = sprintf("event: overview\nid: %d\ndata: %J\n\n", seq_map['overview'] || 0, envelope('overview', data, []));
			try {
				let w = cli.send(payload);
				if (!w || w <= 0) { close_sse(); return; }
			} catch (e) {
				close_sse();
				return;
			}
			sse_push_t = uloop.timer(1000, push_frame);
		};
		sse_max_t = uloop.timer(MAX_SSE_DURATION_MS, function() {
			try { cli.send("event: expire\ndata: {\"reason\":\"max_duration\"}\n\n"); } catch (e) {}
			close_sse();
		});
		sse_rh = uloop.handle(cli, function(ev) {
			let d = null;
			try { d = cli.recv(64); } catch (e) {}
			if (!d || length(d) == 0) close_sse();
		}, uloop.ULOOP_READ);
		push_frame();
		return;
	}

	if (action == 'logs' || action == 'audit') {
		if (sess.role != 'admin') {
			send_json_env(cli, 403, 'diagnostics', {}, [{ code: 'FORBIDDEN', section: 'logs', message_ar: 'عرض السجلات متاح لصلاحية المدير فقط', request_id: req_id }]);
			return;
		}
		let since_seq = +(query.since_seq || 0);
		let now_m = now_mono_ms();
		if (log_cache && (now_m - last_log_fetch_ms) < 4000) {
			let delta = [];
			for (let e in log_ring) if (e.seq > since_seq) push(delta, e);
			send_json_env(cli, 200, 'diagnostics', {
				ok: true,
				since_seq: since_seq,
				next_seq: log_ring_seq,
				entries: delta,
				syslog: log_cache.syslog,
				dmesg: log_cache.dmesg,
				audit_tail: log_cache.audit_tail,
				audit_entries: log_cache.audit_entries
			}, []);
			return;
		}
		call_helper('log_read', {}, sess.username, remote_ip, function(res) {
			last_log_fetch_ms = now_mono_ms();
			if (res && res.ok) {
				log_cache = res;
				for (let line in split(trim(res.syslog || ''), '\n')) {
					if (trim(line) == '') continue;
					let dup = false;
					for (let k = length(log_ring) - 1; k >= 0 && k >= length(log_ring) - 20; k--) {
						if (log_ring[k].line == line) { dup = true; break; }
					}
					if (!dup) {
						log_ring_seq++;
						push(log_ring, { seq: log_ring_seq, line: line });
						if (length(log_ring) > 300) log_ring = slice(log_ring, 1);
					}
				}
			}
			let delta = [];
			for (let e in log_ring) if (e.seq > since_seq) push(delta, e);
			send_json_env(cli, (res && res.ok) ? 200 : 503, 'diagnostics', {
				ok: !!(res && res.ok),
				since_seq: since_seq,
				next_seq: log_ring_seq,
				entries: delta,
				syslog: res ? res.syslog : '',
				dmesg: res ? res.dmesg : '',
				audit_tail: res ? res.audit_tail : '',
				audit_entries: (res && res.audit_entries) ? res.audit_entries : []
			}, (res && res.ok) ? [] : [{ code: 'DEPENDENCY', section: 'logs', message_ar: 'تعذر قراءة السجلات', request_id: req_id }]);
		});
		return;
	}

	// 3. Telemetry Endpoints (Single-flight coalesced cache in noc-apid memory)
	if (action == 'overview') {
		api_req_count++;
		let c = cache_map['overview'];
		let now_m = now_mono_ms();
		if (c && (now_m - c.ts) < 450) {
			c.data.platform_health = get_platform_health();
			send_json_env(cli, 200, 'overview', c.data, []);
			return;
		}
		let data = collect_overview_sync();
		data.platform_health = get_platform_health();
		cache_map['overview'] = { ts: now_m, data: data };
		send_json_env(cli, 200, 'overview', data, []);
		return;
	}

	if (action == 'alerts') {
		call_helper('alerts_get', {}, sess.username, remote_ip, function(res) {
			send_json_env(cli, res.ok ? 200 : 400, 'services', res, res.ok ? [] : [{ code: res.error_code || 'INTERNAL', section: 'services', message_ar: res.message_ar, request_id: req_id }]);
		});
		return;
	}

	if (action == 'weekly_report') {
		cached_helper_call('weekly_report', 15000, 'overview', 'weekly_report_get', {}, sess.username, remote_ip, function(res, errs) {
			return res;
		}, cli);
		return;
	}

	if (action == 'security_audit') {
		call_helper('security_audit', {}, sess.username, remote_ip, function(res) {
			send_json_env(cli, res.ok ? 200 : 400, 'services', res, res.ok ? [] : [{ code: res.error_code || 'INTERNAL', section: 'services', message_ar: res.message_ar, request_id: req_id }]);
		});
		return;
	}

	if (action == 'totp_status') {
		call_helper('auth_totp_status', {}, sess.username, remote_ip, function(res) {
			send_json_env(cli, res.ok ? 200 : 400, 'auth', res, []);
		});
		return;
	}

	if (action == 'device_quotas') {
		call_helper('device_quotas_get', {}, sess.username, remote_ip, function(res) {
			send_json_env(cli, res.ok ? 200 : 400, 'clients', res, []);
		});
		return;
	}

	if (action == 'traffic_window') {
		let c = cache_map['overview'];
		let now_m = now_mono_ms();
		let ov = (c && (now_m - c.ts) < 450) ? c.data : collect_overview_sync();
		if (!c || (now_m - c.ts) >= 450) cache_map['overview'] = { ts: now_m, data: ov };
		let req_if = trim(query.iface || body.iface || (ov.wan && ov.wan.active_device) || 'wlan0');
		let req_sec = +(query.seconds != null ? query.seconds : (body.seconds != null ? body.seconds : 300));
		if (req_sec < 0) req_sec = 0;
		if (req_sec > 31622400) req_sec = 31622400;
		let win = compute_traffic_window(req_if, int(req_sec), ov.interfaces || {});
		send_json_env(cli, 200, 'overview', { ok: true, window: win }, []);
		return;
	}

	if (action == 'adguard') {
		cached_helper_call('adguard_' + sess.role, 2500, 'adguard', 'adguard_read', {}, sess.username, remote_ip, function(res, errs) {
			if (!res.ok) push(errs, { code: 'DEPENDENCY', section: 'adguard', message_ar: res.message_ar || 'فشل قراءة بيانات AdGuard', request_id: req_id });
			return shape_adguard_data(res, sess.role);
		}, cli);
		return;
	}

	if (action == 'clients') {
		cached_helper_call('clients', 4500, 'clients', 'clients_read', {}, sess.username, remote_ip, function(res, errs) {
			if (!res.ok) return { ok: false, clients: [] };
			let by_mac = {};
			let mac_to_ips = {};
			for (let line in split(res.leases_raw || '', '\n')) {
				let p = split(trim(line), /\s+/);
				if (length(p) < 4) continue;
				let mac = lc(p[1]), ip = p[2], hn = p[3] != '*' ? p[3] : '';
				if (!by_mac[mac]) {
					if (length(keys(by_mac)) >= 256) continue; // enforce 256 MAC cap
					by_mac[mac] = { mac: mac, ip: ip, ips: [], hostname: hn, online: false, arp_state: 'LEASED', blocked: false, overflow_ips: false };
				}
				if (index(by_mac[mac].ips, ip) < 0) {
					if (length(by_mac[mac].ips) < 8) push(by_mac[mac].ips, ip);
					else by_mac[mac].overflow_ips = true;
				}
			}
			for (let line in split(res.neigh4 || '', '\n')) {
				let m = match(trim(line), /^([0-9.]+)\s+lladdr\s+([0-9a-fA-F:]+)\s+(\S+)/);
				if (!m) continue;
				let ip = m[1], mac = lc(m[2]), st = m[3];
				if (!by_mac[mac]) {
					if (length(keys(by_mac)) >= 256) continue;
					by_mac[mac] = { mac: mac, ip: ip, ips: [], hostname: '', online: false, arp_state: st, blocked: false, overflow_ips: false };
				}
				if (index(by_mac[mac].ips, ip) < 0) {
					if (length(by_mac[mac].ips) < 8) push(by_mac[mac].ips, ip);
					else by_mac[mac].overflow_ips = true;
				}
				by_mac[mac].arp_state = st;
				if (st == 'REACHABLE' || st == 'DELAY' || st == 'STALE') by_mac[mac].online = true;
			}
			let list = [];
			let rules = res.rules || { blocked_macs: {}, blocked_ips: {}, nicknames: {}, rate_limits: {} };
			let st_leases = res.static_leases || {};
			for (let mac in keys(by_mac)) {
				let c = by_mac[mac];
				c.blocked = !!rules.blocked_macs[mac];
				c.nickname = rules.nicknames[mac] || '';
				c.static_lease = !!st_leases[mac];
				c.rate_limit_kbps = (rules.rate_limits && rules.rate_limits[c.ip]) ? +rules.rate_limits[c.ip] : 0;
				c.display_name = c.nickname || c.hostname || ('جهاز ' + (c.ip || mac));
				let nb = (res.nlbw_by_mac && res.nlbw_by_mac[mac]) || (res.nlbw_by_ip && res.nlbw_by_ip[c.ip]) || { rx_bytes: 0, tx_bytes: 0, conns: 0 };
				c.total_rx_bytes = +nb.rx_bytes || 0;
				c.total_tx_bytes = +nb.tx_bytes || 0;
				c.total_conns = +nb.conns || 0;
				if (sess.role == 'readonly') {
