// --- Hardened Manual HTTP/1.1 Server Loop ---
function handle_http_conn(cli, remote_ip) {
	active_conns++;
	let raw_buf = '';
	let closed = false;
	let ch = null;
	let headers_parsed = false;
	let req_method = '';
	let req_path = '';
	let req_headers = {};
	let content_len = 0;

	let close_conn = function() {
		if (closed) return;
		closed = true;
		active_conns--;
		if (ch) ch.delete();
		try { cli.close(); } catch (e) {}
	};

	let rtimer = uloop.timer(READ_TIMEOUT_MS, function() {
		close_conn();
	});

	ch = uloop.handle(cli, function(ev) {
		if (closed) return;
		let d = cli.recv(4096);
		if (!d || length(d) == 0) { rtimer.cancel(); close_conn(); return; }
		if (index(d, '\0') >= 0) {
			rtimer.cancel(); closed = true; active_conns--; ch.delete();
			send_http(cli, 400, 'Bad Request', 'text/plain', 'Null byte rejected');
			return;
		}
		raw_buf += d;

		if (!headers_parsed) {
			let hdr_end = index(raw_buf, '\r\n\r\n');
			if (hdr_end < 0) {
				if (length(raw_buf) > MAX_HEADER_BYTES) {
					rtimer.cancel(); closed = true; active_conns--; ch.delete();
					send_http(cli, 431, 'Request Header Fields Too Large', 'text/plain', 'Header too large');
				}
				return;
			}
			if (hdr_end > MAX_HEADER_BYTES) {
				rtimer.cancel(); closed = true; active_conns--; ch.delete();
				send_http(cli, 431, 'Request Header Fields Too Large', 'text/plain', 'Header too large');
				return;
			}
			let hdr_block = substr(raw_buf, 0, hdr_end);
			raw_buf = substr(raw_buf, hdr_end + 4);
			let lines = split(hdr_block, '\r\n');
			if (length(lines) == 0 || length(lines) > MAX_HEADER_COUNT + 1) {
				rtimer.cancel(); closed = true; active_conns--; ch.delete();
				send_http(cli, 400, 'Bad Request', 'text/plain', 'Invalid header count');
				return;
			}
			let rl = match(lines[0], /^(GET|POST|OPTIONS)\s+(\S+)\s+HTTP\/1\.[01]$/);
			if (!rl) {
				rtimer.cancel(); closed = true; active_conns--; ch.delete();
				send_http(cli, 400, 'Bad Request', 'text/plain', 'Bad request line');
				return;
			}
			req_method = rl[1];
			req_path = rl[2];
			let seen_cl = false;
			for (let i = 1; i < length(lines); i++) {
				let col = index(lines[i], ':');
				if (col <= 0) {
					rtimer.cancel(); closed = true; active_conns--; ch.delete();
					send_http(cli, 400, 'Bad Request', 'text/plain', 'Malformed header');
					return;
				}
				let hk = lc(trim(substr(lines[i], 0, col)));
				let hv = trim(substr(lines[i], col + 1));
				if (hk == 'transfer-encoding' && index(lc(hv), 'chunked') >= 0) {
					rtimer.cancel(); closed = true; active_conns--; ch.delete();
					send_http(cli, 400, 'Bad Request', 'text/plain', 'Chunked encoding rejected');
					return;
				}
				if (hk == 'content-length') {
					if (seen_cl || !match(hv, /^[0-9]+$/)) {
						rtimer.cancel(); closed = true; active_conns--; ch.delete();
						send_http(cli, 400, 'Bad Request', 'text/plain', 'Invalid Content-Length');
						return;
					}
					seen_cl = true;
					content_len = +hv;
					if (content_len > MAX_BODY_BYTES) {
						rtimer.cancel(); closed = true; active_conns--; ch.delete();
						send_http(cli, 413, 'Payload Too Large', 'text/plain', 'Payload too large');
						return;
					}
				}
				req_headers[hk] = hv;
			}
			headers_parsed = true;
		}

		if (length(raw_buf) > content_len) {
			rtimer.cancel(); closed = true; active_conns--; ch.delete();
			send_http(cli, 400, 'Bad Request', 'text/plain', 'Pipelining not allowed');
			return;
		}
		if (length(raw_buf) < content_len) return;

		rtimer.cancel();
		closed = true;
		active_conns--;
		ch.delete();

		if (req_method == 'OPTIONS') {
			send_http(cli, 204, 'No Content', 'text/plain', '');
			return;
		}
		if (index(req_path, '/api') == 0 || index(req_path, '/cgi-bin/pro-api') == 0) {
			handle_api_request(cli, req_method, req_path, req_headers, raw_buf, remote_ip);
		} else {
			serve_static(cli, req_path, req_headers);
		}
	}, uloop.ULOOP_READ);
}

