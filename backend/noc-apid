function start_http_server(attempt) {
	let lan_ip = (BIND_HOST != '') ? BIND_HOST : get_lan_ip();
	let sa = sock.sockaddr({ address: lan_ip, port: BIND_PORT });
	let s = sock.create(sock.AF_INET, sock.SOCK_STREAM);
	let bound = false;
	if (s) {
		try { s.setopt(sock.SOL_SOCKET, sock.SO_REUSEADDR, 1); } catch (e) {}
		if (sa && s.bind(sa) && s.listen(32)) {
			http_srv = s;
			bound = true;
		} else {
			try { s.close(); } catch (e) {}
		}
	}
	if (!bound) {
		if (attempt < 30) {
			bind_retry_timer = uloop.timer(1000, function() { start_http_server(attempt + 1); });
			return;
		}
		die('Failed to bind noc-apid on ' + lan_ip + ':' + BIND_PORT + ' after retries: ' + sock.error());
	}
	http_handle = uloop.handle(http_srv, function(ev) {
		let peer = {};
		let cli = http_srv.accept(peer);
		if (!cli) return;
		if (active_conns >= MAX_CONNECTIONS) {
			try { cli.send("HTTP/1.1 503 Service Unavailable\r\nContent-Length: 0\r\nConnection: close\r\n\r\n"); } catch (e) {}
			cli.close();
			return;
		}
		handle_http_conn(cli, peer.address || '');
	}, uloop.ULOOP_READ);
}

start_http_server(0);
uloop.run();
