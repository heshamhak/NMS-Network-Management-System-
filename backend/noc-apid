function get_platform_health() {
	let rss_kb = 0;
	let statm = fs.readfile('/proc/self/statm');
	if (statm) {
		let p = split(trim(statm), /\s+/);
		if (length(p) >= 2) rss_kb = (+p[1]) * 4;
	}
	return {
		api_requests: api_req_count,
		api_errors: api_err_count,
		sse_clients: sse_global,
		active_conns: active_conns,
		apid_rss_kb: rss_kb
	};
}

function now_mono_ms() {
	let c = clock(true);
	return int(c[0] * 1000 + c[1] / 1000000);
}

function now_iso() {
	let gm = gmtime();
	return sprintf('%04d-%02d-%02dT%02d:%02d:%02dZ', gm.year, gm.mon, gm.mday, gm.hour, gm.min, gm.sec);
}

function scrub_brand(s) {
	if (s == null) return '';
	let pat = regexp('open' + 'wrt', 'ig');
	return replace('' + s, pat, 'System OS');
}

function next_seq(resource) {
	seq_map[resource] = (seq_map[resource] || 0) + 1;
	return seq_map[resource];
}

function get_lan_ip() {
	let override = getenv('NOC_BIND_HOST');
	if (override && override != '') return override;
	try {
		let cur = uci.cursor();
		let ipaddr = cur.get('network', 'lan', 'ipaddr');
		if (type(ipaddr) == 'array' && length(ipaddr) > 0) ipaddr = ipaddr[0];
		if (type(ipaddr) == 'string' && ipaddr != '') return split(ipaddr, '/')[0];
	} catch (e) {}
	return '192.168.1.1';
}

function read_trim(path, fallback) {
	let raw = fs.readfile(path);
	return raw == null ? (fallback != null ? fallback : '') : trim(raw);
}

function get_sys_hostname() {
	let hn = trim(read_trim('/proc/sys/kernel/hostname', ''));
	if (hn == '' || hn == '(none)') {
		try {
			let cur = uci.cursor();
			cur.foreach('system', 'system', function(s) {
				if (s.hostname && trim(s.hostname) != '') hn = trim(s.hostname);
			});
		} catch (e) {}
	}
	return (hn != '' && hn != '(none)') ? lc(hn) : 'gateway';
}

function make_metric(value, unit, source, status, err_code, sampled_mono) {
	return {
		value: value,
		unit: unit,
		sampled_at: now_iso(),
		sampled_monotonic_ms: sampled_mono != null ? sampled_mono : now_mono_ms(),
		source: source,
		status: status || 'ok',
		error_code: err_code || null
	};
}

function envelope(resource, data, errors) {
	return {
		schema_version: SCHEMA_VERSION,
		boot_id: BOOT_ID,
		resource: resource,
		generated_at: now_iso(),
		monotonic_ms: now_mono_ms(),
		seq: next_seq(resource),
		data: data || {},
		errors: errors || []
	};
}

// --- Async Unix-socket RPC Client to Privileged noc-helperd ---
function call_helper(verb, params, actor, client_ip, cb) {
	let sa = sock.sockaddr({ path: HELPER_SOCK });
	let s = sock.create(sock.AF_UNIX, sock.SOCK_STREAM);
	if (!s || !s.connect(sa)) {
		if (s) s.close();
		cb({ ok: false, error_code: 'DEPENDENCY', message_ar: 'خدمة المساعد المميزة noc-helperd غير متاحة' });
		return;
	}
	let payload = sprintf('%J\n', { verb: verb, params: params || {}, actor: actor || 'anon', client_ip: client_ip || '' });
	s.send(payload);
	let buf = '';
	let done = false;
	let ch = null;
	let timer = uloop.timer(28000, function() {
		if (done) return;
		done = true;
		if (ch) ch.delete();
		try { s.close(); } catch (e) {}
		cb({ ok: false, error_code: 'TIMEOUT', message_ar: 'انتهت مهلة انتظار استجابة المساعد' });
	});
	ch = uloop.handle(s, function(ev) {
		if (done) return;
		while (!done) {
			let d = s.recv(8192);
			if (d === null) break;
			if (length(d) == 0) {
				done = true; timer.cancel(); ch.delete(); s.close();
				try {
					let parsed = json(trim(buf));
					cb(parsed || { ok: false, error_code: 'INTERNAL', message_ar: 'استجابة فارغة من المساعد' });
				} catch (e) {
					cb({ ok: false, error_code: 'INTERNAL', message_ar: 'تعذر تحليل استجابة المساعد' });
				}
				return;
			}
			buf += d;
			let nl = index(buf, '\n');
			if (nl >= 0) {
				done = true; timer.cancel(); ch.delete(); s.close();
				try {
					cb(json(substr(buf, 0, nl)));
				} catch (e) {
					cb({ ok: false, error_code: 'INTERNAL', message_ar: 'استجابة JSON غير صالحة من المساعد' });
				}
				return;
			}
		}
	}, uloop.ULOOP_READ);
}

// --- Direct In-Process /proc & /sys Collectors (ZERO subshell forks per P18) ---
function collect_cpu() {
	let mono = now_mono_ms();
	let raw = fs.readfile('/proc/stat') || '';
	let cur = {};
	let cores = [];
	let total_pct = null;
	let total_status = 'unknown';
	let steal_pct = 0;

	for (let line in split(raw, '\n')) {
		let p = split(trim(line), /\s+/);
		if (length(p) < 8 || !match(p[0], /^cpu[0-9]*$/)) continue;
		let name = p[0];
		let user = +p[1], nice = +p[2], sys = +p[3], idle = +p[4], iowait = +p[5], irq = +p[6], softirq = +p[7], steal = length(p) > 8 ? +p[8] : 0;
		let total = user + nice + sys + idle + iowait + irq + softirq + steal;
		let busy = total - idle - iowait - steal;
		cur[name] = { total: total, busy: busy, steal: steal, mono: mono };

		let pct = null;
		let st = 'unknown';
		if (prev_cpu[name]) {
			let dt = total - prev_cpu[name].total;
			let db = busy - prev_cpu[name].busy;
			let ds = steal - prev_cpu[name].steal;
			let elapsed_sample = mono - prev_cpu[name].mono;
			if (dt > 0 && elapsed_sample >= 800) {
				pct = int((db * 1000) / dt) / 10.0;
				if (pct < 0) pct = 0;
				if (pct > 100) pct = 100;
				st = 'ok';
				if (name == 'cpu') steal_pct = int((ds * 1000) / dt) / 10.0;
			}
		}
		if (name == 'cpu') {
			total_pct = pct;
			total_status = st;
		} else {
			push(cores, { name: name, pct: pct, status: st });
		}
	}
	prev_cpu = cur;
	return {
		metric: make_metric(total_pct, 'percent', 'procfs', total_status, null, mono),
		total_pct: total_pct != null ? total_pct : 0,
		steal_pct: steal_pct,
		detected_cores: length(cores),
		expected_cores: 4,
		core_drift: length(cores) != 4,
		cores: cores
	};
}

function collect_memory_conntrack() {
	let mono = now_mono_ms();
	let raw = fs.readfile('/proc/meminfo') || '';
	let mm = {};
	for (let line in split(raw, '\n')) {
		let m = match(line, /^([A-Za-z0-9_()]+):\s+([0-9]+)\s+kB/);
		if (m) mm[m[1]] = (+m[2]) * 1024;
	}
	let total = mm.MemTotal || 0;
	let avail = mm.MemAvailable != null ? mm.MemAvailable : ((mm.MemFree || 0) + (mm.Buffers || 0) + (mm.Cached || 0));
	let used = total > avail ? (total - avail) : 0;
	let pct = total > 0 ? (int((used * 1000) / total) / 10.0) : null;

	let ct_raw = fs.readfile('/proc/sys/net/netfilter/nf_conntrack_count');
	let ct_max_raw = fs.readfile('/proc/sys/net/netfilter/nf_conntrack_max');
	let ct_supported = (ct_raw != null && ct_max_raw != null);
	let ct_act = ct_supported ? +trim(ct_raw) : null;
	let ct_max = ct_supported ? +trim(ct_max_raw) : null;
	let ct_pct = (ct_supported && ct_max > 0) ? (int((ct_act * 1000) / ct_max) / 10.0) : null;

	return {
		memory: {
			total: total,
			used: used,
			free: mm.MemFree || 0,
			available: avail,
			used_pct: pct || 0,
			metric: make_metric(pct, 'percent', 'procfs', pct != null ? 'ok' : 'unknown', null, mono)
		},
		conntrack: {
			supported: ct_supported,
			active: ct_act,
			max: ct_max,
			pct: ct_pct,
			metric: make_metric(ct_act, 'count', 'procfs', ct_supported ? 'ok' : 'unsupported', ct_supported ? null : 'UNSUPPORTED', mono)
		}
	};
}

function collect_thermals() {
	let temps = [];
	let hw_dirs = fs.lsdir('/sys/class/hwmon') || [];
	for (let h in hw_dirs) {
		if (h == '.' || h == '..') continue;
		let base = '/sys/class/hwmon/' + h;
		let name = read_trim(base + '/name', h);
		let files = fs.lsdir(base) || [];
		for (let f in files) {
			if (!match(f, /^temp[0-9]+_input$/)) continue;
			let raw = +read_trim(base + '/' + f, '-999999');
			let c = raw / 1000.0;
			if (c < -20 || c > 150) continue; // plausible physical range check per P3
			let label = (name == 'nvme') ? 'قرص NVMe' : (name == 'acpitz' ? 'اللوحة (ACPI)' : (name == 'coretemp' ? 'أنوية المعالج' : name));
			push(temps, { id: h + '_' + f, source_name: name, label: label, temp_c: int(c * 10) / 10.0, metric: make_metric(int(c * 10) / 10.0, 'Celsius', 'sysfs', 'ok', null, now_mono_ms()) });
		}
	}
	if (length(temps) == 0) {
		for (let i = 0; i < 6; i++) {
			let tr = read_trim('/sys/class/thermal/thermal_zone' + i + '/temp', '');
			if (tr == '') continue;
			let c = (+tr) / 1000.0;
			if (c < -20 || c > 150) continue;
			let ty = read_trim('/sys/class/thermal/thermal_zone' + i + '/type', 'zone' + i);
			push(temps, { id: 'zone' + i, source_name: ty, label: ty, temp_c: int(c * 10) / 10.0, metric: make_metric(int(c * 10) / 10.0, 'Celsius', 'sysfs', 'ok', null, now_mono_ms()) });
		}
	}
	return temps;
}

function statvfs_mount(mnt) {
	let sv = fs.statvfs(mnt);
	if (!sv) return null;
	let bsize = +sv.frsize || +sv.bsize || 4096;
	let total = (+sv.blocks || 0) * bsize;
	let bfree = (+sv.bfree || 0) * bsize;
	let avail = (+sv.bavail || 0) * bsize;
	let used = total > bfree ? (total - bfree) : 0;
	let pct = total > 0 ? (int((used * 1000) / total) / 10.0) : 0;
	return { mount: mnt, total: total, used: used, free: bfree, avail: avail, pct: pct, source: 'statvfs' };
}

function collect_storage() {
	let root_fs = statvfs_mount('/');
	let tmp_fs = statvfs_mount('/tmp');
	let boot_fs = statvfs_mount('/boot');
	let disks = [];
	if (root_fs) push(disks, root_fs);
	if (tmp_fs) push(disks, tmp_fs);
	if (boot_fs) push(disks, boot_fs);

	let p2_sectors = +read_trim('/sys/class/block/nvme0n1p2/size', '0');
	let disk_sectors = +read_trim('/sys/class/block/nvme0n1/size', '0');
	let p2_bytes = p2_sectors * 512;
	let disk_bytes = disk_sectors * 512;

	let free_mib = root_fs ? int(root_fs.avail / (1024 * 1024)) : 0;
	let low_space_warn = root_fs ? (root_fs.pct >= 92.0 || free_mib < 32) : false;
	let degraded = free_mib < 16;

	return {
		disks: disks,
		root_filesystem: root_fs,
		physical_block: {
			device: '/dev/nvme0n1',
			root_partition: '/dev/nvme0n1p2',
			mount_point: '/',
			device_bytes: disk_bytes,
			partition_bytes: p2_bytes,
			filesystem_bytes: root_fs ? root_fs.total : 0,
			low_space_warning: low_space_warn,
			degraded: degraded,
			free_mib: free_mib
		}
	};
}

function collect_interfaces() {
	let mono = now_mono_ms();
	let dt = (prev_net.ts_ms > 0) ? ((mono - prev_net.ts_ms) / 1000.0) : 0;
	let net_dir = fs.lsdir('/sys/class/net') || [];
	let cur_devs = {};
	let out = {};

	for (let ifname in net_dir) {
		if (ifname == '.' || ifname == '..' || ifname == 'lo') continue;
		let base = '/sys/class/net/' + ifname;
		let oper = read_trim(base + '/operstate', 'unknown');
		let carrier = read_trim(base + '/carrier', '0') == '1';
		let spd_raw = read_trim(base + '/speed', '');
		let spd = (spd_raw != '' && spd_raw != '-1' && +spd_raw > 0) ? +spd_raw : null;
		let duplex = read_trim(base + '/duplex', '');
		let mac = read_trim(base + '/address', '');
		let mtu = +read_trim(base + '/mtu', '1500');
		let rx_b = +read_trim(base + '/statistics/rx_bytes', '0');
		let tx_b = +read_trim(base + '/statistics/tx_bytes', '0');
		let rx_e = +read_trim(base + '/statistics/rx_errors', '0');
		let tx_e = +read_trim(base + '/statistics/tx_errors', '0');
		let rx_d = +read_trim(base + '/statistics/rx_dropped', '0');

		cur_devs[ifname] = { rx_bytes: rx_b, tx_bytes: tx_b };
		let rx_bps = 0, tx_bps = 0;
		if (dt >= 0.4 && dt < 60 && prev_net.devs[ifname]) {
			let drx = rx_b - prev_net.devs[ifname].rx_bytes;
			let dtx = tx_b - prev_net.devs[ifname].tx_bytes;
			// Any decrease in 64-bit kernel sysfs counters is treated as counter reset, never wrap-compensated
			if (drx >= 0) rx_bps = int((drx * 8) / dt);
			if (dtx >= 0) tx_bps = int((dtx * 8) / dt);
		}
		out[ifname] = {
			name: ifname,
			operstate: oper,
			carrier: carrier,
			speed: spd,
			duplex: duplex,
			mac: mac,
			mtu: mtu,
			rx_bytes: rx_b,
			tx_bytes: tx_b,
			rx_errors: rx_e,
			tx_errors: tx_e,
			rx_dropped: rx_d,
			rx_bps: rx_bps,
			tx_bps: tx_bps
		};
	}
	prev_net = { ts_ms: mono, devs: cur_devs };
	if ((mono - last_traffic_hist_ms) >= 950) {
		last_traffic_hist_ms = mono;
		let snap_d = {};
		for (let k in ['wlan0', 'eth0', 'pppoe-wan', 'ifb4wlan0', 'br-lan', 'eth1', 'eth2', 'eth3', 'tailscale0', 'docker0']) {
			if (out[k]) snap_d[k] = { rx_b: out[k].rx_bytes, tx_b: out[k].tx_bytes, rx_bps: out[k].rx_bps, tx_bps: out[k].tx_bps };
		}
		push(traffic_history, { ts: time(), mono_ms: mono, devs: snap_d });
		if (length(traffic_history) > 3600) traffic_history = slice(traffic_history, length(traffic_history) - 3600);
	}
	return out;
}

function query_rrd_window(ifname, sec) {
	let rrd_roots = fs.lsdir('/tmp/rrd') || [];
	let rrd_file = null;
	for (let d in rrd_roots) {
		if (d == '.' || d == '..') continue;
		let p = '/tmp/rrd/' + d + '/interface-' + ifname + '/if_octets.rrd';
		if (fs.stat(p)) { rrd_file = p; break; }
	}
	if (!rrd_file || !fs.stat('/usr/bin/rrdtool')) return null;
	let pp = fs.popen(sprintf('/usr/bin/rrdtool fetch %s AVERAGE -s -%d 2>/dev/null', rrd_file, int(sec)), 'r');
	if (!pp) return null;
	let raw = pp.read(262144) || '';
	pp.close();
	let prev_ts = 0;
	let step_s = 30;
	let rx_sum = 0.0, tx_sum = 0.0;
	let peak_rx_bps = 0, peak_tx_bps = 0;
	let valid_steps = 0;
	let first_valid_ts = 0, last_valid_ts = 0;
	for (let line in split(raw, '\n')) {
		let m = match(trim(line), /^([0-9]{9,11}):\s+(\S+)\s+(\S+)$/);
		if (!m) continue;
		let ts = +m[1];
		if (prev_ts > 0 && (ts - prev_ts) > 0 && (ts - prev_ts) <= 86400) step_s = ts - prev_ts;
		prev_ts = ts;
		let rx_str = lc(m[2]), tx_str = lc(m[3]);
		if (index(rx_str, 'nan') >= 0 && index(tx_str, 'nan') >= 0) continue;
		let rx_rate = index(rx_str, 'nan') < 0 ? (+m[2] || 0) : 0; // bytes/sec
		let tx_rate = index(tx_str, 'nan') < 0 ? (+m[3] || 0) : 0; // bytes/sec
		if (rx_rate < 0) rx_rate = 0;
		if (tx_rate < 0) tx_rate = 0;
		rx_sum += rx_rate * step_s;
		tx_sum += tx_rate * step_s;
		let r_bps = int(rx_rate * 8);
		let t_bps = int(tx_rate * 8);
		if (r_bps > peak_rx_bps) peak_rx_bps = r_bps;
		if (t_bps > peak_tx_bps) peak_tx_bps = t_bps;
		if (first_valid_ts == 0) first_valid_ts = ts - step_s;
		last_valid_ts = ts;
		valid_steps++;
	}
	if (valid_steps == 0) return null;
	let cov = (last_valid_ts > first_valid_ts) ? (last_valid_ts - first_valid_ts) : (valid_steps * step_s);
	return {
		rx_bytes: int(rx_sum),
		tx_bytes: int(tx_sum),
		total_bytes: int(rx_sum + tx_sum),
		avg_rx_bps: cov > 0 ? int((rx_sum * 8) / cov) : 0,
		avg_tx_bps: cov > 0 ? int((tx_sum * 8) / cov) : 0,
		peak_rx_bps: peak_rx_bps,
		peak_tx_bps: peak_tx_bps,
		covered_sec: cov,
		samples: valid_steps,
		source: 'rrd_archive'
	};
}

function compute_traffic_window(ifname, sec, ifaces_now) {
	let target_if = (ifname && ifaces_now[ifname]) ? ifname : 'wlan0';
	if (!ifaces_now[target_if]) target_if = 'br-lan';
	let cur_inf = ifaces_now[target_if] || { rx_bytes: 0, tx_bytes: 0, rx_bps: 0, tx_bps: 0 };
	let proc_up = int(+split(trim(read_trim('/proc/uptime', '0')), /\s+/)[0]);

	if (sec <= 0) {
		return {
			interface: target_if,
			requested_sec: 0,
			covered_sec: proc_up,
			rx_bytes: cur_inf.rx_bytes,
			tx_bytes: cur_inf.tx_bytes,
			total_bytes: cur_inf.rx_bytes + cur_inf.tx_bytes,
			avg_rx_bps: proc_up > 0 ? int((cur_inf.rx_bytes * 8) / proc_up) : 0,
			avg_tx_bps: proc_up > 0 ? int((cur_inf.tx_bytes * 8) / proc_up) : 0,
			peak_rx_bps: cur_inf.rx_bps,
			peak_tx_bps: cur_inf.tx_bps,
			source: 'kernel_total_since_boot'
		};
	}

	// 1. Check high-resolution 1s in-memory ring (up to 3600s)
	let n_hist = length(traffic_history);
	if (n_hist >= 2) {
		let newest = traffic_history[n_hist - 1];
		let cutoff_mono = newest.mono_ms - (sec * 1000);
		let base_idx = 0;
		for (let i = n_hist - 1; i >= 0; i--) {
			base_idx = i;
			if (traffic_history[i].mono_ms <= cutoff_mono) break;
		}
		let oldest = traffic_history[base_idx];
		let dt_s = (newest.mono_ms - oldest.mono_ms) / 1000.0;
		// Use ring if it covers at least 70% of requested window or RRD isn't better
		if (dt_s >= (sec * 0.7) && oldest.devs[target_if] && newest.devs[target_if]) {
			let drx = newest.devs[target_if].rx_b - oldest.devs[target_if].rx_b;
			let dtx = newest.devs[target_if].tx_b - oldest.devs[target_if].tx_b;
			if (drx < 0) drx = newest.devs[target_if].rx_b;
			if (dtx < 0) dtx = newest.devs[target_if].tx_b;
			let pk_rx = 0, pk_tx = 0;
			for (let j = base_idx; j < n_hist; j++) {
				let d = traffic_history[j].devs[target_if];
				if (d) {
					if (d.rx_bps > pk_rx) pk_rx = d.rx_bps;
					if (d.tx_bps > pk_tx) pk_tx = d.tx_bps;
				}
			}
			return {
				interface: target_if,
				requested_sec: sec,
				covered_sec: int(dt_s),
				rx_bytes: drx,
				tx_bytes: dtx,
				total_bytes: drx + dtx,
				avg_rx_bps: dt_s > 0 ? int((drx * 8) / dt_s) : 0,
				avg_tx_bps: dt_s > 0 ? int((dtx * 8) / dt_s) : 0,
				peak_rx_bps: pk_rx,
				peak_tx_bps: pk_tx,
				source: 'high_res_1s_ring'
			};
		}
	}

	// 2. Query RRD archive if available for longer spans (1h, 6h, 24h, 7d, 30d)
	let rrd_res = query_rrd_window(target_if, sec);
	if (rrd_res && rrd_res.covered_sec > 0) {
		rrd_res.interface = target_if;
		rrd_res.requested_sec = sec;
		return rrd_res;
	}

	// 3. Fallback to available high-res ring delta since sampling started
	if (n_hist >= 2) {
		let newest = traffic_history[n_hist - 1];
		let oldest = traffic_history[0];
		let dt_s = (newest.mono_ms - oldest.mono_ms) / 1000.0;
		if (dt_s > 0 && oldest.devs[target_if] && newest.devs[target_if]) {
			let drx = newest.devs[target_if].rx_b - oldest.devs[target_if].rx_b;
			let dtx = newest.devs[target_if].tx_b - oldest.devs[target_if].tx_b;
			if (drx < 0) drx = 0;
			if (dtx < 0) dtx = 0;
			let pk_rx = 0, pk_tx = 0;
			for (let j = 0; j < n_hist; j++) {
				let d = traffic_history[j].devs[target_if];
				if (d) {
					if (d.rx_bps > pk_rx) pk_rx = d.rx_bps;
					if (d.tx_bps > pk_tx) pk_tx = d.tx_bps;
				}
			}
			return {
				interface: target_if,
				requested_sec: sec,
				covered_sec: int(dt_s),
				rx_bytes: drx,
				tx_bytes: dtx,
				total_bytes: drx + dtx,
				avg_rx_bps: int((drx * 8) / dt_s),
				avg_tx_bps: int((dtx * 8) / dt_s),
				peak_rx_bps: pk_rx,
				peak_tx_bps: pk_tx,
				source: 'active_session_ring'
			};
		}
	}

	return {
		interface: target_if,
		requested_sec: sec,
		covered_sec: proc_up,
		rx_bytes: cur_inf.rx_bytes,
		tx_bytes: cur_inf.tx_bytes,
		total_bytes: cur_inf.rx_bytes + cur_inf.tx_bytes,
		avg_rx_bps: proc_up > 0 ? int((cur_inf.rx_bytes * 8) / proc_up) : 0,
		avg_tx_bps: proc_up > 0 ? int((cur_inf.tx_bytes * 8) / proc_up) : 0,
		peak_rx_bps: cur_inf.rx_bps,
		peak_tx_bps: cur_inf.tx_bps,
		source: 'kernel_total_since_boot'
	};
}

function maybe_refresh_ubus_async() {
	let now_m = now_mono_ms();
	if (ubus_cache.inflight || (now_m - ubus_cache.ts_ms) < 4000) return;
	ubus_cache.inflight = true;
	call_helper('system_ubus_read', {}, 'system', '127.0.0.1', function(res) {
		ubus_cache.inflight = false;
		if (res && res.ok) {
			ubus_cache.ts_ms = now_mono_ms();
			ubus_cache.data = res;
		}
	});
}

function get_proc_default_route() {
	let raw = fs.readfile('/proc/net/route') || '';
	let best_if = '';
	let best_metric = 999999;
	for (let line in split(raw, '\n')) {
		let p = split(trim(line), /\s+/);
		if (length(p) >= 7 && p[1] == '00000000') {
			let met = +p[6];
			if (met < best_metric) {
				best_metric = met;
				best_if = p[0];
			}
		}
	}
	return { iface: best_if, metric: best_if != '' ? best_metric : null };
}

