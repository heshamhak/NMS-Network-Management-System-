function urandom_hex(nbytes) {
	let f = fs.open('/dev/urandom', 'r');
	if (!f) return sprintf('%08x%08x', time(), clock(true)[1]);
	let raw = f.read(nbytes);
	f.close();
	return hexenc(raw || '');
}

const BOOT_ID = urandom_hex(16);
try {
	if (!fs.stat(RUN_DIR)) fs.mkdir(RUN_DIR, 0o755);
	fs.writefile(RUN_DIR + '/boot_id', BOOT_ID + '\n');
} catch (e) {}

let seq_map = {};
let sessions = {};
let sse_streams = {};
let sse_global = 0;
let log_ring = [];
let log_ring_seq = 0;
let last_log_fetch_ms = 0;
