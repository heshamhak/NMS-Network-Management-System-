			});
			return;
		}
		if (sub == 'set_flags') {
			let acc_r = !!params.accept_routes;
			let acc_d = !!params.accept_dns;
			let sh = !!params.shields_up;
			let adv = trim(params.advertise_routes || '');
			if (adv != '' && !match(adv, /^(10\.[0-9]{1,3}|172\.(1[6-9]|2[0-9]|3[0-1])|192\.168)\.[0-9]{1,3}\.0\/(16|24)$/)) {
				release_lock();
				reply_cb({ ok: false, error_code: 'VALIDATION', message_ar: 'نطاق الإعلان المسموح يجب أن يكون شبكة محلية خاصة بصيغة CIDR مثل 192.168.1.0/24 أو فارغاً' });
				return;
			}
			if (sh && is_tailscale_ip(client_ip)) {
				release_lock();
				audit_append(actor, 'tailscale_set_flags', client_ip, 'refused', 'Refused shields-up from Tailscale caller');
				reply_cb({ ok: false, error_code: 'FORBIDDEN', message_ar: 'مرفوض: لا يُسمح بتفعيل Shields Up أثناء الاتصال عبر شبكة VPN نفسها' });
				return;
			}
			let argv = [
				'set',
				'--accept-routes=' + (acc_r ? 'true' : 'false'),
				'--accept-dns=' + (acc_d ? 'true' : 'false'),
				'--shields-up=' + (sh ? 'true' : 'false'),
				'--advertise-routes=' + adv
			];
			exec_argv_async('/usr/sbin/tailscale', argv, 10000, CAP_GENERAL, function(r) {
