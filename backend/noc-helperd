		let mgr = detect_pkg_manager();
		if (mgr.manager == 'none') {
			reply_cb({ ok: false, error_code: 'UNSUPPORTED', pkg_manager: 'none', total_count: 0, filtered_count: 0, packages: [], message_ar: 'لم يتم العثور على مدير حزم مدعوم (apk أو opkg)' });
			return;
		}
		let list_argv = mgr.manager == 'apk' ? ['info', '-v'] : ['list-installed'];
