function rollback_client_rules(rules_path, snap_raw, prev_rules, reason_prefix, actor, verb, target_id, cb) {
	let rb_aw = atomic_write(rules_path, snap_raw, 0o600);
	let st_r = fs.lstat(rules_path);
	let cur_r = fs.readfile(rules_path);
	let file_ok = rb_aw.ok && st_r && st_r.type == 'file' && (st_r.mode & 0o7777) == 0o600 && cur_r == snap_raw;
	apply_bridge_block_rules(prev_rules, function(rb) {
		let all_ok = file_ok && rb.ok;
		let fr = null;
		if (!all_ok) {
			fr = enter_emergency_freeze(reason_prefix + ' rollback failed');
			audit_append(actor, verb, target_id, 'rollback_failed', sprintf('file_ok=%s apply_ok=%s err=%s freeze_persisted=%s', file_ok ? '1' : '0', rb.ok ? '1' : '0', rb_aw.error || '', fr.freeze_persisted ? '1' : '0'));
		} else {
			audit_append(actor, verb, target_id, 'rolled_back', 'Persisted client rules file and applied firewall state verified');
		}
		cb({
			all_ok: all_ok,
			file_ok: file_ok,
			apply_ok: !!rb.ok,
			rb_aw: rb_aw,
			freeze_persisted: fr ? fr.freeze_persisted : false,
			freeze_persist_failed: fr ? fr.freeze_persist_failed : false
		});
	});
}

	if (verb == 'client_block' || verb == 'client_unblock') {
		let mac = lc(trim(params.mac || ''));
		let ip = trim(params.ip || '');
		if (!is_valid_mac(mac)) {
			release_lock();
			reply_cb({ ok: false, error_code: 'VALIDATION', message_ar: 'عنوان MAC غير صالح' });
			return;
		}
		// P5 Self-lockout preconditions
		let gw_macs = get_gateway_macs();
		let gw_ips = get_gateway_ips();
		if (gw_macs[mac] || (ip != '' && (gw_ips[ip] || ip == client_ip))) {
			release_lock();
			audit_append(actor, verb, mac, 'refused', 'Self-block or gateway protection triggered');
			reply_cb({ ok: false, error_code: 'FORBIDDEN', message_ar: 'مرفوض: لا يمكن حظر البوابة الرئيسية أو الجهاز المدير المتصل حالياً' });
			return;
		}
		let rules_path = ETC_DIR + '/client_rules.json';
		let prev_rules = read_json(rules_path, { blocked_macs: {}, blocked_ips: {}, nicknames: {} });
		let snap_raw = sprintf('%J\n', prev_rules);
		let next_rules = read_json(rules_path, { blocked_macs: {}, blocked_ips: {}, nicknames: {} });
		if (verb == 'client_block') {
			next_rules.blocked_macs[mac] = true;
			if (is_valid_ipv4(ip)) next_rules.blocked_ips[ip] = true;
		} else {
			delete next_rules.blocked_macs[mac];
			if (ip != '') delete next_rules.blocked_ips[ip];
		}
		if (!atomic_write_or_reply(rules_path, sprintf('%J\n', next_rules), 0o600, null, null, actor, verb, reply_cb)) return;
		apply_bridge_block_rules(next_rules, function(apply_res) {
			if (!apply_res.ok) {
				rollback_client_rules(rules_path, snap_raw, prev_rules, verb, actor, verb, mac, function(rb) {
					release_lock();
					reply_cb({
						ok: false,
						error_code: 'INTERNAL',
						rolled_back: rb.all_ok,
						rollback_failed: !rb.all_ok,
						freeze_persisted: rb.freeze_persisted,
						freeze_persist_failed: rb.freeze_persist_failed,
						message_ar: rb.all_ok ? 'تعذر تطبيق الحظر وتم التراجع تلقائياً والتحقق منه' : 'فشل حرج: تعذر تطبيق الحظر وفشل التراجع — تم تجميد التعديلات'
					});
				});
				return;
			}
			// Verify table membership
			exec_argv_async('/usr/sbin/nft', ['list', 'table', 'bridge', 'noc_block'], 4000, CAP_GENERAL, function(ver) {
				if (!ver.ok || (verb == 'client_block' && index(ver.output, mac) < 0)) {
					rollback_client_rules(rules_path, snap_raw, prev_rules, verb + '_verify', actor, verb, mac, function(rb) {
						release_lock();
						reply_cb({
							ok: false,
							error_code: 'INTERNAL',
							rolled_back: rb.all_ok,
							rollback_failed: !rb.all_ok,
							freeze_persisted: rb.freeze_persisted,
							freeze_persist_failed: rb.freeze_persist_failed,
							message_ar: rb.all_ok ? 'فشل التحقق من قاعدة الحظر وتم التراجع والتحقق منه' : 'فشل حرج: فشل التحقق وفشل التراجع — تم تجميد التعديلات'
						});
					});
					return;
				}
				release_lock();
				audit_append(actor, verb, mac + (ip != '' ? ' (' + ip + ')' : ''), 'committed', 'Verified bridge+inet rule');
				reply_cb({ ok: true, blocked: verb == 'client_block', message_ar: verb == 'client_block' ? 'تم حظر الجهاز على مسار الجسر والتوجيه مع بقاء DNS البوابة مستقراً ما لم يُحجب عبر الجدار' : 'تم إلغاء حظر الجهاز بنجاح' });
			});
		});
		return;
	}

	if (verb == 'service_restart' || verb == 'service_action') {
		let svc = trim(params.name || '');
		let sub = verb == 'service_restart' ? 'restart' : trim(params.subaction || 'restart');
		let allow_svcs = { 'adguardhome': true, 'dnsmasq': true, 'firewall': true, 'sqm': true, 'miniupnpd': true, 'banip': true, 'cron': true, 'dockerd': true, 'tailscale': true, 'network': true, 'sysntpd': true };
		let allow_ops = { 'start': true, 'stop': true, 'restart': true, 'enable': true, 'disable': true };
		let protected_stop = { 'uhttpd': true, 'dropbear': true, 'dnsmasq': true, 'firewall': true };
		if (!allow_svcs[svc] || !allow_ops[sub] || !fs.stat('/etc/init.d/' + svc)) {
			release_lock();
			reply_cb({ ok: false, error_code: 'FORBIDDEN', message_ar: 'الخدمة أو العملية غير مدرجة ضمن القائمة المعتمدة' });
			return;
		}
		if ((sub == 'stop' || sub == 'disable') && protected_stop[svc]) {
			release_lock();
			audit_append(actor, 'service_action', svc + ':' + sub, 'refused', 'Protected core service stop refused');
			reply_cb({ ok: false, error_code: 'FORBIDDEN', message_ar: 'مرفوض: لا يُسمح بإيقاف أو تعطيل الخدمات الأساسية لضمان استقرار الاتصال' });
			return;
		}
		exec_argv_async('/etc/init.d/' + svc, [sub], 15000, CAP_GENERAL, function(r) {
			release_lock();
			audit_append(actor, 'service_action', svc + ':' + sub, r.ok ? 'committed' : 'failed', 'forward-verified-only');
			reply_cb({ ok: r.ok, forward_verified_only: true, error_code: r.ok ? null : 'DEPENDENCY', message_ar: r.ok ? ('تم تنفيذ (' + sub + ') للخدمة ' + svc) : ('فشل تنفيذ العملية للخدمة ' + svc) });
		});
		return;
	}

	if (verb == 'client_set_meta') {
		let mac = lc(trim(params.mac || ''));
		let ip = trim(params.ip || '');
		let nick = replace(trim(params.nickname || ''), /[\r\n\t<>]/g, '');
		let rate_kbps = +(params.rate_limit_kbps || 0);
		if (!is_valid_mac(mac) || length(nick) > 48 || rate_kbps < 0 || rate_kbps > 1000000 || (rate_kbps > 0 && rate_kbps < 64)) {
			release_lock();
			reply_cb({ ok: false, error_code: 'VALIDATION', message_ar: 'بيانات الجهاز أو حد السرعة غير صالح (0 أو 64..1000000 Kbps)' });
			return;
		}
		let gw_macs = get_gateway_macs();
		let gw_ips = get_gateway_ips();
		if (rate_kbps > 0 && (gw_macs[mac] || (ip != '' && (gw_ips[ip] || ip == client_ip)))) {
			release_lock();
			reply_cb({ ok: false, error_code: 'FORBIDDEN', message_ar: 'مرفوض: لا يُسمح بتقييد سرعة البوابة أو الجهاز المدير' });
			return;
		}
		let rules_path = ETC_DIR + '/client_rules.json';
		let prev_rules = read_json(rules_path, { blocked_macs: {}, blocked_ips: {}, nicknames: {}, rate_limits: {} });
		if (!prev_rules.rate_limits) prev_rules.rate_limits = {};
		let snap_raw = sprintf('%J\n', prev_rules);
		let next_rules = read_json(rules_path, { blocked_macs: {}, blocked_ips: {}, nicknames: {}, rate_limits: {} });
		if (!next_rules.rate_limits) next_rules.rate_limits = {};
		if (nick != '') next_rules.nicknames[mac] = nick;
		else delete next_rules.nicknames[mac];
		if (ip != '' && is_valid_ipv4(ip)) {
			if (rate_kbps > 0) next_rules.rate_limits[ip] = rate_kbps;
			else delete next_rules.rate_limits[ip];
		}
		if (!atomic_write_or_reply(rules_path, sprintf('%J\n', next_rules), 0o600, null, null, actor, 'client_set_meta', reply_cb)) return;
		apply_bridge_block_rules(next_rules, function(ar) {
			if (!ar.ok) {
				rollback_client_rules(rules_path, snap_raw, prev_rules, 'client_set_meta', actor, 'client_set_meta', mac, function(rb) {
					release_lock();
					reply_cb({
						ok: false,
						error_code: 'INTERNAL',
						rolled_back: rb.all_ok,
						rollback_failed: !rb.all_ok,
						freeze_persisted: rb.freeze_persisted,
						freeze_persist_failed: rb.freeze_persist_failed,
						message_ar: rb.all_ok ? 'تعذر تطبيق قاعدة حد السرعة وتم التراجع والتحقق منه' : 'فشل حرج: تعذر تطبيق حد السرعة وفشل التراجع — تم تجميد التعديلات'
					});
				});
				return;
			}
			release_lock();
			audit_append(actor, 'client_set_meta', mac, 'committed', 'nick=' + nick + ' kbps=' + rate_kbps);
			reply_cb({ ok: true, message_ar: 'تم حفظ بيانات وتقييد الجهاز بنجاح' });
		});
		return;
	}

	if (verb == 'client_static_lease') {
		let mac = lc(trim(params.mac || ''));
		let ip = trim(params.ip || '');
		let hn = trim(params.hostname || '');
		let enable = !!params.enable;
		if (!is_valid_mac(mac) || (enable && (!is_valid_ipv4(ip) || ip == get_lan_ip())) || (hn != '' && !match(hn, /^[a-zA-Z0-9_-]{1,32}$/))) {
			release_lock();
			reply_cb({ ok: false, error_code: 'VALIDATION', message_ar: 'بيانات تثبيت IP غير صالحة أو تتعارض مع البوابة' });
			return;
		}
		let sid = 'noc_' + replace(mac, /:/g, '');
		try {
			let cur = uci.cursor();
			if (enable) {
				cur.set('dhcp', sid, 'host');
				cur.set('dhcp', sid, 'mac', mac);
				cur.set('dhcp', sid, 'ip', ip);
				if (hn != '') cur.set('dhcp', sid, 'name', hn);
			} else {
				cur.delete('dhcp', sid);
			}
			cur.commit('dhcp');
		} catch (e) {
			release_lock();
			reply_cb({ ok: false, error_code: 'INTERNAL', message_ar: 'فشل تحديث إعدادات DHCP في النظام' });
			return;
		}
		exec_argv_async('/etc/init.d/dnsmasq', ['reload'], 8000, CAP_GENERAL, function(r) {
			release_lock();
			audit_append(actor, 'client_static_lease', mac + '->' + ip, r.ok ? 'committed' : 'failed', 'enable=' + enable);
			reply_cb({ ok: r.ok, message_ar: enable ? 'تم تثبيت عنوان IP الثابت للجهاز' : 'تم إلغاء تثبيت العنوان الثابت' });
		});
		return;
	}

	if (verb == 'client_ping') {
		let ip = trim(params.ip || '');
		if (!is_valid_ipv4(ip)) {
			release_lock();
			reply_cb({ ok: false, error_code: 'VALIDATION', message_ar: 'عنوان IP غير صالح' });
			return;
		}
		exec_argv_async('/bin/ping', ['-c', '2', '-W', '1', ip], 5000, CAP_GENERAL, function(r) {
			release_lock();
			audit_append(actor, 'client_ping', ip, r.ok ? 'ok' : 'fail', 'Client latency probe');
			reply_cb({ ok: true, ip: ip, reachable: r.ok, output: scrub_prohibited(r.output || 'لا توجد استجابة') });
		});
		return;
	}

	if (verb == 'network_action') {
		let sub = trim(params.subaction || '');
		let exe = null, argv = [];
		if (sub == 'reconnect_wan') { exe = '/sbin/ifup'; argv = ['wan']; }
		else if (sub == 'reconnect_wwan') {
			if (fs.stat('/etc/init.d/wwan_uplink')) { exe = '/etc/init.d/wwan_uplink'; argv = ['restart']; }
			else { exe = '/sbin/ifup'; argv = ['wwan']; }
		}
		else if (sub == 'flush_dns') { exe = '/etc/init.d/dnsmasq'; argv = ['reload']; }
		else if (sub == 'sync_time') { exe = '/etc/init.d/sysntpd'; argv = ['restart']; }
		if (!exe) {
			release_lock();
			reply_cb({ ok: false, error_code: 'VALIDATION', message_ar: 'إجراء شبكة غير مدعوم' });
			return;
		}
		exec_argv_async(exe, argv, 12000, CAP_GENERAL, function(r) {
			release_lock();
			audit_append(actor, 'network_action', sub, r.ok ? 'committed' : 'failed', 'Executed ' + exe);
			reply_cb({ ok: r.ok, message_ar: r.ok ? 'تم تنفيذ إجراء الشبكة بنجاح' : 'تعذر تنفيذ إجراء الشبكة' });
		});
		return;
	}

	if (verb == 'sqm_update') {
		let en = params.enabled ? '1' : '0';
		let iface = trim(params.interface || '');
		let dl = +(params.download_kbps || 0);
		let ul = +(params.upload_kbps || 0);
		let qdisc = trim(params.qdisc || 'cake');
		let script = trim(params.script || 'piece_of_cake.qos');
		let overh = +(params.overhead || 44);
		let linkl = trim(params.linklayer || 'ethernet');
		let sq_dscp = params.squash_dscp === false ? '0' : '1';
		let sq_ing = params.squash_ingress === false ? '0' : '1';
		let in_ecn = trim(params.ingress_ecn || 'ECN');
		let eg_ecn = trim(params.egress_ecn || 'ECN');
		let dbg = params.debug_logging ? '1' : '0';
		let verb_lvl = +(params.verbosity != null ? params.verbosity : 5);
		let allow_if = { 'pppoe-wan': true, 'wlan0': true, 'eth0': true, 'br-lan': true };
		let allow_qd = { 'cake': true, 'fq_codel': true };
		let allow_sc = { 'piece_of_cake.qos': true, 'layer_cake.qos': true, 'simple.qos': true };
		let allow_ll = { 'ethernet': true, 'atm': true, 'none': true };
		let allow_ecn = { 'ECN': true, 'NOECN': true };
		if (!allow_if[iface] || !allow_qd[qdisc] || !allow_sc[script] || !allow_ll[linkl] || !allow_ecn[in_ecn] || !allow_ecn[eg_ecn] || dl < 0 || dl > 1000000 || ul < 0 || ul > 1000000 || overh < 0 || overh > 128 || verb_lvl < 0 || verb_lvl > 10) {
			release_lock();
			reply_cb({ ok: false, error_code: 'VALIDATION', message_ar: 'معاملات SQM غير صالحة' });
			return;
		}
		try {
			let cur = uci.cursor();
			cur.set('sqm', 'eth1', 'queue');
			cur.set('sqm', 'eth1', 'enabled', en);
			cur.set('sqm', 'eth1', 'interface', iface);
			cur.set('sqm', 'eth1', 'download', '' + int(dl));
			cur.set('sqm', 'eth1', 'upload', '' + int(ul));
			cur.set('sqm', 'eth1', 'qdisc', qdisc);
			cur.set('sqm', 'eth1', 'script', script);
			cur.set('sqm', 'eth1', 'overhead', '' + int(overh));
			cur.set('sqm', 'eth1', 'linklayer', linkl);
			cur.set('sqm', 'eth1', 'squash_dscp', sq_dscp);
			cur.set('sqm', 'eth1', 'squash_ingress', sq_ing);
			cur.set('sqm', 'eth1', 'ingress_ecn', in_ecn);
			cur.set('sqm', 'eth1', 'egress_ecn', eg_ecn);
			cur.set('sqm', 'eth1', 'debug_logging', dbg);
			cur.set('sqm', 'eth1', 'verbosity', '' + int(verb_lvl));
			cur.commit('sqm');
		} catch (e) {
			release_lock();
			reply_cb({ ok: false, error_code: 'INTERNAL', message_ar: 'فشل حفظ إعدادات SQM' });
			return;
		}
		exec_argv_async('/etc/init.d/sqm', ['reload'], 12000, CAP_GENERAL, function(r) {
			release_lock();
			audit_append(actor, 'sqm_update', iface, r.ok ? 'committed' : 'failed', sprintf('en=%s dl=%d ul=%d', en, int(dl), int(ul)));
			reply_cb({ ok: r.ok, message_ar: r.ok ? 'تم حفظ وتطبيق إعدادات SQM بنجاح' : 'تم الحفظ لكن فشل إعادة تحميل SQM' });
		});
		return;
	}

	if (verb == 'fw_add_redirect') {
		let rname = replace(trim(params.name || 'Rule'), /[\r\n\t<>'"`$;&|]/g, '');
		let proto = trim(params.proto || 'tcp');
		let ext_p = +(params.src_dport || 0);
		let dest_ip = trim(params.dest_ip || '');
		let int_p = +(params.dest_port || 0);
		let allow_pr = { 'tcp': true, 'udp': true, 'tcp udp': true };
		if (rname == '' || length(rname) > 32 || !allow_pr[proto] || ext_p < 1 || ext_p > 65535 || int_p < 1 || int_p > 65535 || !is_valid_ipv4(dest_ip) || dest_ip == get_lan_ip()) {
			release_lock();
			reply_cb({ ok: false, error_code: 'VALIDATION', message_ar: 'بيانات تحويل المنفذ غير صالحة' });
			return;
		}
		if (is_protected_port(ext_p)) {
			release_lock();
			audit_append(actor, 'fw_add_redirect', '' + ext_p, 'refused', 'Protected management port redirect refused');
			reply_cb({ ok: false, error_code: 'FORBIDDEN', message_ar: 'مرفوض: لا يُسمح بتحويل المنافذ الإدارية المحمية (22, 53, 80, 443, 8080, 8780)' });
			return;
		}
		let snap_fw = fs.readfile('/etc/config/firewall');
		let sid = 'noc_fwd_' + urandom_hex(4);
		try {
			let cur = uci.cursor();
			cur.set('firewall', sid, 'redirect');
			cur.set('firewall', sid, 'name', rname);
			cur.set('firewall', sid, 'src', 'wan');
			cur.set('firewall', sid, 'dest', 'lan');
			cur.set('firewall', sid, 'proto', proto);
			cur.set('firewall', sid, 'src_dport', '' + int(ext_p));
			cur.set('firewall', sid, 'dest_ip', dest_ip);
			cur.set('firewall', sid, 'dest_port', '' + int(int_p));
			cur.set('firewall', sid, 'target', 'DNAT');
			cur.set('firewall', sid, 'enabled', '1');
			cur.commit('firewall');
		} catch (e) {
			release_lock();
			reply_cb({ ok: false, error_code: 'INTERNAL', message_ar: 'فشل حفظ قاعدة تحويل المنفذ' });
			return;
		}
		fw_check_and_reload(snap_fw, function(r) {
			release_lock();
			audit_append(actor, 'fw_add_redirect', sid, r.ok ? 'committed' : 'failed', sprintf('%s %d->%s:%d', proto, int(ext_p), dest_ip, int(int_p)));
			reply_cb({ ok: r.ok, message_ar: r.ok ? 'تمت إضافة وتفعيل قاعدة تحويل المنفذ' : (r.message_ar || 'فشل إعادة تحميل الجدار الناري') });
		});
		return;
	}

	if (verb == 'fw_delete_redirect') {
		let sid = trim(params.id || '');
		if (!match(sid, /^[a-zA-Z0-9_-]+$/)) {
			release_lock();
			reply_cb({ ok: false, error_code: 'VALIDATION', message_ar: 'معرف القاعدة غير صالح' });
			return;
		}
		let cur = uci.cursor();
		let stype = cur.get('firewall', sid);
		if (stype != 'redirect') {
			release_lock();
			reply_cb({ ok: false, error_code: 'VALIDATION', message_ar: 'قاعدة التحويل غير موجودة' });
			return;
		}
		let snap_fw = fs.readfile('/etc/config/firewall');
		cur.delete('firewall', sid);
		cur.commit('firewall');
		fw_check_and_reload(snap_fw, function(r) {
			release_lock();
			audit_append(actor, 'fw_delete_redirect', sid, r.ok ? 'committed' : 'failed', 'Removed redirect');
			reply_cb({ ok: r.ok, message_ar: r.ok ? 'تم حذف قاعدة التحويل بنجاح' : (r.message_ar || 'فشل إعادة تحميل الجدار الناري') });
		});
		return;
	}

	if (verb == 'fw_toggle_rule') {
		let sid = trim(params.id || '');
		let en = !!params.enabled;
		if (!match(sid, /^[a-zA-Z0-9_-]+$/) && !match(sid, /^@[a-z]+\[[0-9]+\]$/)) {
			release_lock();
			reply_cb({ ok: false, error_code: 'VALIDATION', message_ar: 'معرف القاعدة غير صالح' });
			return;
		}
		let cur = uci.cursor();
		let rname = cur.get('firewall', sid, 'name') || sid;
		let protected_rules = { 'noc_console_lan': true, 'Allow-NOC-Console-LAN': true, 'Allow-DHCP-Renew': true, 'Allow-Ping': true, 'Allow-DHCPv6': true };
		if (!en && (protected_rules[sid] || protected_rules[rname])) {
			release_lock();
			audit_append(actor, 'fw_toggle_rule', sid, 'refused', 'Protected rule disable refused');
			reply_cb({ ok: false, error_code: 'FORBIDDEN', message_ar: 'مرفوض: لا يُسمح بتعطيل قواعد النظام الأساسية أو منفذ غرفة العمليات' });
			return;
		}
		let snap_fw = fs.readfile('/etc/config/firewall');
		let rb_tok = begin_rollback('firewall', '/etc/config/firewall', '/etc/init.d/firewall reload');
		cur.set('firewall', sid, 'enabled', en ? '1' : '0');
		cur.commit('firewall');
		fw_check_and_reload(snap_fw, function(r) {
