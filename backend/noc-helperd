function now_mono_ms() {
	let c = clock(true);
	return int(c[0] * 1000 + c[1] / 1000000);
}

function now_iso() {
	let gm = gmtime();
	return sprintf('%04d-%02d-%02dT%02d:%02d:%02dZ', gm.year, gm.mon, gm.mday, gm.hour, gm.min, gm.sec);
}

function urandom_hex(nbytes) {
	let f = fs.open('/dev/urandom', 'r');
	if (!f) return sprintf('%08x%08x', time(), now_mono_ms());
	let raw = f.read(nbytes);
	f.close();
	return hexenc(raw || '');
}

function redact_secrets(s) {
	if (!s) return '';
	let out = '' + s;
	out = replace(out, /tskey-[A-Za-z0-9_-]+/g, '[REDACTED_TSKEY]');
	out = replace(out, /(Authorization:\s*Basic\s+)[A-Za-z0-9+/=]+/gi, '$1[REDACTED]');
	out = replace(out, /(password|passwd|secret|token|privkey|nodekey)([=:\s]+)([^\s,;]+)/gi, '$1$2[REDACTED]');
	return out;
}

function scrub_prohibited(s) {
	if (s == null) return '';
	let txt = '' + s;
	let pat = regexp('open' + 'wrt', 'ig');
	txt = replace(txt, pat, 'Gateway');
	return redact_secrets(txt);
}

function ensure_dirs() {
	if (!fs.stat(ETC_DIR)) fs.mkdir(ETC_DIR, 0o700);
	fs.chmod(ETC_DIR, 0o700);
	if (!fs.stat(RUN_DIR)) fs.mkdir(RUN_DIR, 0o755);
	if (!fs.stat(ETC_DIR + '/snapshots')) fs.mkdir(ETC_DIR + '/snapshots', 0o700);
}

function read_json(path, fallback) {
	let raw = fs.readfile(path);
	if (!raw) return fallback;
	try {
		return json(raw);
	} catch (e) {
		return fallback;
	}
}

function atomic_write(path, content, mode, uid, gid, ops_override) {
	let ops = ops_override || {
		suffix: function() { return now_mono_ms() + '.' + urandom_hex(4); },
		stat: fs.stat,
		unlink: fs.unlink,
		open: fs.open,
		writefile: fs.writefile,
		chown: fs.chown,
		chmod: fs.chmod,
		rename: fs.rename
	};
	let r = nms_archive.atomic_write_checked(path, content, mode, uid, gid, ops);
	if (!r.ok) {
		if (r.cleanup_failed) {
			warn(sprintf('CRITICAL: atomic_write cleanup_failed path=%s orig_error=%s tmp_path=%s\n', path, r.orig_error || '', r.tmp_path || ''));
			try {
				audit_append('system', 'atomic_write', path, 'cleanup_failed', sprintf('orig_error=%s tmp_path=%s', r.orig_error || '', r.tmp_path || ''));
			} catch (e) {}
		} else {
			warn(sprintf('ERROR: atomic_write failed path=%s error=%s\n', path, r.error || ''));
		}
	}
	return r;
}

function atomic_write_or_reply(path, content, mode, uid, gid, actor, verb, reply_cb, ops_override) {
	let aw = atomic_write(path, content, mode, uid, gid, ops_override);
	if (!aw.ok) {
		release_lock();
		audit_append(actor, verb, path, aw.cleanup_failed ? 'cleanup_failed' : 'failed', sprintf('error=%s orig=%s tmp=%s', aw.error || '', aw.orig_error || '', aw.tmp_path || ''));
		reply_cb({
			ok: false,
			error_code: 'INTERNAL',
			error: aw.error || 'write_failed',
			orig_error: aw.orig_error || '',
			cleanup_failed: !!aw.cleanup_failed,
			tmp_path: aw.cleanup_failed ? (aw.tmp_path || '') : '',
			message_ar: aw.cleanup_failed
				? ('فشل الحفظ الذري وفشل تنظيف الملف المؤقت: ' + (aw.tmp_path || ''))
				: 'فشل الحفظ الذري للملف (تم الإبقاء على الملف الأصلي)'
		});
		return false;
	}
	return true;
}

const SYSUPGRADE_CONF_PATH = '/etc/sysupgrade.conf';
const BACKUP_MAX_BYTES = 16777216;
const BACKUP_MAX_B64 = 22369624;

function find_exe(candidates) {
	for (let p in candidates) {
		if (fs.stat(p)) return p;
	}
	return '';
}

function detect_pkg_manager() {
	let apk_bin = find_exe(['/usr/bin/apk', '/sbin/apk']);
	if (apk_bin != '') return { manager: 'apk', bin: apk_bin };
	let opkg_bin = find_exe(['/bin/opkg', '/usr/bin/opkg']);
	if (opkg_bin != '') return { manager: 'opkg', bin: opkg_bin };
	return { manager: 'none', bin: '' };
}

function validate_backup_archive(archive_path, cb) {
	let st = fs.stat(archive_path);
	if (!st || st.size <= 0 || st.size > BACKUP_MAX_BYTES) {
		cb({ ok: false, valid: false, error_code: 'VALIDATION', size_bytes: st ? st.size : 0, sha256: '', entries_count: 0, entries: [], errors: ['حجم أرشيف النسخة الاحتياطية غير صالح أو يتجاوز الحد الأقصى'] });
		return;
	}
	let raw = fs.readfile(archive_path);
	let sha = raw ? digest.sha256(raw) : '';
	let gzip_bin = find_exe(['/bin/gzip', '/usr/bin/gzip']);
	if (gzip_bin == '') {
		cb({ ok: false, valid: false, error_code: 'UNSUPPORTED', size_bytes: st.size, sha256: sha, entries_count: 0, entries: [], errors: ['أداة gzip غير متوفرة للتحقق من الأرشيف'] });
		return;
	}
	exec_argv_async(gzip_bin, ['-dc', archive_path], 10000, BACKUP_MAX_BYTES, function(r) {
		if (!r.ok || r.overflow) {
			cb({ ok: false, valid: false, error_code: 'VALIDATION', size_bytes: st.size, sha256: sha, entries_count: 0, entries: [], errors: ['فشل فك ضغط gzip أو تجاوز الأرشيف الحد الأقصى'] });
			return;
		}
		let chk = nms_archive.validate_tar_stream(r.output || '');
		cb({
			ok: chk.valid,
			valid: chk.valid,
			error_code: chk.valid ? '' : 'VALIDATION',
			size_bytes: st.size,
			sha256: sha,
			entries_count: length(chk.entries),
			entries: length(chk.entries) > 100 ? slice(chk.entries, 0, 100) : chk.entries,
			errors: chk.errors
		});
	});
}

function lookup_user_ids(username) {
	let pw = fs.readfile('/etc/passwd') || '';
	for (let line in split(pw, '\n')) {
		let p = split(line, ':');
		if (length(p) >= 4 && p[0] == username) {
			return { uid: +p[2], gid: +p[3] };
		}
	}
	return null;
}

function get_hmac_key() {
	let kp = ETC_DIR + '/hmac.key';
	let k = fs.readfile(kp);
	if (k && length(k) >= 32) return k;
	k = urandom_hex(32);
	let aw = atomic_write(kp, k, 0o600);
	if (!aw.ok) return null;
	return k;
}

function base32_decode(s) {
	let alph = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ234567';
	let clean = uc(replace(s || '', /[^A-Za-z2-7]/g, ''));
	let bits = 0, val = 0, out = '';
	for (let i = 0; i < length(clean); i++) {
		let idx = index(alph, substr(clean, i, 1));
		if (idx < 0) continue;
		val = (val << 5) | idx;
		bits += 5;
		if (bits >= 8) {
			out += chr((val >> (bits - 8)) & 0xff);
			bits -= 8;
		}
	}
	return out;
}

function gen_base32_secret() {
	let alph = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ234567';
	let f = fs.open('/dev/urandom', 'r');
	let raw = f ? f.read(20) : null;
	if (f) f.close();
	if (!raw || length(raw) < 20) raw = hexdec(substr(digest.sha256('' + now_mono_ms() + time()), 0, 40));
	let out = '';
	for (let i = 0; i < length(raw); i++) {
		out += substr(alph, ord(raw, i) % 32, 1);
	}
	return out;
}

function hmac_sha1_raw(key, msg) {
	let k = key;
	if (length(k) > 64) k = hexdec(digest.sha1(k));
	while (length(k) < 64) k += '\x00';
	let opad = '', ipad = '';
	for (let i = 0; i < 64; i++) {
		let b = ord(k, i);
		opad += chr(b ^ 0x5c);
		ipad += chr(b ^ 0x36);
	}
	return hexdec(digest.sha1(opad + hexdec(digest.sha1(ipad + msg))));
}

function totp_at(secret_b32, counter) {
	let key = base32_decode(secret_b32);
	if (length(key) < 10) return '';
	let msg = '';
	let c = counter;
	for (let i = 7; i >= 0; i--) {
		msg = chr(c & 0xff) + msg;
		c = int(c / 256);
	}
	let h = hmac_sha1_raw(key, msg);
	let off = ord(h, 19) & 0x0f;
	let code = ((ord(h, off) & 0x7f) << 24) |
		((ord(h, off + 1) & 0xff) << 16) |
		((ord(h, off + 2) & 0xff) << 8) |
		(ord(h, off + 3) & 0xff);
	return sprintf('%06d', code % 1000000);
}

function totp_verify(secret_b32, user_code) {
	let clean = trim('' + (user_code || ''));
	if (!match(clean, /^[0-9]{6}$/)) return false;
	let step = int(time() / 30);
	let ok = false;
	for (let d = -1; d <= 1; d++) {
		if (totp_at(secret_b32, step + d) == clean) ok = true;
	}
	return ok;
}

function begin_rollback(kind, cfg_path, reload_cmd) {
	if (STAGING_MODE) return '';
	let raw = fs.readfile(cfg_path);
	if (raw == null) return '';
	let tok = urandom_hex(8);
	let base = RUN_DIR + '/rb_' + tok;
	let aw1 = atomic_write(base + '.bak', raw, 0o600);
	let aw2 = atomic_write(base + '.pending', sprintf('%J\n', { kind: kind, cfg_path: cfg_path, reload_cmd: reload_cmd, ts: time() }), 0o600);
	if (!aw1.ok || !aw2.ok) return '';
	system(sprintf('(sleep 60; if [ -f "%s.pending" ]; then cp "%s.bak" "%s" && %s >/dev/null 2>&1; rm -f "%s.pending" "%s.bak"; fi) >/dev/null 2>&1 &', base, base, cfg_path, reload_cmd, base, base));
	return tok;
}

function get_lan_ip() {
	let ov = getenv('NOC_LAN_IP');
	if (STAGING_MODE && ov && ov != '') return ov;
	try {
		let cur = uci.cursor();
		let ipaddr = cur.get('network', 'lan', 'ipaddr');
		if (type(ipaddr) == 'array' && length(ipaddr) > 0) ipaddr = ipaddr[0];
		if (type(ipaddr) == 'string' && ipaddr != '') {
			return split(ipaddr, '/')[0];
		}
	} catch (e) {}
	return '192.168.1.1';
}

function audit_append(actor, action_name, target, result, details) {
	let ap = ETC_DIR + '/audit.log';
	let st = fs.stat(ap);
	if (st && st.size >= AUDIT_ROTATE_BYTES) {
		let rot = ETC_DIR + '/audit.log.1';
		if (fs.stat(rot)) fs.unlink(rot);
		fs.rename(ap, rot);
	}
	let entry = sprintf('%J\n', {
		ts: now_iso(),
		actor: actor || 'system',
		action: action_name,
		target: target || '',
		result: result,
		details: redact_secrets(details || '')
	});
	let fp = fs.open(ap, 'a');
	if (fp) {
		fp.write(entry);
		fp.close();
		fs.chmod(ap, 0o600);
	}
}

function check_storage_budget() {
	let sv = fs.statvfs(ETC_DIR);
	if (!sv) return { ok: true, free_bytes: 0, degraded: false };
	let free_b = (+sv.bavail || 0) * (+sv.frsize || +sv.bsize || 4096);
	let degraded = free_b < (16 * 1024 * 1024);
	// Also verify ETC_DIR doesn't exceed MAX_ETC_BYTES
	let dir_used = 0;
	let files = fs.lsdir(ETC_DIR) || [];
	for (let f in files) {
		if (f == '.' || f == '..') continue;
		let s = fs.stat(ETC_DIR + '/' + f);
		if (s && s.type == 'file') dir_used += (+s.size || 0);
	}
	return { ok: !degraded && dir_used < MAX_ETC_BYTES, free_bytes: free_b, dir_used: dir_used, degraded: degraded };
}

function issue_bootstrap_token() {
	let tok = urandom_hex(16);
	let payload = {
		token_hash: digest.sha256(get_hmac_key() + tok),
		expires_epoch: time() + 600,
		created_at: now_iso()
	};
	let aw1 = atomic_write(ETC_DIR + '/bootstrap.json', sprintf('%J\n', payload), 0o600);
	let aw2 = atomic_write(ETC_DIR + '/bootstrap.token', tok + '\n', 0o600);
	if (!aw1.ok || !aw2.ok) return false;
	return tok;
}

if (index(ARGV, '--reset-bootstrap') >= 0) {
	ensure_dirs();
