			psk = mp[1];
		}
		let next_conf = "ctrl_interface=/var/run/wpa_supplicant\nnetwork={\n    ssid=\"" + ssid + "\"\n    psk=\"" + psk + "\"\n    key_mgmt=WPA-PSK\n}\n";
		if (!atomic_write_or_reply(conf_p, next_conf, 0o600, null, null, actor, 'wifi_save_uplink', reply_cb)) return;
		let uplink_init = fs.stat('/etc/init.d/wwan_uplink') ? '/etc/init.d/wwan_uplink' : '/etc/init.d/network';
		exec_argv_async(uplink_init, ['restart'], 10000, CAP_GENERAL, function() {
