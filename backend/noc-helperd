		if (type(ids) != 'array' || length(ids) > 64) {
			release_lock();
			reply_cb({ ok: false, error_code: 'VALIDATION', message_ar: 'قائمة الخدمات المحجوبة غير صالحة' });
			return;
		}
		let clean_ids = [];
		for (let sid in ids) {
