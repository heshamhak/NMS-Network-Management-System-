		let r = adguard_http('PUT', '/control/blocked_services/update', { ids: clean_ids, schedule: sched });
		if (!r.ok && (r.status == 404 || r.status == 405)) {
			r = adguard_http('POST', '/control/blocked_services/set', clean_ids);
		}
		release_lock();
		audit_append(actor, 'agh_set_blocked_services', 'services', r.ok ? 'committed' : 'failed', 'count=' + length(clean_ids));
		reply_cb(r.ok ? { ok: true, message_ar: 'تم تحديث قائمة التطبيقات المحجوبة بنجاح' } : r);
		return;
	}

	if (verb == 'agh_rewrite_add' || verb == 'agh_rewrite_delete') {
		let dom = lc(trim(params.domain || ''));
		let ans = trim(params.answer || '');
		if (!is_valid_fqdn(dom) || is_blocked_rewrite_domain(dom)) {
			release_lock();
			reply_cb({ ok: false, error_code: 'FORBIDDEN', message_ar: 'النطاق غير صالح أو محمي من إعادة التوجيه' });
			return;
		}
		if (ans == '' || (!is_valid_ipv4(ans) && ans != '0.0.0.0' && ans != 'A' && ans != 'AAAA')) {
			release_lock();
			reply_cb({ ok: false, error_code: 'VALIDATION', message_ar: 'عنوان IP المستهدف في إعادة التوجيه غير صالح' });
			return;
		}
		let ep = verb == 'agh_rewrite_add' ? '/control/rewrite/add' : '/control/rewrite/delete';
		let r = adguard_http('POST', ep, { domain: dom, answer: ans });
		release_lock();
		audit_append(actor, verb, dom + '->' + ans, r.ok ? 'committed' : 'failed', 'DNS rewrite');
		reply_cb(r.ok ? { ok: true, message_ar: verb == 'agh_rewrite_add' ? 'تمت إضافة سجل إعادة التوجيه بنجاح' : 'تم حذف سجل إعادة التوجيه بنجاح' } : r);
		return;
	}

	if (verb == 'agh_filter_add' || verb == 'agh_filter_delete' || verb == 'agh_filter_toggle') {
		let url = trim(params.url || '');
		let fname = replace(trim(params.name || 'Filter'), /[\r\n\t<>'"`$;&|]/g, '');
		if (!is_safe_https_filter_url(url)) {
			release_lock();
			reply_cb({ ok: false, error_code: 'FORBIDDEN', message_ar: 'يجب أن يكون رابط الفلتر HTTPS خارجياً موثوقاً (ممنوع الروابط المحلية والخاصة)' });
			return;
		}
		if (verb == 'agh_filter_add') {
			if (fname == '' || length(fname) > 64) { release_lock(); reply_cb({ ok: false, error_code: 'VALIDATION', message_ar: 'اسم الفلتر غير صالح' }); return; }
			let r = adguard_http('POST', '/control/filtering/add_url', { name: fname, url: url, whitelist: false });
			release_lock();
			audit_append(actor, 'agh_filter_add', url, r.ok ? 'committed' : 'failed', fname);
			reply_cb(r.ok ? { ok: true, message_ar: 'تمت إضافة قائمة الفلتر بنجاح' } : r);
			return;
		}
		if (verb == 'agh_filter_delete') {
			let r = adguard_http('POST', '/control/filtering/remove_url', { url: url, whitelist: false });
			release_lock();
			audit_append(actor, 'agh_filter_delete', url, r.ok ? 'committed' : 'failed', 'Removed filter');
			reply_cb(r.ok ? { ok: true, message_ar: 'تم حذف قائمة الفلتر بنجاح' } : r);
			return;
		}
		let r = adguard_http('POST', '/control/filtering/set_url', { url: url, whitelist: false, data: { enabled: !!params.enabled, name: fname, url: url } });
		release_lock();
		audit_append(actor, 'agh_filter_toggle', url, r.ok ? 'committed' : 'failed', 'enabled=' + (!!params.enabled));
		reply_cb(r.ok ? { ok: true, message_ar: 'تم تحديث حالة قائمة الفلتر بنجاح' } : r);
		return;
	}

	if (verb == 'agh_dns_config') {
		let mode = trim(params.upstream_mode || 'parallel');
		let csize = +(params.cache_size || 67108864);
		let rlim = +(params.ratelimit || 0);
		let allow_m = { 'load_balance': true, 'parallel': true, 'fastest_addr': true };
		if (!allow_m[mode] || csize < 0 || csize > 268435456 || rlim < 0 || rlim > 10000) {
			release_lock();
			reply_cb({ ok: false, error_code: 'VALIDATION', message_ar: 'إعدادات خادم DNS غير صالحة' });
			return;
		}
		let dinfo = adguard_http('GET', '/control/dns_info', null);
		if (!dinfo.ok || type(dinfo.data) != 'object') { release_lock(); reply_cb(dinfo); return; }
		let cur_c = dinfo.data;
		let body_dns = {
			upstream_dns: cur_c.upstream_dns || [],
			upstream_mode: mode,
			cache_size: int(csize),
			cache_enabled: cur_c.cache_enabled !== false,
			enable_dnssec: !!cur_c.enable_dnssec,
			aaaa_disabled: !!cur_c.aaaa_disabled,
			ratelimit: int(rlim)
		};
		let r = adguard_http('POST', '/control/dns_config', body_dns);
		release_lock();
		audit_append(actor, 'agh_dns_config', mode, r.ok ? 'committed' : 'failed', sprintf('cache=%d rate=%d', int(csize), int(rlim)));
