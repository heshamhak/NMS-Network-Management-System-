	if (verb == 'client_inspect') {
		let target_ip = trim(params.ip || '');
		let target_mac = lc(trim(params.mac || ''));
		if (!is_valid_ipv4(target_ip) && !is_valid_mac(target_mac)) {
			reply_cb({ ok: false, error_code: 'VALIDATION', message_ar: 'عنوان IP أو MAC غير صالح للفحص التفصيلي' });
			return;
		}
		// 1. Active Conntrack Sessions for this IP
		let ct_raw = fs.readfile('/proc/net/nf_conntrack') || '';
		let flows = [];
		if (target_ip != '' && ct_raw != '') {
			for (let line in split(ct_raw, '\n')) {
				if (index(line, 'src=' + target_ip + ' ') < 0 && index(line, 'dst=' + target_ip + ' ') < 0) continue;
				let parts = split(trim(line), /\s+/);
				let proto = length(parts) >= 3 ? parts[2] : 'ip';
				let state_s = (length(parts) >= 5 && match(parts[4], /^[A-Z_]+$/)) ? parts[4] : 'ACTIVE';
				let m_src = match(line, /src=([0-9.]+)\s+dst=([0-9.]+)\s+sport=([0-9]+)\s+dport=([0-9]+)/);
				if (m_src) {
					if (m_src[2] == '127.0.0.1' || (m_src[1] == target_ip && m_src[2] == get_lan_ip() && m_src[4] == '8780')) continue;
					let mb = match(line, /bytes=([0-9]+)/);
					push(flows, {
						proto: uc(proto),
						state: state_s,
						src: m_src[1] + ':' + m_src[3],
						dst: m_src[2] + ':' + m_src[4],
						dst_ip: m_src[2],
						dport: +m_src[4],
						bytes: mb ? (+mb[1]) : 0
					});
					if (length(flows) >= 60) break;
				}
			}
		}
		// 2. Device DNS Query & Block History from AdGuard querylog.json
		let dns_all = [];
		let dns_blocked = [];
		let top_domains_map = {};
		let st_q = fs.stat(QUERYLOG_PATH);
		if (target_ip != '' && st_q && st_q.size > 0) {
			let fp = fs.open(QUERYLOG_PATH, 'r');
			if (fp) {
				let wbytes = 786432; // 768 KB window
				if (st_q.size > wbytes) fp.seek(-wbytes, 2);
				let qraw = fp.read(wbytes + 4096) || '';
				fp.close();
				let qlines = split(qraw, '\n');
				let start_i = (st_q.size > wbytes) ? 1 : 0;
				for (let i = length(qlines) - 1; i >= start_i; i--) {
					let t = trim(qlines[i]);
					if (t == '' || substr(t, 0, 1) != '{' || index(t, '"' + target_ip + '"') < 0) continue;
					let q = null;
					try { q = json(t); } catch (e) { q = null; }
					if (!q || q.IP != target_ip || !q.QH || q.QT == 'PTR') continue;
					let blk = !!(q.Result && q.Result.IsFiltered);
					let rule_t = (q.Result && q.Result.Rules && q.Result.Rules[0]) ? (q.Result.Rules[0].Text || '') : '';
					let hhmmss = '';
					let mt = match(q.T || '', /T([0-9]{2}:[0-9]{2}:[0-9]{2})/);
					if (mt) hhmmss = mt[1];
					let el_ms = int((+q.Elapsed || 0) / 100000) / 10.0;
					let item = {
						time: hhmmss,
						domain: q.QH,
						type: q.QT || 'A',
						blocked: blk,
						rule: rule_t,
						elapsed_ms: el_ms
					};
					top_domains_map[q.QH] = (top_domains_map[q.QH] || 0) + 1;
					if (length(dns_all) < 60) push(dns_all, item);
					if (blk && length(dns_blocked) < 40) push(dns_blocked, item);
					if (length(dns_all) >= 60 && length(dns_blocked) >= 40) break;
				}
			}
		}
		let top_domains = [];
		for (let d in keys(top_domains_map)) push(top_domains, { domain: d, count: top_domains_map[d] });
		sort(top_domains, function(a, b) { return b.count - a.count; });
		if (length(top_domains) > 12) top_domains = slice(top_domains, 0, 12);

		// 3. Audit Log Block / Unblock / Rate-Limit History for this MAC or IP
		let audit_hist = [];
		for (let ap_path in [ETC_DIR + '/audit.log', ETC_DIR + '/audit.log.1']) {
			let araw = fs.readfile(ap_path) || '';
			if (araw == '') continue;
			for (let al in split(araw, '\n')) {
				let at = trim(al);
				if (at == '') continue;
				if ((target_mac != '' && index(lc(at), target_mac) >= 0) || (target_ip != '' && index(at, target_ip) >= 0)) {
					try {
						let ae = json(at);
						if (ae) push(audit_hist, ae);
					} catch (e) {}
				}
			}
		}
		reply_cb({
			ok: true,
			ip: target_ip,
			mac: target_mac,
			active_flows: flows,
			dns_queries: dns_all,
			blocked_queries: dns_blocked,
			top_domains: top_domains,
			audit_history: slice(audit_hist, -30)
		});
		return;
	}

