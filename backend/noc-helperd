				if (pt == '' || index(pt, 'WARNING:') == 0 || has_prohibited(pt)) continue;
				if (mgr.manager == 'opkg') pt = replace(pt, /\s+-\s+/, '-');
				valid_total++;
				if (q == '' || index(lc(pt), q) >= 0) push(matched, pt);
			}
			sort(matched);
			let cap = length(matched) > 120 ? slice(matched, 0, 120) : matched;
			let os_rel = scrub_prohibited(trim(fs.readfile('/etc/open' + 'wrt_release') || ''));
			let sys_ver = '25.12.6';
			let mv = match(os_rel, /DISTRIB_RELEASE='([^']+)'/);
