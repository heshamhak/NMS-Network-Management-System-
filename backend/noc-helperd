					let di = nms_fw_wifi.parse_iw_dev_info(dev_out);
					let iface_op = !!(hst && hst.status == 'ENABLED' && di.channel != '' && di.ssid != '');
					return { radio_up: !!rinfo.up, iface_operational: iface_op, active_ssid: di.ssid || '' };
				})();
				if (!params.disabled) {
					if (!rt_if || rt_if.radio_up !== true || rt_if.iface_operational !== true || !rt_if.active_ssid || rt_if.active_ssid != ('' + params.ssid)) {
						return { ok: false, error: 'الواجهة اللاسلكية غير نشطة فعلياً أو لا تبث SSID المطلوب بعد إعادة التحميل' };
					}
				} else if (rt_if && rt_if.iface_operational === true) {
					return { ok: false, error: 'الواجهة اللاسلكية ما زالت نشطة رغم طلب تعطيلها' };
				}
			} else if (verb == 'wifi_iface_delete') {
				if (cv.get('wireless', expected_sid) != null) return { ok: false, error: 'الشبكة اللاسلكية ما زالت موجودة بعد الحذف' };
			}
			return { ok: true };
		},
		on_rollback_failed: function(reason) {
			return enter_emergency_freeze(reason);
		}
	});
	release_lock();
	audit_append(actor, verb, target_id, tx_res.ok ? 'committed' : (tx_res.rollback_failed ? 'rollback_failed' : 'rolled_back'), tx_res.message_ar || '');
	reply_cb(tx_res);
}

function adguard_sync_rule(action_type, rule_str, actor) {
	// Fetch current rules from loopback HTTP API first (preserving ALL user-created rules)
	let st = adguard_http('GET', '/control/filtering/status', null);
	if (!st.ok) return st;
	let cur_rules = (st.data && st.data.user_rules) ? st.data.user_rules : [];
	let marker = '! [NOC-CONSOLE]';
	let next_rules = [];

	if (action_type == 'add') {
		for (let i = 0; i < length(cur_rules); i++) {
			push(next_rules, cur_rules[i]);
			if (cur_rules[i] == rule_str) {
				return { ok: true, message: 'القاعدة مدرجة مسبقاً' };
			}
		}
		push(next_rules, marker);
		push(next_rules, rule_str);
	} else if (action_type == 'remove') {
		let found_managed = false;
		for (let i = 0; i < length(cur_rules); i++) {
			if (cur_rules[i] == rule_str) {
				if (i > 0 && cur_rules[i - 1] == marker) {
					pop(next_rules); // remove paired [NOC-CONSOLE] marker
					found_managed = true;
					continue;
				}
				// Refuse deleting user-created rules
				return { ok: false, error_code: 'FORBIDDEN', message_ar: 'لا يمكن حذف قاعدة أنشأها المستخدم خارج لوحة العمليات' };
			}
			push(next_rules, cur_rules[i]);
		}
		if (!found_managed) {
			return { ok: false, error_code: 'VALIDATION', message_ar: 'القاعدة المطلوب حذفها غير موجودة' };
		}
	}

	let res = adguard_http('POST', '/control/filtering/set_rules', { rules: next_rules });
	if (!res.ok) return res;
	let verify = adguard_http('GET', '/control/filtering/status', null);
	if (!verify.ok) return { ok: false, verify_failed: true, error_code: 'DEPENDENCY', message_ar: 'فشل التحقق بعد تحديث قواعد AdGuard' };
	audit_append(actor, 'agh_' + action_type + '_rule', rule_str, 'committed', 'Updated via AdGuard HTTP API');
	return { ok: true, message: action_type == 'add' ? 'تم تطبيق القاعدة وحفظها بأمان' : 'تمت إزالة القاعدة المدارة بنجاح' };
}

// --- Main RPC Request Handler ---
function handle_rpc(req, reply_cb) {
	let verb = req.verb || '';
	let params = req.params || {};
	let actor = req.actor || 'anonymous';
	let client_ip = req.client_ip || '';

	// Auth verbs
	if (verb == 'auth_status') {
		let has_auth = !!fs.stat(ETC_DIR + '/auth.json');
		let has_boot = false;
		let b = read_json(ETC_DIR + '/bootstrap.json', null);
		if (b && b.expires_epoch > time()) has_boot = true;
		let freeze = get_freeze_state();
		let stor = check_storage_budget();
		let max_gap = 0;
		for (let g in reconciler_gaps) if (g > max_gap) max_gap = g;
		let agh_cfg = read_json(ETC_DIR + '/adguard.json', null);
		reply_cb({
			ok: true,
			initialized: has_auth,
			bootstrap_active: !has_auth && has_boot,
			freeze: freeze,
			storage: stor,
			adguard_creds_configured: !!(agh_cfg && agh_cfg.username),
			reconciler_tick_count: reconciler_tick_count,
			reconciler_max_gap_ms: max_gap
		});
		return;
	}

	if (verb == 'auth_bootstrap_complete') {
		if (fs.stat(ETC_DIR + '/auth.json')) {
			reply_cb({ ok: false, error_code: 'FORBIDDEN', message_ar: 'تم تفعيل حساب المدير مسبقاً' });
			return;
		}
		let tok = trim(params.token || '');
		let pw = '' + (params.password || '');
		if (length(pw) < 12) {
			reply_cb({ ok: false, error_code: 'VALIDATION', message_ar: 'يجب أن لا يقل طول كلمة المرور عن 12 حرفاً' });
			return;
		}
		let b = read_json(ETC_DIR + '/bootstrap.json', null);
		if (!b || b.expires_epoch < time()) {
			reply_cb({ ok: false, error_code: 'AUTH', message_ar: 'انتهت صلاحية رمز التهيئة الأولية أو غير موجود' });
			return;
		}
		let candidate = digest.sha256(get_hmac_key() + tok);
		if (!hash_then_compare(candidate, b.token_hash)) {
			record_auth_failure(client_ip, 'bootstrap');
			reply_cb({ ok: false, error_code: 'AUTH', message_ar: 'رمز التهيئة غير صحيح' });
			return;
		}
		if (auth_busy) {
			reply_cb({ ok: false, status: 429, error_code: 'TIMEOUT', retry_after: 1, message_ar: 'توجد عملية تشفير جارية حالياً' });
			return;
		}
		auth_busy = true;
		let salt = urandom_hex(16);
		uloop.task(function() {
			return pbkdf2_sha256(pw, salt, PBKDF2_ITER);
		}, function(dk) {
			auth_busy = false;
			if (!dk) {
				reply_cb({ ok: false, error_code: 'INTERNAL', message_ar: 'فشل اشتقاق مفتاح المرور' });
				return;
			}
			let rec = { version: 1, alg: 'pbkdf2-hmac-sha256', iter: PBKDF2_ITER, users: { admin: { role: 'admin', salt_hex: salt, dk_hex: dk } } };
			let aw = atomic_write(ETC_DIR + '/auth.json', sprintf('%J\n', rec), 0o600);
			if (!aw.ok) {
				audit_append('admin', 'auth_bootstrap_complete', 'admin', aw.cleanup_failed ? 'cleanup_failed' : 'failed', sprintf('error=%s orig=%s tmp=%s', aw.error || '', aw.orig_error || '', aw.tmp_path || ''));
				reply_cb({
					ok: false,
					error_code: 'INTERNAL',
					error: aw.error || 'write_failed',
					orig_error: aw.orig_error || '',
					cleanup_failed: !!aw.cleanup_failed,
					tmp_path: aw.cleanup_failed ? (aw.tmp_path || '') : '',
					message_ar: 'فشل حفظ بيانات اعتماد المدير (تم الحفاظ على رمز التهيئة)'
				});
				return;
			}
			if (fs.stat(ETC_DIR + '/bootstrap.json')) fs.unlink(ETC_DIR + '/bootstrap.json');
			if (fs.stat(ETC_DIR + '/bootstrap.token')) fs.unlink(ETC_DIR + '/bootstrap.token');
			clear_auth_failure(client_ip, 'bootstrap');
			audit_append('admin', 'auth_bootstrap_complete', 'admin', 'committed', 'Initial admin credential provisioned');
			reply_cb({ ok: true, role: 'admin', message_ar: 'تم تعيين كلمة مرور المدير وحذف رمز التهيئة' });
		});
		return;
	}

	if (verb == 'auth_login') {
		let username = trim(params.username || 'admin');
		let pw = '' + (params.password || '');
		let wait_s = check_lockout(client_ip, username);
		if (wait_s > 0) {
			reply_cb({ ok: false, status: 429, error_code: 'AUTH', retry_after: wait_s, message_ar: sprintf('تم تأمين الحساب مؤقتاً، يرجى الانتظار %d ثانية', wait_s) });
			return;
		}
		let auth_doc = read_json(ETC_DIR + '/auth.json', null);
		let u = auth_doc && auth_doc.users ? auth_doc.users[username] : null;
		if (!u) {
			record_auth_failure(client_ip, username);
			reply_cb({ ok: false, status: 401, error_code: 'AUTH', message_ar: 'بيانات الدخول غير صحيحة' });
			return;
		}
		if (auth_busy) {
			reply_cb({ ok: false, status: 429, error_code: 'TIMEOUT', retry_after: 1, message_ar: 'الخادم مشغول بالتحقق من جلسة أخرى، أعد المحاولة بعد لحظة' });
			return;
		}
		auth_busy = true;
		let iters = +auth_doc.iter || PBKDF2_ITER;
		let salt = u.salt_hex;
		let expected = u.dk_hex;
		uloop.task(function() {
			return pbkdf2_sha256(pw, salt, iters);
		}, function(dk) {
			auth_busy = false;
			if (!dk || !hash_then_compare(dk, expected)) {
				record_auth_failure(client_ip, username);
				audit_append(username, 'auth_login', client_ip, 'denied', 'Invalid password');
				reply_cb({ ok: false, status: 401, error_code: 'AUTH', message_ar: 'اسم المستخدم أو كلمة المرور غير صحيحة' });
				return;
			}
			if (u.totp_enabled && u.totp_secret) {
				let tcode = trim('' + (params.totp_code || ''));
				if (tcode == '') {
					reply_cb({ ok: false, status: 401, error_code: 'TOTP_REQUIRED', totp_required: true, message_ar: 'يرجى إدخال رمز المصادقة الثنائية (TOTP)' });
					return;
				}
				if (!totp_verify(u.totp_secret, tcode)) {
					record_auth_failure(client_ip, username);
					audit_append(username, 'auth_login', client_ip, 'denied', 'Invalid TOTP code');
					reply_cb({ ok: false, status: 401, error_code: 'AUTH', totp_required: true, message_ar: 'رمز المصادقة الثنائية (TOTP) غير صحيح' });
					return;
				}
			}
			clear_auth_failure(client_ip, username);
			audit_append(username, 'auth_login', client_ip, 'ok', 'Authenticated successfully');
			reply_cb({ ok: true, username: username, role: u.role || 'readonly' });
		});
		return;
	}

	if (verb == 'auth_set_readonly') {
		let stg_u = check_staging_guard();
		if (!stg_u.ok) { reply_cb(stg_u); return; }
		let auth_doc = read_json(ETC_DIR + '/auth.json', null);
		if (!auth_doc || !auth_doc.users) {
			reply_cb({ ok: false, error_code: 'AUTH', message_ar: 'يلزم تهيئة حساب المدير أولاً' });
			return;
		}
		let pw = '' + (params.password || '');
		let uname = trim(params.username || 'viewer');
		if (uname == 'admin' || !match(uname, /^[a-z][a-z0-9_-]{2,24}$/) || length(pw) < 12) {
			reply_cb({ ok: false, error_code: 'VALIDATION', message_ar: 'اسم المستخدم أو كلمة المرور (12+ حرفاً) غير صالحة' });
			return;
		}
		if (auth_busy) {
			reply_cb({ ok: false, status: 429, error_code: 'TIMEOUT', retry_after: 1, message_ar: 'توجد عملية تشفير جارية حالياً' });
			return;
		}
		auth_busy = true;
		let salt = urandom_hex(16);
		let iters = +auth_doc.iter || PBKDF2_ITER;
		uloop.task(function() {
			return pbkdf2_sha256(pw, salt, iters);
		}, function(dk) {
			auth_busy = false;
			if (!dk) { reply_cb({ ok: false, error_code: 'INTERNAL', message_ar: 'فشل اشتقاق المفتاح' }); return; }
			let doc = read_json(ETC_DIR + '/auth.json', auth_doc);
			doc.users[uname] = { role: 'readonly', salt_hex: salt, dk_hex: dk };
			let aw = atomic_write(ETC_DIR + '/auth.json', sprintf('%J\n', doc), 0o600);
			if (!aw.ok) {
				audit_append(actor, 'auth_set_readonly', uname, aw.cleanup_failed ? 'cleanup_failed' : 'failed', sprintf('error=%s orig=%s tmp=%s', aw.error || '', aw.orig_error || '', aw.tmp_path || ''));
				reply_cb({ ok: false, error_code: 'INTERNAL', error: aw.error, orig_error: aw.orig_error || '', cleanup_failed: !!aw.cleanup_failed, tmp_path: aw.cleanup_failed ? (aw.tmp_path || '') : '', message_ar: 'فشل حفظ حساب المراقب' });
				return;
			}
			audit_append(actor, 'auth_set_readonly', uname, 'committed', 'Provisioned readonly operator');
			reply_cb({ ok: true, username: uname, role: 'readonly', message_ar: 'تم تفعيل حساب المراقب للقراءة فقط بنجاح' });
		});
		return;
	}

	// Pseudonym generator (HMAC keyed by helper-only secret)
	if (verb == 'hmac_pseudonym') {
		let id_str = lc(trim(params.identity || ''));
		let p_hash = substr(digest.sha256(get_hmac_key() + '|pseudo|' + id_str), 0, 12);
		reply_cb({ ok: true, pseudonym: 'DEV-' + uc(p_hash) });
		return;
	}

	// Read-only collectors (via helper for root-owned resources)
	if (verb == 'adguard_read') {
		let qsum = read_querylog_summary(800, 80);
		let api_st = adguard_http('GET', '/control/status', null);
		let api_filt = api_st.ok ? adguard_http('GET', '/control/filtering/status', null) : { ok: false };
		let api_par = api_st.ok ? adguard_http('GET', '/control/parental/status', null) : { ok: false };
		let api_safe = api_st.ok ? adguard_http('GET', '/control/safebrowsing/status', null) : { ok: false };
		let api_ss = api_st.ok ? adguard_http('GET', '/control/safesearch/status', null) : { ok: false };
		let api_bs = api_st.ok ? adguard_http('GET', '/control/blocked_services/get', null) : { ok: false };
		let api_rw = api_st.ok ? adguard_http('GET', '/control/rewrite/list', null) : { ok: false };
		let api_dns = api_st.ok ? adguard_http('GET', '/control/dns_info', null) : { ok: false };
		let bs_ids = [];
		if (api_bs.ok && api_bs.data != null) {
			if (type(api_bs.data) == 'array') bs_ids = api_bs.data;
			else if (type(api_bs.data) == 'object' && api_bs.data.ids) bs_ids = api_bs.data.ids;
		}
		let dns_d = (api_dns.ok && type(api_dns.data) == 'object') ? api_dns.data : {};
		exec_argv_async('/usr/sbin/nft', ['-j', 'list', 'chain', 'inet', 'fw4', 'dstnat'], 5000, CAP_GENERAL, function(nft_res) {
			let dnat_configured = false;
			if (nft_res.ok && index(nft_res.output, '53') >= 0) dnat_configured = true;
			let leases_raw = fs.readfile(LEASES_PATH) || '';
			exec_argv_async('/sbin/ip', ['-4', 'neigh', 'show', 'dev', 'br-lan'], 4000, CAP_GENERAL, function(neigh_res) {
				let res_payload = {
					ok: true,
					api_connected: api_st.ok,
					api_error: api_st.ok ? null : (api_st.message_ar || 'غير متصل'),
					status: api_st.ok ? api_st.data : null,
					filtering: api_filt.ok ? api_filt.data : null,
					parental_enabled: !!(api_par.ok && api_par.data && api_par.data.enabled),
					safebrowsing_enabled: !!(api_safe.ok && api_safe.data && api_safe.data.enabled),
					safesearch_enabled: !!(api_ss.ok && api_ss.data && api_ss.data.enabled),
					blocked_services: bs_ids,
					available_services: ['youtube', 'tiktok', 'instagram', 'facebook', 'whatsapp', 'telegram', 'discord', 'netflix', 'snapchat', 'roblox', 'steam', 'twitch', 'twitter', 'reddit'],
					rewrites: (api_rw.ok && type(api_rw.data) == 'array') ? api_rw.data : [],
					dns_info: {
						upstream_dns: dns_d.upstream_dns || [],
						upstream_mode: dns_d.upstream_mode || 'parallel',
						cache_size: +(dns_d.cache_size || 0),
						cache_enabled: dns_d.cache_enabled !== false,
						enable_dnssec: !!dns_d.enable_dnssec,
						aaaa_disabled: !!dns_d.aaaa_disabled,
						ratelimit: +(dns_d.ratelimit || 0)
					},
					dnat_redirect_configured: dnat_configured,
					doh_dot_bypass_status: 'unknown',
					query_summary: qsum,
					leases_raw: leases_raw,
					neigh_raw: neigh_res.ok ? neigh_res.output : ''
				};
				reply_cb(res_payload);
			});
		});
		return;
	}

	if (verb == 'clients_read') {
		let rules = read_json(ETC_DIR + '/client_rules.json', { blocked_macs: {}, blocked_ips: {}, nicknames: {}, rate_limits: {} });
		let leases_raw = fs.readfile(LEASES_PATH) || '';
		let br_nf = trim(fs.readfile('/proc/sys/net/bridge/bridge-nf-call-iptables') || '0') == '1';
		let flow_offload = false;
		let static_leases = {};
		let static_leases_list = [];
		let local_domains = [];
		try {
			let cur = uci.cursor();
			let fo = cur.get('firewall', '@defaults[0]', 'flow_offloading');
			if (fo == '1') flow_offload = true;
			cur.foreach('dhcp', 'host', function(s) {
				if (s.mac && s.ip) {
					let ml = lc(trim(s.mac));
					static_leases[ml] = { ip: s.ip, name: s.name || '', section_id: s['.name'] };
					push(static_leases_list, { id: s['.name'], name: s.name || '', mac: ml, ip: s.ip, leasetime: s.leasetime || 'infinite' });
				}
			});
			cur.foreach('dhcp', 'domain', function(s) {
				if (s.name && s.ip) {
					push(local_domains, { id: s['.name'], name: s.name, ip: s.ip });
				}
			});
		} catch (e) {}
		let bridges = nms_discovery.discover_bridges_from_sysfs('/sys/class/net');
		let bridge_exe = find_exe(['/sbin/bridge', '/usr/sbin/bridge']);
		let wifi_stations = {};
		let wifi_available = false;
		try {
			let uctx = ubus.connect();
			if (uctx) {
				let ws = uctx.call('network.wireless', 'status');
				if (type(ws) == 'object') {
					let hc_map = {};
					for (let rad in keys(ws)) {
						let rinfo = ws[rad];
						if (!rinfo || type(rinfo.interfaces) != 'array') continue;
						for (let itf in rinfo.interfaces) {
							if (itf && itf.ifname) {
								let hc = uctx.call('hostapd.' + itf.ifname, 'get_clients');
								if (type(hc) == 'object') {
									hc_map[itf.ifname] = hc;
									wifi_available = true;
								}
							}
						}
					}
					wifi_stations = nms_discovery.parse_wifi_stations(ws, hc_map);
				}
				try { uctx.disconnect(); } catch (e) {}
			}
		} catch (e) {}
		exec_argv_async('/sbin/ip', ['-4', 'neigh', 'show'], 4000, CAP_GENERAL, function(n4) {
			exec_argv_async('/sbin/ip', ['-6', 'neigh', 'show'], 4000, CAP_GENERAL, function(n6) {
				let finish_clients = function(fdb_raw, fdb_ok) {
					exec_argv_async('/usr/sbin/nlbw', ['-c', 'json', '-g', 'mac,ip,fam', '-o', '-rx_bytes'], 4000, 262144, function(nlr) {
						let nlbw_by_mac = {};
						let nlbw_by_ip = {};
						let nlbw_ok = false;
						if (nlr.ok && nlr.output) {
							try {
								let nj = json(nlr.output);
								if (nj && nj.data) {
									nlbw_ok = true;
									for (let row in nj.data) {
										if (length(row) < 7) continue;
										let rm = lc(trim(row[1] || ''));
										let rip = trim(row[2] || '');
										let conns = +(row[3] || 0), rxb = +(row[4] || 0), txb = +(row[6] || 0);
										if (rm != '' && rm != '00:00:00:00:00:00') {
											if (!nlbw_by_mac[rm]) nlbw_by_mac[rm] = { rx_bytes: 0, tx_bytes: 0, conns: 0 };
											nlbw_by_mac[rm].rx_bytes += rxb; nlbw_by_mac[rm].tx_bytes += txb; nlbw_by_mac[rm].conns += conns;
										}
										if (rip != '') {
											if (!nlbw_by_ip[rip]) nlbw_by_ip[rip] = { rx_bytes: 0, tx_bytes: 0, conns: 0 };
											nlbw_by_ip[rip].rx_bytes += rxb; nlbw_by_ip[rip].tx_bytes += txb; nlbw_by_ip[rip].conns += conns;
										}
									}
								}
							} catch (e) {}
						}
						reply_cb({
							ok: true,
							rules: rules,
							static_leases: static_leases,
							static_leases_list: static_leases_list,
							local_domains: local_domains,
							nlbw_by_mac: nlbw_by_mac,
							nlbw_by_ip: nlbw_by_ip,
							leases_raw: leases_raw,
							neigh4: n4.ok ? n4.output : '',
							neigh6: n6.ok ? n6.output : '',
							fdb_raw: fdb_raw,
							bridges: bridges,
							wifi_stations: wifi_stations,
							discovery_status: {
								neigh4: !!n4.ok,
								neigh6: !!n6.ok,
								fdb: fdb_ok,
								wifi: wifi_available,
								nlbw: nlbw_ok
							},
							br_netfilter: br_nf,
							flow_offloading: flow_offload
						});
					});
				};
				if (bridge_exe) {
					exec_argv_async(bridge_exe, ['fdb', 'show'], 4000, CAP_GENERAL, function(fdb_r) {
						finish_clients(fdb_r.ok ? fdb_r.output : '', !!fdb_r.ok);
					});
				} else {
