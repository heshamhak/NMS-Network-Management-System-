						entries: vr.entries,
						archive_b64: b64enc(raw_bytes)
					});
				});
			});
			return;
		}
		let allow_pkgs = ['system', 'network', 'dhcp', 'firewall', 'sqm', 'banip', 'upnpd', 'tailscale', 'dockerd'];
		let out_cfg = {};
		let cur = uci.cursor();
		for (let pkg in allow_pkgs) {
			let all = null;
			try { all = cur.get_all(pkg); } catch (e) { all = null; }
			if (type(all) != 'object') continue;
			let clean_pkg = {};
			for (let sid in keys(all)) {
				let sec = all[sid];
				if (type(sec) != 'object') continue;
				let clean_sec = {};
				for (let k in keys(sec)) {
					let lk = lc(k);
					if (index(lk, 'pass') >= 0 || index(lk, 'secret') >= 0 || index(lk, 'key') >= 0 || index(lk, 'token') >= 0 || index(lk, 'psk') >= 0) continue;
					let v = sec[k];
					if (type(v) == 'string') clean_sec[k] = scrub_prohibited(v);
					else if (type(v) == 'array') {
						let va = [];
						for (let item in v) push(va, scrub_prohibited(item));
						clean_sec[k] = va;
					} else clean_sec[k] = v;
				}
				clean_pkg[sid] = clean_sec;
			}
			out_cfg[pkg] = clean_pkg;
		}
		reply_cb({ ok: true, exported_at: now_iso(), configs: out_cfg });
		return;
