			audit_append(actor, 'wifi_scan', 'wlan0', 'ok', 'Scanned ' + length(list) + ' networks');
			reply_cb({ ok: true, results: list, message_ar: 'تم مسح الشبكات اللاسلكية المجاورة بنجاح' });
		});
