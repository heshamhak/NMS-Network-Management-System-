		let lines = [];
		for (let l in split(existing, '\n')) {
			let t = trim(l);
			if (t != '' && substr(t, 0, 1) != '#') push(lines, t);
		}
		if (verb == 'sys_cron_delete') {
			let idx = +(params.index != null ? params.index : -1);
			if (idx < 0 || idx >= length(lines)) { release_lock(); reply_cb({ ok: false, error_code: 'VALIDATION', message_ar: 'معرف المهمة غير صالح' }); return; }
			let next_l = [];
			for (let i = 0; i < length(lines); i++) if (i != idx) push(next_l, lines[i]);
			if (!atomic_write_or_reply(cpath, join('\n', next_l) + (length(next_l) > 0 ? '\n' : ''), 0o600, null, null, actor, 'sys_cron_delete', reply_cb)) return;
			exec_argv_async('/etc/init.d/cron', ['restart'], 6000, CAP_GENERAL, function() {
				release_lock();
				audit_append(actor, 'sys_cron_delete', '' + idx, 'committed', 'Removed scheduled job');
				reply_cb({ ok: true, message_ar: 'تم حذف المهمة المجدولة بنجاح' });
			});
			return;
		}
		let tid = trim(params.template_id || '');
		let tpl = CRON_TEMPLATES[tid];
		let sched = trim(params.schedule || '');
		let sf = split(sched, /\s+/);
		if (!tpl || length(sf) != 5) {
			release_lock();
			reply_cb({ ok: false, error_code: 'VALIDATION', message_ar: 'قالب المهمة أو تعبير التوقيت (5 خانات) غير صالح' });
			return;
		}
		for (let f in sf) {
			if (length(f) == 0 || length(f) > 16 || !match(f, /^[0-9*,/-]+$/)) {
				release_lock();
				reply_cb({ ok: false, error_code: 'VALIDATION', message_ar: 'صيغة التوقيت غير صالحة' });
				return;
			}
		}
		push(lines, sched + ' ' + tpl.exe + ' ' + tpl.arg);
		if (!atomic_write_or_reply(cpath, join('\n', lines) + '\n', 0o600, null, null, actor, 'sys_cron_add', reply_cb)) return;
		exec_argv_async('/etc/init.d/cron', ['restart'], 6000, CAP_GENERAL, function() {
			release_lock();
			audit_append(actor, 'sys_cron_add', tid, 'committed', sched);
			reply_cb({ ok: true, message_ar: 'تمت إضافة المهمة المجدولة وتفعيلها بنجاح' });
		});
		return;
	}

	if (verb == 'sys_ssh_save') {
