			if (kt == '' || substr(kt, 0, 1) == '#') continue;
			let kp = split(kt, /\s+/);
			if (length(kp) >= 2) {
				let fp = 'SHA256:' + substr(digest.sha256(kp[1]), 0, 22);
				push(ssh_keys, { index: k_idx, key_type: kp[0], fingerprint: fp, prefix: fp, comment: length(kp) >= 3 ? kp[2] : '' });
			}
			k_idx++;
		}
		let ssh_settings = {
			port: +(cur.get('dropbear', db_sid, 'Port') || 22),
			password_auth: cur.get('dropbear', db_sid, 'PasswordAuth') != 'off',
			root_password_auth: cur.get('dropbear', db_sid, 'RootPasswordAuth') != 'off',
			keys: ssh_keys
		};
		let cron_raw = fs.readfile('/etc/crontabs/root') || '';
		let cron_jobs = [];
		let c_idx = 0;
		for (let cl in split(cron_raw, '\n')) {
			let ct = trim(cl);
			if (ct != '' && substr(ct, 0, 1) != '#') push(cron_jobs, { index: c_idx, line: scrub_prohibited(ct) });
			c_idx++;
		}
		let cron_templates = [];
		for (let tid in keys(CRON_TEMPLATES)) push(cron_templates, { id: tid, label: CRON_TEMPLATES[tid].label });
		reply_cb({
			ok: true,
			services: out,
			system_settings: system_settings,
			ssh_settings: ssh_settings,
			cron_jobs: cron_jobs,
			cron_templates: cron_templates
		});
