		let err = is_blocked_diag_target(target, 'ping');
		if (err) { reply_cb({ ok: false, error_code: 'VALIDATION', message_ar: err }); return; }
		if (port < 1 || port > 65535 || port != int(port)) {
			reply_cb({ ok: false, error_code: 'VALIDATION', message_ar: 'رقم المنفذ غير صالح (1 إلى 65535)' });
			return;
		}
		let done = false;
		let t0 = now_mono_ms();
		let tmr = uloop.timer(4500, function() {
			if (done) return;
			done = true;
			audit_append(actor, 'diag_tcp_probe', target + ':' + port, 'timeout', 'TCP probe timed out');
			reply_cb({ ok: true, target: target, port: port, reachable: false, elapsed_ms: 4500, output: sprintf('TCP %s:%d -> انتهت مهلة الانتظار (Timeout 4500 ms)', target, port) });
		});
		let tsk = uloop.task(function() {
			let sa_p = sock.sockaddr({ address: target, port: port });
			if (!sa_p) return -1;
			let ps = sock.create(sock.AF_INET, sock.SOCK_STREAM);
			if (!ps) return -2;
			let conn = ps.connect(sa_p);
			try { ps.close(); } catch (e) {}
			return conn ? 1 : 0;
		}, function(rc) {
			if (done) return;
			done = true;
			tmr.cancel();
			let dt = now_mono_ms() - t0;
			let ok_r = (rc == 1);
			audit_append(actor, 'diag_tcp_probe', target + ':' + port, ok_r ? 'ok' : 'closed', dt + 'ms');
			reply_cb({
				ok: true, target: target, port: port, reachable: ok_r, elapsed_ms: dt,
				output: sprintf('TCP %s:%d -> %s (الزمن: %d ms)', target, port, ok_r ? 'المنفذ مفتوح ويستجيب' : (rc == -1 ? 'تعذر تحليل العنوان IPv4' : 'الاتصال مرفوض أو مغلق'), dt)
			});
		});
		if (!tsk) {
			done = true;
			tmr.cancel();
			reply_cb({ ok: false, error_code: 'INTERNAL', message_ar: 'تعذر بدء فحص المنفذ' });
		}
		return;
	}

	if (verb == 'diag_routes') {
		exec_argv_async('/sbin/ip', ['route', 'show'], 4000, CAP_GENERAL, function(rt_res) {
			let ct_raw = fs.readfile('/proc/net/nf_conntrack') || '';
			let counts = {};
			let total_ct = 0;
			if (ct_raw != '') {
				for (let line in split(ct_raw, '\n')) {
					let m = match(line, /src=(192\.168\.[0-9.]+)/);
					if (m) {
						counts[m[1]] = (counts[m[1]] || 0) + 1;
						total_ct++;
					}
					if (total_ct >= 6000) break;
				}
			}
			let ct_arr = [];
			for (let k in keys(counts)) push(ct_arr, { ip: k, c: counts[k] });
			sort(ct_arr, function(a, b) { return b.c - a.c; });
			let summary_lines = ['=== جدول التوجيه الفعلي (Routing Table) ===', scrub_prohibited(rt_res.output || ''), '', '=== أكثر الأجهزة استهلاكاً للاتصالات (Top Conntrack) ==='];
			for (let i = 0; i < length(ct_arr) && i < 12; i++) {
				push(summary_lines, sprintf('%s : %d جلسة نشطة', ct_arr[i].ip, ct_arr[i].c));
			}
			if (length(ct_arr) == 0) push(summary_lines, 'إجمالي الجلسات: ' + trim(fs.readfile('/proc/sys/net/netfilter/nf_conntrack_count') || '0'));
			reply_cb({ ok: true, output: join('\n', summary_lines) });
		});
		return;
	}

	if (verb == 'diag_ping') {
		let target = trim(params.target || '');
		let err = is_blocked_diag_target(target, 'ping');
		if (err) { reply_cb({ ok: false, error_code: 'VALIDATION', message_ar: err }); return; }
		exec_argv_async('/bin/ping', ['-c', '4', '-W', '2', target], 12000, CAP_GENERAL, function(r) {
			audit_append(actor, 'diag_ping', target, r.ok ? 'ok' : 'fail', r.overflow ? 'overflow' : 'done');
			if (r.overflow) { reply_cb({ ok: false, error_code: 'TIMEOUT', message_ar: 'تجاوزت مخرجات الفحص الحد المسموح' }); return; }
			reply_cb({ ok: true, target: target, output: scrub_prohibited(r.output) });
		});
		return;
	}

	if (verb == 'diag_traceroute') {
		let target = trim(params.target || '');
		let err = is_blocked_diag_target(target, 'traceroute');
		if (err) { reply_cb({ ok: false, error_code: 'VALIDATION', message_ar: err }); return; }
		exec_argv_async('/bin/traceroute', ['-I', '-n', '-m', '12', '-w', '1', '-q', '1', target], 25000, CAP_GENERAL, function(r) {
			audit_append(actor, 'diag_traceroute', target, r.ok ? 'ok' : 'fail', r.overflow ? 'overflow' : 'done');
			if (r.overflow) { reply_cb({ ok: false, error_code: 'TIMEOUT', message_ar: 'تجاوزت مخرجات تتبع المسار الحد المسموح' }); return; }
			reply_cb({ ok: true, target: target, output: scrub_prohibited(r.output) });
		});
		return;
	}

	if (verb == 'diag_nslookup') {
		let target = trim(params.target || '');
		let qtype = uc(trim(params.qtype || 'A'));
		let allowed_types = { 'A': true, 'AAAA': true, 'MX': true, 'TXT': true, 'NS': true, 'CNAME': true };
		if (!allowed_types[qtype]) {
			reply_cb({ ok: false, error_code: 'VALIDATION', message_ar: 'نوع استعلام DNS غير مسموح به (المسموح: A, AAAA, MX, TXT, NS, CNAME)' });
			return;
		}
		if (!match(target, /^[a-zA-Z0-9.-]{1,128}$/)) {
			reply_cb({ ok: false, error_code: 'VALIDATION', message_ar: 'اسم النطاق المستهدف غير صالح' });
			return;
		}
		exec_argv_async('/usr/bin/nslookup', ['-type=' + qtype, target, '127.0.0.1'], 8000, CAP_NSLOOKUP, function(r) {
			audit_append(actor, 'diag_nslookup', target + ' (' + qtype + ')', r.ok ? 'ok' : 'fail', r.overflow ? 'overflow' : 'done');
			if (r.overflow) { reply_cb({ ok: false, error_code: 'TIMEOUT', message_ar: 'تجاوزت استجابة NSLookup حد 16 KiB' }); return; }
			reply_cb({ ok: true, target: target, output: scrub_prohibited(r.output) });
		});
		return;
	}

	if (verb == 'log_read') {
		exec_argv_async('/sbin/logread', ['-l', '80'], 5000, CAP_GENERAL, function(r1) {
			exec_argv_async('/bin/dmesg', ['-s', '32768'], 5000, CAP_GENERAL, function(r2) {
				let dlines = r2.ok ? split(r2.output, '\n') : [];
				if (length(dlines) > 80) dlines = slice(dlines, length(dlines) - 80);
				let audit_lines = split(trim(fs.readfile(ETC_DIR + '/audit.log') || ''), '\n');
				let audit_slice = slice(audit_lines, -40);
				let audit_entries = [];
				for (let al in audit_slice) {
					if (trim(al) == '') continue;
					try { push(audit_entries, json(al)); } catch (e) {}
				}
				reply_cb({
					ok: !r1.overflow && !r2.overflow,
					error_code: (r1.overflow || r2.overflow) ? 'TIMEOUT' : null,
					syslog: scrub_prohibited(r1.output),
					dmesg: scrub_prohibited(join('\n', dlines)),
					audit_tail: scrub_prohibited(join('\n', audit_slice)),
					audit_entries: audit_entries
				});
			});
		});
		return;
	}

	// --- Mutating Verbs (Subject to P15 staging guard, P17 freeze, storage guard, & lock) ---
	let mutating_verbs = {
		'agh_add_rule': true, 'agh_remove_rule': true, 'agh_toggle': true, 'agh_set_creds': true,
		'agh_refresh_filters': true, 'agh_clear_querylog': true, 'agh_clear_cache': true,
		'agh_set_blocked_services': true, 'agh_rewrite_add': true, 'agh_rewrite_delete': true,
		'agh_filter_add': true, 'agh_filter_delete': true, 'agh_filter_toggle': true, 'agh_dns_config': true,
