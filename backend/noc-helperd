		let r = adguard_http('POST', ep, body);
		if (flag == 'protection_enabled') {
			if (r.ok && !enabled && duration_s > 0 && duration_s <= 3600) {
				if (!atomic_write_or_reply(ETC_DIR + '/timed_disable.json', sprintf('%J\n', { target_state: true, deadline_epoch: time() + duration_s }), 0o600, null, null, actor, 'agh_toggle', reply_cb)) return;
			} else if (enabled && fs.stat(ETC_DIR + '/timed_disable.json')) {
				fs.unlink(ETC_DIR + '/timed_disable.json');
			}
