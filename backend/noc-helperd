		audit_append(actor, 'agh_toggle', flag, r.ok ? 'committed' : 'failed', 'enabled=' + enabled);
		reply_cb(r.ok ? { ok: true, message_ar: 'تم تحديث حالة الحماية بنجاح' } : r);
