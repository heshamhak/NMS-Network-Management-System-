				enable_dnssec: flag == 'enable_dnssec' ? enabled : !!cfg.enable_dnssec,
				aaaa_disabled: flag == 'aaaa_disabled' ? enabled : !!cfg.aaaa_disabled,
				ratelimit: +(cfg.ratelimit || 0)
			};
			let rd = adguard_http('POST', '/control/dns_config', body_dns);
			release_lock();
			audit_append(actor, 'agh_toggle', flag, rd.ok ? 'committed' : 'failed', 'enabled=' + enabled);
			reply_cb(rd.ok ? { ok: true, message_ar: 'تم تحديث إعداد DNS بنجاح' } : rd);
			return;
		}
		let ep = null;
		let body = null;
		if (flag == 'protection_enabled') {
			ep = '/control/protection';
			body = { enabled: enabled };
		} else if (flag == 'parental_enabled') {
			ep = enabled ? '/control/parental/enable' : '/control/parental/disable';
			body = {};
		} else if (flag == 'safebrowsing_enabled') {
			ep = enabled ? '/control/safebrowsing/enable' : '/control/safebrowsing/disable';
			body = {};
		} else if (flag == 'safesearch_enabled') {
			ep = enabled ? '/control/safesearch/enable' : '/control/safesearch/disable';
