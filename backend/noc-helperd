			audit_append(actor, 'wifi_save_uplink', ssid, 'committed', 'Updated uplink station config');
			reply_cb({ ok: true, message_ar: 'تم تحديث إعدادات شبكة الارتباط اللاسلكية وإعادة التشغيل' });
		});
