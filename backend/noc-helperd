function fw_check_and_reload(snap_raw, cb) {
	exec_argv_async('/sbin/fw4', ['check'], 6000, CAP_GENERAL, function(chk) {
		if (!chk.ok) {
			if (snap_raw != null) {
				let aw = atomic_write('/etc/config/firewall', snap_raw, 0o644);
				let st_fw = fs.lstat('/etc/config/firewall');
				let cur_fw = fs.readfile('/etc/config/firewall');
				let fw_restored = aw.ok && st_fw && st_fw.type == 'file' && (st_fw.mode & 0o7777) == 0o644 && cur_fw == snap_raw;
				if (!fw_restored) {
					let fr = enter_emergency_freeze('fw_check_and_reload restore failed');
					audit_append('system', 'fw_check_and_reload', '/etc/config/firewall', 'rollback_failed', sprintf('aw_ok=%s error=%s tmp=%s freeze_persisted=%s', aw.ok ? '1' : '0', aw.error || '', aw.tmp_path || '', fr.freeze_persisted ? '1' : '0'));
					cb({
						ok: false,
						error_code: 'INTERNAL',
						rolled_back: false,
						rollback_failed: true,
						freeze_persisted: fr.freeze_persisted,
						freeze_persist_failed: fr.freeze_persist_failed,
						cleanup_failed: !!aw.cleanup_failed,
						tmp_path: aw.cleanup_failed ? (aw.tmp_path || '') : '',
						message_ar: fr.freeze_persist_failed
							? 'فشل حرج: فشل فحص fw4 وفشل استعادة الجدار الناري وفشل حفظ freeze.json — تم تفعيل التجميد بالذاكرة'
							: 'فشل حرج: فشل فحص قواعد fw4 وفشل استعادة /etc/config/firewall — تم تجميد التعديلات'
					});
					return;
				}
				audit_append('system', 'fw_check_and_reload', '/etc/config/firewall', 'rolled_back', 'fw4 check failed; firewall config restored and verified');
				cb({ ok: false, error_code: 'VALIDATION', rolled_back: true, message_ar: 'فشل فحص قواعد fw4 وتم التراجع التلقائي' });
				return;
			}
			cb({ ok: false, error_code: 'VALIDATION', rolled_back: false, message_ar: 'فشل فحص قواعد fw4 دون توفر نسخة احتياطية للاستعادة' });
			return;
		}
		exec_argv_async('/etc/init.d/firewall', ['reload'], 12000, CAP_GENERAL, cb);
	});
}

function handle_sys_sysupgrade_conf_save(params, actor, reply_cb) {
	let raw_paths = params.paths;
	if (type(raw_paths) != 'array' || length(raw_paths) > 128) {
		release_lock();
		reply_cb({ ok: false, error_code: 'VALIDATION', message_ar: 'قائمة مسارات sysupgrade.conf غير صالحة' });
		return;
	}
	let seen = {};
	let clean_paths = [];
	for (let item in raw_paths) {
		let p = trim('' + item);
		if (p == '' || substr(p, 0, 1) == '#') continue;
		if (!nms_archive.is_safe_sysupgrade_path(p)) {
			release_lock();
			reply_cb({ ok: false, error_code: 'VALIDATION', message_ar: 'مسار غير مسموح به في sysupgrade.conf: ' + p });
			return;
		}
		if (!seen[p]) {
			seen[p] = true;
			push(clean_paths, p);
		}
	}
	let st_orig = fs.lstat(SYSUPGRADE_CONF_PATH);
	if (st_orig && st_orig.type != 'file') {
		release_lock();
		reply_cb({ ok: false, error_code: 'FORBIDDEN', message_ar: 'مرفوض: ملف sysupgrade.conf ليس ملفاً عادياً' });
		return;
	}
	let existing_raw = '';
	if (st_orig) {
		existing_raw = fs.readfile(SYSUPGRADE_CONF_PATH);
		if (existing_raw == null) {
			release_lock();
			audit_append(actor, 'sys_sysupgrade_conf_save', SYSUPGRADE_CONF_PATH, 'failed', 'Failed to read existing sysupgrade.conf');
			reply_cb({ ok: false, error_code: 'INTERNAL', message_ar: 'تعذر قراءة ملف sysupgrade.conf الأصلي — تم الإيقاف لحماية المحتوى الأصلي' });
			return;
		}
	}
	let orig_mode = st_orig ? (st_orig.mode & 0o7777) : 0o644;
	let orig_uid = st_orig ? st_orig.uid : null;
	let orig_gid = st_orig ? st_orig.gid : null;
	let body_txt = nms_archive.merge_sysupgrade_conf(existing_raw, clean_paths);
	if (!atomic_write_or_reply(SYSUPGRADE_CONF_PATH, body_txt, orig_mode, orig_uid, orig_gid, actor, 'sys_sysupgrade_conf_save', reply_cb)) {
		return;
	}
	let st_new = fs.lstat(SYSUPGRADE_CONF_PATH);
	let verify_txt = fs.readfile(SYSUPGRADE_CONF_PATH);
	if (!st_new || st_new.type != 'file' || (st_new.mode & 0o7777) != orig_mode ||
	    (orig_uid != null && (st_new.uid != orig_uid || st_new.gid != orig_gid)) ||
	    verify_txt != body_txt) {
		let rb_ok = false;
		if (st_orig) {
			let rb_aw = atomic_write(SYSUPGRADE_CONF_PATH, existing_raw, orig_mode, orig_uid, orig_gid);
			let st_rb = fs.lstat(SYSUPGRADE_CONF_PATH);
			let rb_txt = fs.readfile(SYSUPGRADE_CONF_PATH);
			rb_ok = rb_aw.ok && st_rb && st_rb.type == 'file' && (st_rb.mode & 0o7777) == orig_mode &&
				(orig_uid == null || (st_rb.uid == orig_uid && st_rb.gid == orig_gid)) &&
				rb_txt == existing_raw;
		} else {
			if (!fs.stat(SYSUPGRADE_CONF_PATH) || fs.unlink(SYSUPGRADE_CONF_PATH)) {
				rb_ok = !fs.stat(SYSUPGRADE_CONF_PATH);
			}
		}
		release_lock();
		if (rb_ok) {
			audit_append(actor, 'sys_sysupgrade_conf_save', SYSUPGRADE_CONF_PATH, 'rolled_back', 'Post-write verification failed; original restored');
			reply_cb({ ok: false, error_code: 'INTERNAL', rolled_back: true, message_ar: 'فشل التحقق النهائي من ملف sysupgrade.conf وتمت استعادة النسخة الأصلية بنجاح' });
		} else {
			audit_append(actor, 'sys_sysupgrade_conf_save', SYSUPGRADE_CONF_PATH, 'rollback_failed', 'CRITICAL: post-write verification and rollback both failed');
			reply_cb({ ok: false, error_code: 'INTERNAL', rolled_back: false, rollback_failed: true, message_ar: 'فشل حرج: فشل التحقق النهائي وفشل التراجع عن sysupgrade.conf' });
		}
		return;
	}
	release_lock();
	audit_append(actor, 'sys_sysupgrade_conf_save', SYSUPGRADE_CONF_PATH, 'committed', 'entries=' + length(clean_paths));
	reply_cb({ ok: true, path: SYSUPGRADE_CONF_PATH, entries: clean_paths, count: length(clean_paths), message_ar: 'تم حفظ إعدادات sysupgrade.conf بأمان مع الحفاظ على التعليقات' });
}

function handle_rollback_revert(base, meta, actor, reply_cb) {
	let bak = fs.readfile(base + '.bak');
	if (bak == null || !meta.cfg_path) {
		release_lock();
		audit_append(actor, 'rollback_revert', meta.kind || 'config', 'rollback_failed', 'Missing backup payload or target path');
		reply_cb({ ok: false, error_code: 'INTERNAL', rollback_failed: true, message_ar: 'فشل التراجع: تعذر قراءة النسخة الاحتياطية (تم الإبقاء على ملفات الاستعادة)' });
		return;
	}
	let aw = atomic_write(meta.cfg_path, bak, 0o644);
	if (!aw.ok) {
		release_lock();
		audit_append(actor, 'rollback_revert', meta.kind || 'config', 'rollback_failed', sprintf('error=%s orig=%s tmp=%s', aw.error || '', aw.orig_error || '', aw.tmp_path || ''));
		reply_cb({ ok: false, error_code: 'INTERNAL', rollback_failed: true, error: aw.error || 'write_failed', orig_error: aw.orig_error || '', cleanup_failed: !!aw.cleanup_failed, tmp_path: aw.cleanup_failed ? (aw.tmp_path || '') : '', message_ar: 'فشل التراجع أثناء كتابة الملف (تم الإبقاء على ملفات الاستعادة)' });
		return;
	}
	let st_rb_cfg = fs.lstat(meta.cfg_path);
	let cur_rb_cfg = fs.readfile(meta.cfg_path);
	if (!st_rb_cfg || st_rb_cfg.type != 'file' || (st_rb_cfg.mode & 0o7777) != 0o644 || cur_rb_cfg != bak) {
		release_lock();
		audit_append(actor, 'rollback_revert', meta.kind || 'config', 'rollback_failed', 'Post-restore verification failed');
		reply_cb({ ok: false, error_code: 'INTERNAL', rollback_failed: true, message_ar: 'فشل التحقق بعد التراجع (تم الإبقاء على ملفات الاستعادة)' });
		return;
	}
	if (meta.reload_cmd) system(meta.reload_cmd + ' >/dev/null 2>&1');
	fs.unlink(base + '.pending');
	fs.unlink(base + '.bak');
	release_lock();
	audit_append(actor, 'rollback_revert', meta.kind || 'config', 'committed', 'Reverted pending change');
	reply_cb({ ok: true, message_ar: 'تم التراجع عن التغيير واستعادة الإعداد السابق بنجاح' });
}

function array_eq(a, b) {
	let aa = type(a) == 'array' ? a : [];
	let bb = type(b) == 'array' ? b : [];
	if (length(aa) != length(bb)) return false;
	for (let i = 0; i < length(aa); i++) {
		if (('' + aa[i]) != ('' + bb[i])) return false;
	}
	return true;
}

function handle_network_phase3b_verb(verb, params, actor, reply_cb, net_env) {
	let env = net_env || {};
	let cfg_dir = env.cfg_dir || '/etc/config';
	let uci_dir = env.uci_dir || null;
	let cfg_paths = verb == 'network_ipv6_save' ? [cfg_dir + '/network', cfg_dir + '/dhcp'] : [cfg_dir + '/network'];
	let target_id = trim('' + (params.name || params.id || params.device || params.interface || 'network'));

	if (verb == 'network_interface_save') {
		let v = nms_network.validate_interface_cfg(params);
		if (!v.ok) { release_lock(); reply_cb({ ok: false, error_code: 'VALIDATION', message_ar: v.error }); return; }
	} else if (verb == 'network_interface_delete') {
		let nm = trim('' + (params.name || ''));
		if (!nms_network.is_valid_ifname(nm) || nm == 'loopback' || nm == 'lan' || nm == 'wan') {
			release_lock();
			reply_cb({ ok: false, error_code: 'FORBIDDEN', message_ar: 'لا يُسمح بحذف الواجهات الأساسية (loopback/lan/wan)' });
			return;
		}
	} else if (verb == 'network_device_save') {
		let v = nms_network.validate_device_cfg(params);
		if (!v.ok) { release_lock(); reply_cb({ ok: false, error_code: 'VALIDATION', message_ar: v.error }); return; }
	} else if (verb == 'network_bridge_vlan_save') {
		let v = nms_network.validate_bridge_vlan_cfg(params);
		if (!v.ok) { release_lock(); reply_cb({ ok: false, error_code: 'VALIDATION', message_ar: v.error }); return; }
	} else if (verb == 'network_bridge_vlan_delete') {
		let sid = trim('' + (params.id || ''));
		if (!match(sid, /^[a-zA-Z0-9_-]+$/)) {
			release_lock();
			reply_cb({ ok: false, error_code: 'VALIDATION', message_ar: 'معرف Bridge-VLAN غير صالح' });
			return;
		}
	} else if (verb == 'network_ipv6_save') {
		let v = nms_network.validate_ipv6_dhcp_cfg(params);
		if (!v.ok) { release_lock(); reply_cb({ ok: false, error_code: 'VALIDATION', message_ar: v.error }); return; }
	}

	let expected_sid = '';
	let tx_res = nms_network.apply_network_tx(cfg_paths, {
		stat: fs.stat,
		lstat: fs.lstat,
		readfile: env.readfile || fs.readfile,
		unlink: fs.unlink,
		aw_ops: env.aw_ops || {
			suffix: function() { return now_mono_ms() + '.' + urandom_hex(4); },
			stat: fs.stat, unlink: fs.unlink, open: fs.open,
			writefile: fs.writefile, chown: fs.chown, chmod: fs.chmod, rename: fs.rename
		},
		apply_uci: function() {
			if (env.inject_apply_fail_before) return { ok: false, error: 'Injected failure before commit' };
			try {
				let cur = uci_dir ? uci.cursor(uci_dir) : uci.cursor();
				if (verb == 'network_interface_save') {
					let nm = trim('' + params.name);
					expected_sid = nm;
					cur.set('network', nm, 'interface');
					cur.set('network', nm, 'proto', trim('' + params.proto));
					if (params.device) cur.set('network', nm, 'device', trim('' + params.device));
					if (params.ipaddr) cur.set('network', nm, 'ipaddr', trim('' + params.ipaddr));
					if (params.netmask) cur.set('network', nm, 'netmask', trim('' + params.netmask));
					if (params.gateway) cur.set('network', nm, 'gateway', trim('' + params.gateway));
					if (params.ip6assign != null && params.ip6assign != '') cur.set('network', nm, 'ip6assign', '' + int(+params.ip6assign));
					if (params.ip6addr) cur.set('network', nm, 'ip6addr', trim('' + params.ip6addr));
					if (params.ip6gw) cur.set('network', nm, 'ip6gw', trim('' + params.ip6gw));
					if (params.mtu != null && params.mtu != '') cur.set('network', nm, 'mtu', '' + int(+params.mtu));
					if (params.metric != null && params.metric != '') cur.set('network', nm, 'metric', '' + int(+params.metric));
					if (params.dns != null) cur.set('network', nm, 'dns', params.dns);
					cur.commit('network');
				} else if (verb == 'network_interface_delete') {
					let nm = trim('' + params.name);
					expected_sid = nm;
					if (cur.get('network', nm) != 'interface') return { ok: false, error: 'الواجهة غير موجودة' };
					cur.delete('network', nm);
					cur.commit('network');
				} else if (verb == 'network_device_save') {
					let dname = trim('' + params.name);
					let sid = null;
					cur.foreach('network', 'device', function(s) {
						if (s.name == dname || s['.name'] == dname) { sid = s['.name']; return false; }
					});
					if (!sid) sid = 'dev_' + replace(dname, /[^a-zA-Z0-9_]/g, '_');
					expected_sid = sid;
					cur.set('network', sid, 'device');
					cur.set('network', sid, 'name', dname);
					cur.set('network', sid, 'type', trim('' + (params.type || 'bridge')));
					if (params.type == 'bridge' || !params.type) cur.set('network', sid, 'ports', params.ports);
					else {
						cur.set('network', sid, 'ifname', trim('' + params.ifname));
						cur.set('network', sid, 'vid', '' + int(+params.vid));
					}
					if (params.mtu != null && params.mtu != '') cur.set('network', sid, 'mtu', '' + int(+params.mtu));
					cur.set('network', sid, 'igmp_snooping', params.igmp_snooping ? '1' : '0');
					cur.commit('network');
				} else if (verb == 'network_bridge_vlan_save') {
					let dev = trim('' + (params.device || 'br-lan'));
					let vid = int(+params.vlan);
					let sid = trim('' + (params.id || ''));
					if (sid == '') {
						cur.foreach('network', 'bridge-vlan', function(s) {
							if ((s.device || 'br-lan') == dev && +(s.vlan || 0) == vid) { sid = s['.name']; return false; }
						});
					}
					if (sid == '') sid = 'bv_' + replace(dev, /[^a-zA-Z0-9_]/g, '_') + '_' + vid;
					expected_sid = sid;
					cur.set('network', sid, 'bridge-vlan');
					cur.set('network', sid, 'device', dev);
					cur.set('network', sid, 'vlan', '' + vid);
					cur.set('network', sid, 'ports', params.ports);
					cur.commit('network');
				} else if (verb == 'network_bridge_vlan_delete') {
					let sid = trim('' + params.id);
					expected_sid = sid;
					if (cur.get('network', sid) != 'bridge-vlan') return { ok: false, error: 'قسم Bridge-VLAN غير موجود' };
					cur.delete('network', sid);
					cur.commit('network');
				} else if (verb == 'network_ipv6_save') {
					let iface = trim('' + (params.interface || 'lan'));
					expected_sid = iface;
					if (params.ula_prefix != null && trim('' + params.ula_prefix) != '') {
						cur.set('network', 'globals', 'ula_prefix', trim('' + params.ula_prefix));
						cur.commit('network');
					}
					if (env.inject_apply_fail_mid_ipv6) return { ok: false, error: 'Injected failure after network commit before dhcp commit' };
					cur.set('dhcp', iface, 'ra', trim('' + (params.ra || 'server')));
					cur.set('dhcp', iface, 'dhcpv6', trim('' + (params.dhcpv6 || 'server')));
					cur.set('dhcp', iface, 'ndp', trim('' + (params.ndp || 'disabled')));
					if (params.ra_management != null && params.ra_management != '') cur.set('dhcp', iface, 'ra_management', '' + int(+params.ra_management));
					if (params.ra_default != null && params.ra_default != '') cur.set('dhcp', iface, 'ra_default', '' + int(+params.ra_default));
					cur.set('dhcp', iface, 'ra_slaac', params.ra_slaac !== false ? '1' : '0');
					if (params.ra_flags != null) cur.set('dhcp', iface, 'ra_flags', params.ra_flags);
					if (params.dns != null) cur.set('dhcp', iface, 'dns', params.dns);
					cur.commit('dhcp');
				}
				return { ok: true };
			} catch (e) {
				return { ok: false, error: 'فشل تحديث UCI للشبكة' };
			}
		},
		validate_config: env.validate_fn || function() {
			let rc = system('/sbin/uci -q show network >/dev/null 2>&1');
			if (rc != 0) return { ok: false, error: 'فشل التحقق من بنية UCI للشبكة' };
			if (verb == 'network_ipv6_save' && system('/sbin/uci -q show dhcp >/dev/null 2>&1') != 0) {
				return { ok: false, error: 'فشل التحقق من بنية UCI لـ DHCP/IPv6' };
			}
			return { ok: true };
		},
		reload_service: env.reload_fn || function() {
			let rc = system('/etc/init.d/network reload >/dev/null 2>&1');
			if (rc != 0) return { ok: false, error: 'فشل إعادة تحميل /etc/init.d/network' };
			if (verb == 'network_ipv6_save' && fs.stat('/etc/init.d/odhcpd')) {
				if (system('/etc/init.d/odhcpd reload >/dev/null 2>&1') != 0) {
					return { ok: false, error: 'فشل إعادة تحميل /etc/init.d/odhcpd' };
				}
			}
			return { ok: true };
		},
		verify_applied: function() {
			let cv = uci_dir ? uci.cursor(uci_dir) : uci.cursor();
			if (verb == 'network_interface_save') {
				if (cv.get('network', expected_sid) != 'interface') return { ok: false, error: 'الواجهة غير موجودة بعد التطبيق' };
				if (cv.get('network', expected_sid, 'proto') != trim('' + params.proto)) return { ok: false, error: 'عدم تطابق proto بعد التطبيق' };
				if (params.device && cv.get('network', expected_sid, 'device') != trim('' + params.device)) return { ok: false, error: 'عدم تطابق device بعد التطبيق' };
				if (params.ipaddr && cv.get('network', expected_sid, 'ipaddr') != trim('' + params.ipaddr)) return { ok: false, error: 'عدم تطابق ipaddr بعد التطبيق' };
				if (params.netmask && cv.get('network', expected_sid, 'netmask') != trim('' + params.netmask)) return { ok: false, error: 'عدم تطابق netmask بعد التطبيق' };
				if (params.gateway && cv.get('network', expected_sid, 'gateway') != trim('' + params.gateway)) return { ok: false, error: 'عدم تطابق gateway بعد التطبيق' };
				if (params.ip6assign != null && params.ip6assign != '' && cv.get('network', expected_sid, 'ip6assign') != ('' + int(+params.ip6assign))) return { ok: false, error: 'عدم تطابق ip6assign بعد التطبيق' };
				if (params.ip6addr && cv.get('network', expected_sid, 'ip6addr') != trim('' + params.ip6addr)) return { ok: false, error: 'عدم تطابق ip6addr بعد التطبيق' };
				if (params.ip6gw && cv.get('network', expected_sid, 'ip6gw') != trim('' + params.ip6gw)) return { ok: false, error: 'عدم تطابق ip6gw بعد التطبيق' };
				if (params.mtu != null && params.mtu != '' && cv.get('network', expected_sid, 'mtu') != ('' + int(+params.mtu))) return { ok: false, error: 'عدم تطابق mtu بعد التطبيق' };
				if (params.metric != null && params.metric != '' && cv.get('network', expected_sid, 'metric') != ('' + int(+params.metric))) return { ok: false, error: 'عدم تطابق metric بعد التطبيق' };
				if (params.dns != null && !array_eq(cv.get('network', expected_sid, 'dns'), params.dns)) return { ok: false, error: 'عدم تطابق dns بعد التطبيق' };
			} else if (verb == 'network_interface_delete') {
				if (cv.get('network', expected_sid) != null) return { ok: false, error: 'الواجهة ما زالت موجودة بعد الحذف' };
			} else if (verb == 'network_device_save') {
				if (cv.get('network', expected_sid) != 'device') return { ok: false, error: 'الجهاز غير موجود بعد التطبيق' };
				if (cv.get('network', expected_sid, 'name') != trim('' + params.name)) return { ok: false, error: 'عدم تطابق اسم الجهاز بعد التطبيق' };
				if (cv.get('network', expected_sid, 'type') != trim('' + (params.type || 'bridge'))) return { ok: false, error: 'عدم تطابق نوع الجهاز بعد التطبيق' };
				if (params.type == 'bridge' || !params.type) {
					if (!array_eq(cv.get('network', expected_sid, 'ports'), params.ports)) return { ok: false, error: 'عدم تطابق منافذ الجسر بعد التطبيق' };
				} else {
					if (cv.get('network', expected_sid, 'ifname') != trim('' + params.ifname)) return { ok: false, error: 'عدم تطابق ifname للجهاز بعد التطبيق' };
					if (cv.get('network', expected_sid, 'vid') != ('' + int(+params.vid))) return { ok: false, error: 'عدم تطابق VLAN ID للجهاز بعد التطبيق' };
				}
				if (params.mtu != null && params.mtu != '' && cv.get('network', expected_sid, 'mtu') != ('' + int(+params.mtu))) return { ok: false, error: 'عدم تطابق mtu للجهاز بعد التطبيق' };
				if (cv.get('network', expected_sid, 'igmp_snooping') != (params.igmp_snooping ? '1' : '0')) return { ok: false, error: 'عدم تطابق igmp_snooping للجهاز بعد التطبيق' };
			} else if (verb == 'network_bridge_vlan_save') {
				if (cv.get('network', expected_sid) != 'bridge-vlan') return { ok: false, error: 'قسم bridge-vlan غير موجود بعد التطبيق' };
				if (cv.get('network', expected_sid, 'device') != trim('' + (params.device || 'br-lan'))) return { ok: false, error: 'عدم تطابق جسر bridge-vlan' };
				if (cv.get('network', expected_sid, 'vlan') != ('' + int(+params.vlan))) return { ok: false, error: 'عدم تطابق رقم vlan' };
				if (!array_eq(cv.get('network', expected_sid, 'ports'), params.ports)) return { ok: false, error: 'عدم تطابق منافذ DSA بعد التطبيق' };
			} else if (verb == 'network_bridge_vlan_delete') {
				if (cv.get('network', expected_sid) != null) return { ok: false, error: 'قسم bridge-vlan ما زال موجوداً بعد الحذف' };
			} else if (verb == 'network_ipv6_save') {
				if (params.ula_prefix != null && trim('' + params.ula_prefix) != '') {
					if (cv.get('network', 'globals', 'ula_prefix') != trim('' + params.ula_prefix)) return { ok: false, error: 'عدم تطابق ula_prefix في network' };
				}
				if (cv.get('dhcp', expected_sid, 'ra') != trim('' + (params.ra || 'server'))) return { ok: false, error: 'عدم تطابق ra في dhcp' };
				if (cv.get('dhcp', expected_sid, 'dhcpv6') != trim('' + (params.dhcpv6 || 'server'))) return { ok: false, error: 'عدم تطابق dhcpv6 في dhcp' };
				if (cv.get('dhcp', expected_sid, 'ndp') != trim('' + (params.ndp || 'disabled'))) return { ok: false, error: 'عدم تطابق ndp في dhcp' };
				if (params.ra_management != null && params.ra_management != '' && cv.get('dhcp', expected_sid, 'ra_management') != ('' + int(+params.ra_management))) return { ok: false, error: 'عدم تطابق ra_management في dhcp' };
				if (params.ra_default != null && params.ra_default != '' && cv.get('dhcp', expected_sid, 'ra_default') != ('' + int(+params.ra_default))) return { ok: false, error: 'عدم تطابق ra_default في dhcp' };
				if (cv.get('dhcp', expected_sid, 'ra_slaac') != (params.ra_slaac !== false ? '1' : '0')) return { ok: false, error: 'عدم تطابق ra_slaac في dhcp' };
				if (params.ra_flags != null && !array_eq(cv.get('dhcp', expected_sid, 'ra_flags'), params.ra_flags)) return { ok: false, error: 'عدم تطابق ra_flags في dhcp' };
				if (params.dns != null && !array_eq(cv.get('dhcp', expected_sid, 'dns'), params.dns)) return { ok: false, error: 'عدم تطابق dns IPv6 في dhcp' };
			}
			return { ok: true };
		},
		on_rollback_failed: function(reason) {
			return enter_emergency_freeze(reason);
		}
	});
	release_lock();
	audit_append(actor, verb, target_id, tx_res.ok ? 'committed' : (tx_res.rollback_failed ? 'rollback_failed' : 'rolled_back'), tx_res.message_ar || '');
	reply_cb(tx_res);
}

function handle_phase3c_verb(verb, params, actor, reply_cb, p3c_env) {
	let env = p3c_env || {};
	let cfg_dir = env.cfg_dir || '/etc/config';
	let uci_dir = env.uci_dir || null;
	let is_fw = index(verb, 'fw_') == 0;
	let cfg_paths = is_fw ? [cfg_dir + '/firewall'] : [cfg_dir + '/wireless'];
	let target_id = trim('' + (params.name || params.id || params.radio || params.src || 'phase3c'));

	let resolved_phy = '';
	if (verb == 'fw_zone_save') {
		let v = nms_fw_wifi.validate_fw_zone_cfg(params);
		if (!v.ok) { release_lock(); reply_cb({ ok: false, error_code: 'VALIDATION', message_ar: v.error }); return; }
	} else if (verb == 'fw_zone_delete') {
		let nm = trim('' + (params.name || ''));
		if (!nms_fw_wifi.is_valid_zone_name(nm) || nm == 'lan' || nm == 'wan') {
			release_lock();
			reply_cb({ ok: false, error_code: 'FORBIDDEN', message_ar: 'مرفوض: لا يُسمح بحذف مناطق lan أو wan الأساسية' });
			return;
		}
	} else if (verb == 'fw_forwarding_save') {
		let v = nms_fw_wifi.validate_fw_forwarding_cfg(params);
		if (!v.ok) { release_lock(); reply_cb({ ok: false, error_code: 'VALIDATION', message_ar: v.error }); return; }
	} else if (verb == 'fw_forwarding_delete') {
		let sid = trim('' + (params.id || ''));
