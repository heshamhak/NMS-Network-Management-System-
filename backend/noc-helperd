		for (let l in split(ak_raw, '\n')) {
			let t = trim(l);
			if (t != '' && substr(t, 0, 1) != '#') key_cnt++;
		}
		if ((pauth == 'off' || rpauth == 'off') && key_cnt == 0) {
			release_lock();
			reply_cb({ ok: false, error_code: 'FORBIDDEN', message_ar: 'مرفوض: لا يُسمح بتعطيل الدخول بكلمة المرور لعدم وجود مفاتيح SSH مصرح بها' });
			return;
		}
		let cur = uci.cursor();
		let db_sid = 'main';
		cur.foreach('dropbear', 'dropbear', function(s) { db_sid = s['.name']; return false; });
		cur.set('dropbear', db_sid, 'PasswordAuth', pauth);
		cur.set('dropbear', db_sid, 'RootPasswordAuth', rpauth);
		cur.commit('dropbear');
		exec_argv_async('/etc/init.d/dropbear', ['reload'], 6000, CAP_GENERAL, function() {
			release_lock();
			audit_append(actor, 'sys_ssh_save', 'dropbear', 'committed', sprintf('pw=%s rootpw=%s', pauth, rpauth));
			reply_cb({ ok: true, message_ar: 'تم تحديث إعدادات خادم SSH بنجاح' });
		});
		return;
	}

	if (verb == 'sys_ssh_key_add' || verb == 'sys_ssh_key_delete') {
		let ak_path = '/etc/dropbear/authorized_keys';
		let raw = fs.readfile(ak_path) || '';
		let lines = [];
		for (let l in split(raw, '\n')) {
			let t = trim(l);
			if (t != '' && substr(t, 0, 1) != '#') push(lines, t);
		}
		if (verb == 'sys_ssh_key_delete') {
			let cur = uci.cursor();
			let db_sid = 'main';
			cur.foreach('dropbear', 'dropbear', function(s) { db_sid = s['.name']; return false; });
			let pauth_on = cur.get('dropbear', db_sid, 'PasswordAuth') != 'off';
			if (!pauth_on && length(lines) <= 1) {
				release_lock();
				reply_cb({ ok: false, error_code: 'FORBIDDEN', message_ar: 'مرفوض: لا يمكن حذف آخر مفتاح SSH أثناء تعطيل الدخول بكلمة المرور' });
				return;
			}
			let idx = +(params.index != null ? params.index : -1);
			if (idx < 0 || idx >= length(lines)) { release_lock(); reply_cb({ ok: false, error_code: 'VALIDATION', message_ar: 'معرف المفتاح غير صالح' }); return; }
			let next_l = [];
			for (let i = 0; i < length(lines); i++) if (i != idx) push(next_l, lines[i]);
			if (!atomic_write_or_reply(ak_path, join('\n', next_l) + (length(next_l) > 0 ? '\n' : ''), 0o600, null, null, actor, 'sys_ssh_key_delete', reply_cb)) return;
			release_lock();
			audit_append(actor, 'sys_ssh_key_delete', '' + idx, 'committed', 'Deleted authorized SSH key');
			reply_cb({ ok: true, message_ar: 'تم حذف مفتاح SSH بنجاح' });
			return;
		}
		let kp = split(trim(params.public_key || ''), /\s+/);
		let allow_kt = { 'ssh-ed25519': true, 'ecdsa-sha2-nistp256': true, 'ecdsa-sha2-nistp384': true, 'ecdsa-sha2-nistp521': true, 'ssh-rsa': true };
		if (length(kp) < 2 || !allow_kt[kp[0]] || !match(kp[1], /^[A-Za-z0-9+/=]+$/) || length(kp[1]) < 40 || length(kp[1]) > 2048 || (kp[0] == 'ssh-rsa' && length(kp[1]) < 500)) {
			release_lock();
			reply_cb({ ok: false, error_code: 'VALIDATION', message_ar: 'صيغة المفتاح العام غير صالحة (المقبول: ed25519 أو ecdsa أو rsa >= 3072-bit بدون خيارات)' });
			return;
		}
		let cmt = length(kp) >= 3 ? replace(kp[2], /[^a-zA-Z0-9._@-]/g, '') : 'noc-key';
		let norm_line = kp[0] + ' ' + kp[1] + (cmt != '' ? (' ' + cmt) : '');
		for (let ex in lines) {
			if (index(ex, kp[1]) >= 0) { release_lock(); reply_cb({ ok: true, message_ar: 'المفتاح مضاف مسبقاً' }); return; }
		}
		push(lines, norm_line);
		if (!atomic_write_or_reply(ak_path, join('\n', lines) + '\n', 0o600, null, null, actor, 'sys_ssh_key_add', reply_cb)) return;
		release_lock();
		audit_append(actor, 'sys_ssh_key_add', cmt, 'committed', kp[0]);
		reply_cb({ ok: true, message_ar: 'تمت إضافة المفتاح العام إلى authorized_keys بنجاح' });
		return;
	}

	if (verb == 'sys_pkg_action') {
		let op = trim(params.op || '');
		let pkg = trim(params.package || '');
		let allow_ops = { 'update': true, 'check_upgrades': true, 'install': true, 'upgrade': true, 'del': true };
		if (!allow_ops[op]) {
			release_lock();
			reply_cb({ ok: false, error_code: 'VALIDATION', message_ar: 'عملية إدارة الحزم غير مدعومة' });
			return;
		}
		if (op == 'install' || op == 'upgrade' || op == 'del') {
			if (pkg == '' || length(pkg) > 64 || substr(pkg, 0, 1) == '-' || !match(pkg, /^[a-zA-Z0-9._+-]+$/)) {
				release_lock();
				reply_cb({ ok: false, error_code: 'VALIDATION', message_ar: 'اسم الحزمة البرمجية غير صالح' });
				return;
			}
			let protected_pkgs = {
				'base-files': true, 'busybox': true, 'ucode': true, 'dropbear': true, 'uhttpd': true,
				'dnsmasq': true, 'firewall4': true, 'nftables': true, 'apk-mbedtls': true, 'opkg': true,
				'kernel': true, 'libc': true, 'netifd': true, 'procd': true, 'ubus': true, 'uci': true
			};
			if (op == 'del' && (protected_pkgs[pkg] || index(pkg, 'ucode-mod-') == 0 || index(pkg, 'kmod-') == 0)) {
				release_lock();
				audit_append(actor, 'sys_pkg_action', 'del:' + pkg, 'refused', 'Protected system package removal refused');
				reply_cb({ ok: false, error_code: 'FORBIDDEN', message_ar: 'مرفوض: لا يُسمح بحذف الحزم الأساسية للنظام أو وحدات النواة' });
				return;
			}
		}
		let mgr = detect_pkg_manager();
		if (mgr.manager == 'none') {
			release_lock();
			reply_cb({ ok: false, error_code: 'UNSUPPORTED', pkg_manager: 'none', message_ar: 'لم يتم العثور على مدير حزم مدعوم (apk أو opkg)' });
			return;
		}
		let argv = [];
		if (mgr.manager == 'apk') {
			if (op == 'update') argv = ['update'];
			else if (op == 'check_upgrades') argv = ['upgrade', '-s'];
			else if (op == 'install') argv = ['add', pkg];
			else if (op == 'upgrade') argv = ['upgrade', pkg];
			else if (op == 'del') argv = ['del', pkg];
		} else {
			if (op == 'update') argv = ['update'];
			else if (op == 'check_upgrades') argv = ['list-upgradable'];
			else if (op == 'install') argv = ['install', pkg];
			else if (op == 'upgrade') argv = ['upgrade', pkg];
			else if (op == 'del') argv = ['remove', pkg];
		}

		exec_argv_async(mgr.bin, argv, 25000, 262144, function(r) {
			release_lock();
			let clean_out = scrub_prohibited(r.output || '');
			audit_append(actor, 'sys_pkg_' + op, pkg || 'repositories', r.ok ? 'committed' : 'failed', substr(replace(clean_out, /\s+/g, ' '), 0, 120));
			reply_cb({
				ok: r.ok,
				pkg_manager: mgr.manager,
				op: op,
				package: pkg,
				output: clean_out != '' ? clean_out : (r.ok ? 'اكتملت العملية بنجاح دون رسائل إضافية.' : 'تعذر تنفيذ عملية الحزمة.'),
				message_ar: r.ok ? 'تم تنفيذ عملية الحزم البرمجية بنجاح' : 'تعذر إتمام عملية الحزمة البرمجية (راجع المخرجات)'
			});
		});
		return;
	}

	if (verb == 'sys_sysupgrade_conf_save') {
		handle_sys_sysupgrade_conf_save(params, actor, reply_cb);
		return;
	}

	if (verb == 'sys_reboot_challenge') {
		let nonce = urandom_hex(16);
		let exp = time() + 60;
		if (!atomic_write_or_reply(RUN_DIR + '/reboot_nonce.json', sprintf('%J\n', { nonce: nonce, actor: actor, exp: exp }), 0o600, null, null, actor, 'sys_reboot_challenge', reply_cb)) return;
		release_lock();
		reply_cb({ ok: true, nonce: nonce, ttl_s: 60 });
		return;
	}

	if (verb == 'sys_reboot') {
		let phrase = trim(params.confirm || '');
		let nonce = trim(params.nonce || '');
		let saved = read_json(RUN_DIR + '/reboot_nonce.json', null);
		if (phrase != 'CONFIRM_REBOOT' || !saved || saved.nonce != nonce || saved.actor != actor || time() > (+saved.exp || 0)) {
			release_lock();
			audit_append(actor, 'sys_reboot', 'gateway', 'refused', 'Invalid phrase or expired nonce');
			reply_cb({ ok: false, error_code: 'FORBIDDEN', message_ar: 'مرفوض: يلزم رمز تحدٍ صالح وعبارة التأكيد CONFIRM_REBOOT' });
			return;
		}
		if (fs.stat(RUN_DIR + '/reboot_nonce.json')) fs.unlink(RUN_DIR + '/reboot_nonce.json');
		audit_append(actor, 'sys_reboot', 'gateway', 'committed', 'Scheduled reboot -d 2');
		if (!STAGING_MODE) {
			uloop.timer(400, function() {
				system(['/sbin/reboot', '-d', '2']);
			});
		}
		release_lock();
		reply_cb({ ok: true, message_ar: 'جاري إعادة تشغيل البوابة الشبكية خلال ثانيتين' });
		return;
	}

	if (verb == 'auth_change_password') {
		let pw = '' + (params.password || '');
		if (length(pw) < 12) {
			release_lock();
			reply_cb({ ok: false, error_code: 'VALIDATION', message_ar: 'يجب أن لا يقل طول كلمة المرور الجديدة عن 12 حرفاً' });
			return;
		}
		let auth_doc = read_json(ETC_DIR + '/auth.json', null);
		if (!auth_doc || !auth_doc.users || !auth_doc.users.admin) {
			release_lock();
			reply_cb({ ok: false, error_code: 'AUTH', message_ar: 'حساب المدير غير مهيأ' });
			return;
		}
		if (auth_busy) {
			release_lock();
			reply_cb({ ok: false, status: 429, error_code: 'TIMEOUT', retry_after: 1, message_ar: 'توجد عملية تشفير جارية حالياً' });
			return;
		}
		auth_busy = true;
		let salt = urandom_hex(16);
		let iters = +auth_doc.iter || PBKDF2_ITER;
		uloop.task(function() {
			return pbkdf2_sha256(pw, salt, iters);
		}, function(dk) {
			auth_busy = false;
			release_lock();
			if (!dk) { reply_cb({ ok: false, error_code: 'INTERNAL', message_ar: 'فشل اشتقاق المفتاح' }); return; }
			let doc = read_json(ETC_DIR + '/auth.json', auth_doc);
			let prev_u = (doc.users && doc.users.admin) ? doc.users.admin : {};
			doc.users.admin = {
				role: 'admin', salt_hex: salt, dk_hex: dk,
				totp_enabled: !!prev_u.totp_enabled,
				totp_secret: prev_u.totp_secret || ''
			};
			let aw = atomic_write(ETC_DIR + '/auth.json', sprintf('%J\n', doc), 0o600);
			if (!aw.ok) {
				audit_append(actor, 'auth_change_password', 'admin', aw.cleanup_failed ? 'cleanup_failed' : 'failed', sprintf('error=%s orig=%s tmp=%s', aw.error || '', aw.orig_error || '', aw.tmp_path || ''));
				reply_cb({ ok: false, error_code: 'INTERNAL', error: aw.error, orig_error: aw.orig_error || '', cleanup_failed: !!aw.cleanup_failed, tmp_path: aw.cleanup_failed ? (aw.tmp_path || '') : '', message_ar: 'فشل حفظ كلمة المرور الجديدة' });
				return;
			}
			audit_append(actor, 'auth_change_password', 'admin', 'committed', 'Admin password rotated');
			reply_cb({ ok: true, invalidate_sessions: true, message_ar: 'تم تحديث كلمة مرور المدير بنجاح' });
		});
		return;
	}

	if (verb == 'auth_delete_user') {
		let uname = trim(params.username || '');
		if (uname == '' || uname == 'admin') {
			release_lock();
			reply_cb({ ok: false, error_code: 'FORBIDDEN', message_ar: 'مرفوض: لا يمكن حذف حساب المدير الأساسي' });
			return;
		}
		let auth_doc = read_json(ETC_DIR + '/auth.json', null);
		if (!auth_doc || !auth_doc.users || !auth_doc.users[uname]) {
			release_lock();
			reply_cb({ ok: false, error_code: 'VALIDATION', message_ar: 'المستخدم غير موجود' });
			return;
		}
		delete auth_doc.users[uname];
		if (!atomic_write_or_reply(ETC_DIR + '/auth.json', sprintf('%J\n', auth_doc), 0o600, null, null, actor, 'auth_delete_user', reply_cb)) return;
		release_lock();
		audit_append(actor, 'auth_delete_user', uname, 'committed', 'Removed operator user');
		reply_cb({ ok: true, message_ar: 'تم حذف الحساب بنجاح' });
		return;
	}

	if (verb == 'rollback_confirm' || verb == 'rollback_revert') {
		let tok = trim(params.token || '');
		if (!match(tok, /^[0-9a-f]{8,32}$/)) {
			release_lock();
			reply_cb({ ok: false, error_code: 'VALIDATION', message_ar: 'رمز التراجع غير صالح' });
			return;
		}
		let base = RUN_DIR + '/rb_' + tok;
		let meta = read_json(base + '.pending', null);
		if (!meta) {
			release_lock();
			reply_cb({ ok: false, error_code: 'VALIDATION', message_ar: 'انتهت مهلة التراجع أو تم تأكيد التعديل مسبقاً' });
			return;
		}
		if (verb == 'rollback_confirm') {
			fs.unlink(base + '.pending');
			fs.unlink(base + '.bak');
			release_lock();
			audit_append(actor, 'rollback_confirm', meta.kind || 'config', 'committed', 'Confirmed pending change');
			reply_cb({ ok: true, message_ar: 'تم اعتماد التغيير بشكل دائم' });
			return;
		}
		handle_rollback_revert(base, meta, actor, reply_cb);
		return;
	}

	if (verb == 'alerts_set') {
		let prev = read_json(ETC_DIR + '/alerts.json', {});
		let tok = trim(params.telegram_bot_token || '');
		let next_cfg = {
			telegram_enabled: !!params.telegram_enabled,
			telegram_bot_token: tok != '' ? tok : (prev.telegram_bot_token || ''),
			telegram_chat_id: trim(params.telegram_chat_id != null ? params.telegram_chat_id : (prev.telegram_chat_id || '')),
			ntfy_enabled: !!params.ntfy_enabled,
			ntfy_url: trim(params.ntfy_url != null ? params.ntfy_url : (prev.ntfy_url || '')),
			cpu_temp_max: +(params.cpu_temp_max || prev.cpu_temp_max || 78),
			ram_pct_max: +(params.ram_pct_max || prev.ram_pct_max || 90),
			alert_wan_down: params.alert_wan_down !== false,
			alert_auth_fail: params.alert_auth_fail !== false,
			alert_new_device: !!params.alert_new_device,
			cooldown_sec: +(params.cooldown_sec || prev.cooldown_sec || 300)
		};
		if (next_cfg.ntfy_url != '' && !match(next_cfg.ntfy_url, /^https?:\/\/[a-zA-Z0-9._:\/-]+$/)) {
			release_lock();
			reply_cb({ ok: false, error_code: 'VALIDATION', message_ar: 'رابط ntfy غير صالح' });
			return;
		}
		if (!atomic_write_or_reply(ETC_DIR + '/alerts.json', sprintf('%J\n', next_cfg), 0o600, null, null, actor, 'alerts_set', reply_cb)) return;
		release_lock();
		audit_append(actor, 'alerts_set', 'alerts', 'committed', 'Updated alerting configuration');
		reply_cb({ ok: true, message_ar: 'تم حفظ إعدادات التنبيهات بنجاح' });
		return;
	}

	if (verb == 'alerts_test' || verb == 'alerts_dispatch') {
		let cfg = read_json(ETC_DIR + '/alerts.json', {});
		let title = trim(params.title || 'تنبيه البوابة الشبكية');
		let msg = trim(params.message || 'رسالة اختبار من غرفة عمليات البوابة الشبكية');
		let hist = read_json(RUN_DIR + '/alerts_history.json', []);
		push(hist, { ts: now_iso(), level: trim(params.level || 'info'), title: title, message: msg });
		if (length(hist) > 50) hist = slice(hist, -50);
		if (!atomic_write_or_reply(RUN_DIR + '/alerts_history.json', sprintf('%J\n', hist), 0o600, null, null, actor, verb, reply_cb)) return;
		let sent_channels = [];
		if (cfg.telegram_enabled && cfg.telegram_bot_token && cfg.telegram_chat_id) {
			let tg_url = 'https://api.telegram.org/bot' + cfg.telegram_bot_token + '/sendMessage';
			let txt = title + '\n' + msg;
			system(sprintf('curl -fsS --max-time 4 -X POST %s -d chat_id=%s --data-urlencode text=%s >/dev/null 2>&1 &',
				sprintf("'%s'", replace(tg_url, /'/g, '')),
				sprintf("'%s'", replace('' + cfg.telegram_chat_id, /'/g, '')),
				sprintf("'%s'", replace(txt, /'/g, ''))));
			push(sent_channels, 'Telegram');
		}
		if (cfg.ntfy_enabled && cfg.ntfy_url) {
			system(sprintf('curl -fsS --max-time 4 -H %s -d %s %s >/dev/null 2>&1 &',
				sprintf("'Title: %s'", replace(title, /'/g, '')),
				sprintf("'%s'", replace(msg, /'/g, '')),
				sprintf("'%s'", replace(cfg.ntfy_url, /'/g, ''))));
			push(sent_channels, 'ntfy');
		}
		release_lock();
		if (verb == 'alerts_test' && length(sent_channels) == 0) {
			reply_cb({ ok: true, message_ar: 'تم تسجيل تنبيه الاختبار محلياً (فعّل Telegram أو ntfy لإرساله خارجياً)' });
			return;
		}
		reply_cb({ ok: true, channels: sent_channels, message_ar: 'تم إرسال التنبيه عبر: ' + (length(sent_channels) ? join('، ', sent_channels) : 'السجل المحلي') });
		return;
	}

	if (verb == 'auth_totp_setup') {
		let sec = gen_base32_secret();
		if (!atomic_write_or_reply(RUN_DIR + '/totp_pending.json', sprintf('%J\n', { secret: sec, ts: time() }), 0o600, null, null, actor, 'auth_totp_setup', reply_cb)) return;
		release_lock();
		reply_cb({
			ok: true,
			secret: sec,
			otpauth_uri: sprintf('otpauth://totp/NOC-Gateway:admin?secret=%s&issuer=NOC-Gateway', sec),
			message_ar: 'تم توليد مفتاح المصادقة الثنائية، أدخل الرمز السداسي لتأكيد التفعيل'
		});
		return;
	}

	if (verb == 'auth_totp_enable') {
		let pend = read_json(RUN_DIR + '/totp_pending.json', null);
		let sec = trim(params.secret || (pend ? pend.secret : ''));
		let code = trim(params.code || '');
		if (sec == '' || !totp_verify(sec, code)) {
			release_lock();
			reply_cb({ ok: false, error_code: 'VALIDATION', message_ar: 'رمز التحقق السداسي (TOTP) غير صحيح' });
			return;
		}
		let auth_doc = read_json(ETC_DIR + '/auth.json', null);
		if (!auth_doc || !auth_doc.users || !auth_doc.users.admin) {
			release_lock();
			reply_cb({ ok: false, error_code: 'AUTH', message_ar: 'حساب المدير غير مهيأ' });
			return;
		}
		auth_doc.users.admin.totp_enabled = true;
		auth_doc.users.admin.totp_secret = sec;
		if (!atomic_write_or_reply(ETC_DIR + '/auth.json', sprintf('%J\n', auth_doc), 0o600, null, null, actor, 'auth_totp_enable', reply_cb)) return;
		fs.unlink(RUN_DIR + '/totp_pending.json');
		release_lock();
		audit_append(actor, 'auth_totp_enable', 'admin', 'committed', 'Enabled 2FA TOTP');
		reply_cb({ ok: true, message_ar: 'تم تفعيل المصادقة الثنائية (TOTP) لحساب المدير بنجاح' });
		return;
	}

	if (verb == 'auth_totp_disable') {
		let auth_doc = read_json(ETC_DIR + '/auth.json', null);
		if (!auth_doc || !auth_doc.users || !auth_doc.users.admin) {
			release_lock();
			reply_cb({ ok: false, error_code: 'AUTH', message_ar: 'حساب المدير غير مهيأ' });
			return;
		}
		auth_doc.users.admin.totp_enabled = false;
		delete auth_doc.users.admin.totp_secret;
		if (!atomic_write_or_reply(ETC_DIR + '/auth.json', sprintf('%J\n', auth_doc), 0o600, null, null, actor, 'auth_totp_disable', reply_cb)) return;
		release_lock();
		audit_append(actor, 'auth_totp_disable', 'admin', 'committed', 'Disabled 2FA TOTP');
		reply_cb({ ok: true, message_ar: 'تم تعطيل المصادقة الثنائية لحساب المدير' });
		return;
	}

	if (verb == 'client_quota_set') {
		let mac = lc(trim(params.mac || ''));
		if (!match(mac, /^([0-9a-f]{2}:){5}[0-9a-f]{2}$/)) {
			release_lock();
			reply_cb({ ok: false, error_code: 'VALIDATION', message_ar: 'عنوان MAC غير صالح' });
			return;
		}
		let quotas = read_json(ETC_DIR + '/device_quotas.json', {});
		let qmb = +(params.quota_mb || 0);
		let tkbps = +(params.throttle_kbps || 0);
		if (qmb <= 0 && tkbps <= 0) delete quotas[mac];
		else quotas[mac] = { quota_mb: qmb, throttle_kbps: tkbps, updated_at: now_iso() };
		if (!atomic_write_or_reply(ETC_DIR + '/device_quotas.json', sprintf('%J\n', quotas), 0o600, null, null, actor, 'client_quota_set', reply_cb)) return;
		release_lock();
		audit_append(actor, 'client_quota_set', mac, 'committed', sprintf('quota_mb=%d throttle=%d', qmb, tkbps));
		reply_cb({ ok: true, message_ar: 'تم حفظ الحصة الشهرية للجهاز بنجاح' });
		return;
	}

	if (verb == 'schedule_action_set') {
		let mac = lc(trim(params.mac || ''));
		let action_type = trim(params.action_type || 'block');
		let start_h = trim(params.start_time || '23:00');
		let end_h = trim(params.end_time || '07:00');
		if (!match(mac, /^([0-9a-f]{2}:){5}[0-9a-f]{2}$/) || !match(start_h, /^[0-2][0-9]:[0-5][0-9]$/) || !match(end_h, /^[0-2][0-9]:[0-5][0-9]$/)) {
			release_lock();
			reply_cb({ ok: false, error_code: 'VALIDATION', message_ar: 'بيانات الجدولة أو عنوان MAC غير صالحة' });
			return;
		}
		let scheds = read_json(ETC_DIR + '/device_schedules.json', []);
		push(scheds, { id: urandom_hex(4), mac: mac, action_type: action_type, start_time: start_h, end_time: end_h, enabled: true });
		if (length(scheds) > 40) scheds = slice(scheds, -40);
		if (!atomic_write_or_reply(ETC_DIR + '/device_schedules.json', sprintf('%J\n', scheds), 0o600, null, null, actor, 'schedule_action_set', reply_cb)) return;
		release_lock();
		audit_append(actor, 'schedule_action_set', mac, 'committed', start_h + '-' + end_h + ' ' + action_type);
		reply_cb({ ok: true, message_ar: 'تمت إضافة جدولة الإجراء للجهاز بنجاح' });
		return;
	}

	release_lock();
	reply_cb({ ok: false, error_code: 'UNSUPPORTED', message_ar: 'أمر غير مدعوم' });
}

// --- Startup & uloop Event Loop ---
ensure_dirs();
uloop.init();

if (fs.stat(SOCK_PATH)) fs.unlink(SOCK_PATH);
let sa = sock.sockaddr({ path: SOCK_PATH });
srv_sock = sock.create(sock.AF_UNIX, sock.SOCK_STREAM);
if (!srv_sock || !srv_sock.bind(sa) || !srv_sock.listen(16)) {
	die('Failed to bind noc-helperd socket at ' + SOCK_PATH + ': ' + sock.error());
}
fs.chmod(SOCK_PATH, 0o660);
let noc_user = lookup_user_ids('noc-api');
if (noc_user) fs.chown(SOCK_PATH, 0, noc_user.gid);

let allowed_uid = noc_user ? noc_user.uid : -1;
let staging_override_uid = getenv('NOC_STAGING_ALLOW_UID');
if (STAGING_MODE && staging_override_uid != null && staging_override_uid != '') {
	allowed_uid = +staging_override_uid;
}

srv_handle = uloop.handle(srv_sock, function(ev) {
	let cli = srv_sock.accept();
	if (!cli) return;
	if (active_clients >= 32) { cli.close(); return; }
	let cred = cli.getopt(sock.SOL_SOCKET, sock.SO_PEERCRED);
	if (!cred || (cred.uid != 0 && cred.uid != allowed_uid)) {
		try { cli.send(sprintf('%J\n', { ok: false, error_code: 'FORBIDDEN', message_ar: 'رفض الوصول: هوية العملية غير مصرح لها' })); } catch (e) {}
		cli.close();
		return;
	}
	active_clients++;
	let buf = '';
	let closed = false;
	let ch = null;
	let rt = uloop.timer(5000, function() {
		if (closed) return;
		closed = true;
		active_clients--;
		if (ch) ch.delete();
		try { cli.close(); } catch (e) {}
	});
	ch = uloop.handle(cli, function(cev) {
		if (closed) return;
		let d = cli.recv(4096);
		if (!d || length(d) == 0) {
			closed = true; rt.cancel(); active_clients--; ch.delete(); cli.close(); return;
		}
		buf += d;
		if (length(buf) > 65536) {
			closed = true; rt.cancel(); active_clients--; ch.delete();
			cli.send(sprintf('%J\n', { ok: false, error_code: 'VALIDATION', message_ar: 'تجاوز حجم الطلب الحد المسموح' }));
			cli.close();
			return;
		}
		let nl = index(buf, '\n');
		if (nl >= 0) {
			closed = true; rt.cancel(); ch.delete();
			let req_obj = null;
			try { req_obj = json(substr(buf, 0, nl)); } catch (e) { req_obj = null; }
			if (!req_obj || type(req_obj) != 'object') {
				active_clients--;
				cli.send(sprintf('%J\n', { ok: false, error_code: 'VALIDATION', message_ar: 'طلب JSON غير صالح' }));
				cli.close();
				return;
			}
			handle_rpc(req_obj, function(resp) {
				try {
					let payload = sprintf('%J\n', resp);
					let off = 0;
					let total = length(payload);
					let retries = 0;
					while (off < total) {
						let chunk = substr(payload, off, 8192);
						let sent = cli.send(chunk);
						if (sent && sent > 0) {
							off += sent;
							retries = 0;
						} else {
							retries++;
							if (retries > 50) break;
							sock.poll(40, [cli, sock.POLLOUT]);
						}
					}
				} catch (e) {}
				try { cli.close(); } catch (e) {}
				active_clients--;
			});
		}
	}, uloop.ULOOP_READ);
}, uloop.ULOOP_READ);

// 1-second P17 Lock TTL & P4 Timed-Disable Reconciler Timer (never stalls on PBKDF2!)
let rec_timer = null;
function reconciler_tick() {
	let m = now_mono_ms();
	if (last_tick_mono > 0) {
		push(reconciler_gaps, m - last_tick_mono);
		if (length(reconciler_gaps) > 20) reconciler_gaps = slice(reconciler_gaps, 1);
	}
	last_tick_mono = m;
	reconciler_tick_count++;
	if ((reconciler_tick_count % 5) == 0) {
		try { gc('collect'); } catch (e) {}
	}

	let lp = RUN_DIR + '/mutation.lock';
	let lk = read_json(lp, null);
	if (lk && (now_mono_ms() - (+lk.acquired_mono_ms || 0)) > (+lk.ttl_ms || LOCK_TTL_MS)) {
		fs.unlink(lp);
		audit_append('reconciler', 'lock_ttl_recover', lk.op || 'unknown', 'recovered', 'Cleared stale lock held by ' + (lk.owner || 'unknown'));
	}
	let td_path = ETC_DIR + '/timed_disable.json';
	let td = read_json(td_path, null);
	if (td && time() >= (+td.deadline_epoch || 0)) {
		if (acquire_lock('reconciler', 'timed_disable_restore').ok) {
			let res = adguard_http('POST', '/control/protection', { enabled: !!td.target_state });
			if (res.ok) {
				fs.unlink(td_path);
				audit_append('reconciler', 'timed_disable_restore', 'protection_enabled', 'committed', 'TIMED_DISABLE_RESTORED');
			}
			release_lock();
		}
	}
	rec_timer = uloop.timer(1000, reconciler_tick);
}
rec_timer = uloop.timer(1000, reconciler_tick);

uloop.run();
