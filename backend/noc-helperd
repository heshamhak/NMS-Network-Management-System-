	if (verb == 'wifi_scan') {
		exec_argv_async('/usr/sbin/iw', ['dev', 'wlan0', 'scan'], 8000, 262144, function(sc) {
			let list = [];
			let cur_bss = null;
			for (let ln in split(sc.output || '', '\n')) {
				let mb = match(ln, /^BSS\s+([0-9a-fA-F:]{17})/);
				if (mb) {
					if (cur_bss && cur_bss.ssid != '') push(list, cur_bss);
					cur_bss = { bssid: lc(mb[1]), ssid: '', signal_dbm: -99, freq_mhz: 0, security: 'Open' };
					continue;
				}
				if (!cur_bss) continue;
				let mf = match(ln, /^\s+freq:\s*([0-9]+)/);
				if (mf) cur_bss.freq_mhz = +mf[1];
				let ms = match(ln, /^\s+signal:\s*(-?[0-9.]+)/);
				if (ms) cur_bss.signal_dbm = int(+ms[1]);
				let mn = match(ln, /^\s+SSID:\s*(.*)$/);
				if (mn) cur_bss.ssid = scrub_prohibited(replace(trim(mn[1]), /[\r\n\t<>]/g, ''));
				if (index(ln, 'RSN:') >= 0) cur_bss.security = 'WPA2/WPA3';
				else if (index(ln, 'WPA:') >= 0 && cur_bss.security == 'Open') cur_bss.security = 'WPA';
			}
			if (cur_bss && cur_bss.ssid != '') push(list, cur_bss);
			sort(list, function(a, b) { return b.signal_dbm - a.signal_dbm; });
			if (length(list) > 25) list = slice(list, 0, 25);
			if (!atomic_write_or_reply(RUN_DIR + '/wifi_scan.json', sprintf('%J\n', { ts: time(), results: list }), 0o600, null, null, actor, 'wifi_scan', reply_cb)) return;
